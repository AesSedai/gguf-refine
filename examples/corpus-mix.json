{
 "_comment": "Thinking mode (chat_kwargs) only where the source has reasoning. The 2.5M-token calibration mix (weights as the K3.1 Hessian corpus) for ggufrefine.corpus. Paths use $DATASETS (local copies of the Hugging Face datasets, same directory layout), $KLD (calibration_datav5.txt), $PERSONAL_RP and $HELDOUT_RP (directories of SillyTavern chat exports, <character>/<chat>.jsonl). heldout_rp is eval-only: none of its characters is in train or test.",
 "n_ctx": 8192,
 "max_doc": 3000,
 "seed": 1,
 "window": 64,
 "sequences": {"train": 305, "test": 24, "eval": 32},
 "exclude": ["$KLD/calibration_datav5.txt"],
 "domains": {
  "code": {"weight": 0.1838, "format": "text", "files": "$DATASETS/storagestuffnobody/mid-training-40b/data/stack/train/*.parquet",
           "columns": ["text"], "text": "{text}", "rows_per_file": 40},
  "agent_swe": {"weight": 0.1682, "format": "messages", "files": "$DATASETS/nebius/SWE-rebench-openhands-trajectories/trajectories.parquet",
                "columns": ["trajectory", "tools"], "field": "trajectory", "tools": "tools", "window": "middle", "max_doc": 8192},
  "personal_rp": {"weight": 0.12, "format": "sillytavern", "files": "$PERSONAL_RP/*/*.jsonl", "min_heldout": 3},
  "calib5": {"weight": 0.0945, "format": "text_file", "files": "$KLD/calibration_datav5.txt", "splits": ["train"]},
  "code_edit": {"weight": 0.0864, "format": "chat", "files": "$DATASETS/bigcode/commitpackft/data/*/data.jsonl", "rows_per_file": 120,
                "turns": [{"role": "user", "content": "{message}\n\n```{old_file}\n{old_contents}\n```"},
                          {"role": "assistant", "content": "```{new_file}\n{new_contents}\n```"}]},
  "rp": {"weight": 0.08, "format": "sharegpt", "files": "$DATASETS/Gryphe/Sonnet3.5-Charcard-Roleplay/*.jsonl", "field": "conversations",
         "group": "{conversations[0][value]}"},
  "technical": {"weight": 0.048, "format": "text", "files": "$DATASETS/storagestuffnobody/mid-training-40b/data/finepdf/train/*.parquet",
                "columns": ["text"], "text": "{text}", "rows_per_file": 40},
  "tools_agentic": {"weight": 0.0361, "format": "sharegpt", "files": "$DATASETS/CharlieDreemur/OpenManus-RL/data/*.parquet",
                    "columns": ["conversations"], "field": "conversations"},
  "openmath_cot": {"weight": 0.0229, "format": "chat", "files": "$DATASETS/nvidia/OpenMathReasoning/data/cot-*.parquet",
                   "columns": ["problem", "generated_solution"], "rows_per_file": 60, "split_think": true,
                   "chat_kwargs": {"enable_thinking": true},
                   "turns": [{"role": "user", "content": "{problem}"}, {"role": "assistant", "content": "{generated_solution}"}]},
  "multilingual_web": {"weight": 0.0202, "format": "text", "files": "$DATASETS/HuggingFaceFW/fineweb-2/data/*/test/*.parquet",
                       "columns": ["text"], "text": "{text}", "rows_per_file": 20},
  "math_reasoning": {"weight": 0.02, "format": "chat", "files": "$DATASETS/crownelius/KimiK2.5-9000x/kiro_*_dataset_*.jsonl",
                     "chat_kwargs": {"enable_thinking": true},
                     "turns": [{"role": "user", "content": "{problem}"},
                               {"role": "assistant", "content": "{solution}", "reasoning_content": "{explanation}"}]},
  "chat": {"weight": 0.02, "format": "sharegpt", "files": "$DATASETS/PJMixers-Dev/LMSYS-Chat-1M-ReRolls/data/*.parquet",
           "columns": ["prompt", "responses"], "field": "prompt", "append": [{"role": "assistant", "content": "{responses[0][response]}"}],
           "group": "{prompt[0][value]}"},
  "books": {"weight": 0.02, "format": "text", "files": "$DATASETS/uncleaned-epub-txt/*.parquet", "columns": ["text"], "text": "{text}",
            "rows_per_file": 24},
  "agent_websearch": {"weight": 0.02, "format": "chat", "files": "$DATASETS/Torenn/Edge-Agent-Reasoning-WebSearch-260K/*.parquet",
                      "columns": ["user_prompt", "agent_reasoning"], "rows_per_file": 40,
                      "chat_kwargs": {"enable_thinking": true},
                      "turns": [{"role": "user", "content": "{user_prompt}"},
                                {"role": "assistant", "content": "", "reasoning_content": "{agent_reasoning}"}]},
  "code_reasoning": {"weight": 0.02, "format": "chat", "files": "$DATASETS/nvidia/OpenCodeReasoning-2/train/*/*.parquet",
                     "columns": ["question", "r1_generation"], "rows_per_file": 60, "split_think": true,
                     "chat_kwargs": {"enable_thinking": true},
                     "replace": {"-": "Solve the following competitive programming problem. Read input from stdin and write the answer to stdout."},
                     "turns": [{"role": "user", "content": "{question}"}, {"role": "assistant", "content": "{r1_generation}"}]},
  "multilingual_chat": {"weight": 0.02, "format": "chat", "files": "$DATASETS/CohereLabs/aya_dataset/data/train-*.parquet",
                        "columns": ["inputs", "targets"],
                        "turns": [{"role": "user", "content": "{inputs}"}, {"role": "assistant", "content": "{targets}"}]},
  "sql": {"weight": 0.02, "format": "chat", "files": "$DATASETS/b-mc2/sql-create-context/default/train/*.parquet",
          "columns": ["context", "question", "answer"],
          "turns": [{"role": "user", "content": "{context}\n\n{question}"}, {"role": "assistant", "content": "{answer}"}]},
  "heldout_rp": {"weight": 0.08, "format": "sillytavern", "files": "$HELDOUT_RP/*/*.jsonl", "splits": ["eval"], "min_heldout": 3}
 }
}
