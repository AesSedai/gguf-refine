+// Write tensor as a numpy .npy file (float32, C-contiguous). Tensors are
+// resident on a backend buffer; this function expects a host-readable byte
+// buffer with the tensor's strided (nb) layout. We emit the canonical
+// (ne[3], ne[2], ne[1], ne[0]) shape collapsed to leading non-trivial dims.
+static void common_debug_save_npy(const std::string & path,
+                                  const uint8_t * data, ggml_type type,
+                                  const int64_t * ne, const size_t * nb) {
+    FILE * fp = std::fopen(path.c_str(), "wb");
+    if (!fp) {
+        LOG_ERR("debug-dump: failed to open %s\n", path.c_str());
+        return;
+    }
+    // build shape list: drop trailing 1s
+    int ndim = 4;
+    while (ndim > 1 && ne[ndim - 1] == 1) ndim--;
+    // numpy header: shape is (ne[ndim-1], ..., ne[0]) — outermost first
+    std::string shape;
+    for (int i = ndim - 1; i >= 0; --i) {
+        shape += std::to_string(ne[i]);
+        shape += (i == 0 && ndim == 1) ? "," : (i > 0 ? ", " : "");
+    }
+    std::string header = "{'descr': '<f4', 'fortran_order': False, 'shape': (" + shape + "), }";
+    // pad header so total preamble length is a multiple of 64; preamble = 6+2+2+header_len+1 (for \n)
+    const size_t pre = 6 + 2 + 2; // magic(6) + ver(2) + headerlen(2)
+    size_t hl = header.size() + 1; // +1 for trailing \n
+    size_t pad = (64 - (pre + hl) % 64) % 64;
+    header.append(pad, ' ');
+    header.push_back('\n');
+    uint16_t hl16 = (uint16_t)header.size();
+    std::fwrite("\x93NUMPY", 1, 6, fp);
+    uint8_t ver[2] = { 1, 0 };
+    std::fwrite(ver, 1, 2, fp);
+    std::fwrite(&hl16, 2, 1, fp);
+    std::fwrite(header.data(), 1, header.size(), fp);
+    // write float32 data, in C order: outer = ne[3], then ne[2], ne[1], ne[0]
+    for (int64_t i3 = 0; i3 < ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < ne[2]; ++i2) {
+            for (int64_t i1 = 0; i1 < ne[1]; ++i1) {
+                for (int64_t i0 = 0; i0 < ne[0]; ++i0) {
+                    size_t off = i3 * nb[3] + i2 * nb[2] + i1 * nb[1] + i0 * nb[0];
+                    float v;
+                    if (type == GGML_TYPE_F32) {
+                        v = *(const float *) &data[off];
+                    } else if (type == GGML_TYPE_F16) {
+                        v = ggml_fp16_to_fp32(*(const ggml_fp16_t *) &data[off]);
+                    } else if (type == GGML_TYPE_BF16) {
+                        v = ggml_bf16_to_fp32(*(const ggml_bf16_t *) &data[off]);
+                    } else if (type == GGML_TYPE_I32) {
+                        v = (float) *(const int32_t *) &data[off];
+                    } else if (type == GGML_TYPE_I64) {
+                        v = (float) *(const int64_t *) &data[off];
+                    } else {
+                        v = 0.0f; // unsupported type
+                    }
+                    std::fwrite(&v, sizeof(float), 1, fp);
+                }
+            }
+        }
+    }
+    std::fclose(fp);
+}
+
+static std::string common_debug_sanitize_filename(const char * name) {
+    std::string out;
+    for (const char * p = name; *p; ++p) {
+        char c = *p;
+        if ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') ||
+            (c >= 'A' && c <= 'Z') || c == '-' || c == '_' || c == '.') {
+            out += c;
+        } else {
+            out += '_';
+        }
+    }
+    return out;
+}
