+            return true;
+        }
+        const bool is_host_p = ggml_backend_buffer_is_host(t->buffer);
+        const uint8_t * data;
+        if (is_host_p) {
+            data = (const uint8_t *) t->data;
+        } else {
+            auto n_bytes = ggml_nbytes(t);
+            pimpl->data.resize(n_bytes);
+            ggml_backend_tensor_get(t, pimpl->data.data(), 0, n_bytes);
+            data = pimpl->data.data();
+        }
+        bool bad = false;
+        float bad_val = 0.0f;
+        int64_t bad_idx[4] = {0,0,0,0};
+        for (int64_t i3 = 0; i3 < t->ne[3] && !bad; i3++) {
+            for (int64_t i2 = 0; i2 < t->ne[2] && !bad; i2++) {
+                for (int64_t i1 = 0; i1 < t->ne[1] && !bad; i1++) {
+                    for (int64_t i0 = 0; i0 < t->ne[0]; i0++) {
+                        const float v = common_ggml_get_float_value(data, t->type, t->nb, i0, i1, i2, i3);
+                        if (std::isnan(v) || std::isinf(v)) {
+                            bad = true;
+                            bad_val = v;
+                            bad_idx[0] = i0; bad_idx[1] = i1; bad_idx[2] = i2; bad_idx[3] = i3;
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        if (bad) {
+            LOG_ERR("nan-probe: first %s in tensor '%s' op=%s type=%s shape=[%s] at idx=[%lld,%lld,%lld,%lld] src0='%s' src1='%s'\n",
+                    std::isnan(bad_val) ? "NaN" : (bad_val > 0 ? "+inf" : "-inf"),
+                    t->name, ggml_op_desc(t), ggml_type_name(t->type),
+                    common_ggml_ne_string(t).c_str(),
+                    (long long) bad_idx[0], (long long) bad_idx[1],
+                    (long long) bad_idx[2], (long long) bad_idx[3],
+                    src0 ? src0->name : "(null)", src1 ? src1->name : "(null)");
+            std::fflush(stdout);
+            std::abort();
+        }
+        return true;
+    }
