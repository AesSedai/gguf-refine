+# One whole-file mmap per safetensors path, shared across all LocalTensors.
+# Repeated np.memmap() construction per tensor is expensive: each call holds
+# the GIL while building the numpy wrapper and triggers a fresh mmap() syscall
+# (kernel mmap_lock contention, page-table bloat). Mapping each file once and
+# slicing into it eliminates per-tensor setup cost.
+_FILE_MMAP_CACHE: dict[Path, np.memmap] = {}
+_FILE_MMAP_LOCK = threading.Lock()
+
+
+def _get_file_mmap(filename: Path) -> np.memmap:
+    cached = _FILE_MMAP_CACHE.get(filename)
+    if cached is not None:
+        return cached
+    with _FILE_MMAP_LOCK:
+        cached = _FILE_MMAP_CACHE.get(filename)
+        if cached is not None:
+            return cached
+        mm = np.memmap(filename, mode='c')
+        _FILE_MMAP_CACHE[filename] = mm
+        return mm
+
+
