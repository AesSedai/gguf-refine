+            uint8_t sgn = 0;
+            for (int i = 0; i < 8; ++i) {
+                if (xb[8*k + i] >= 0.0f) {
+                    xval[8*k + i] = xb[8*k + i];
+                } else {
+                    xval[8*k + i] = -xb[8*k + i];
+                    sgn |= (1 << i);
+                }
+            }
+            block_signs[k] = sgn;
+        }
+
+        float vmax = xval[0];
+        for (int i = 1; i < 16; ++i) { vmax = fmaxf(vmax, xval[i]); }
+        for (int i = 0; i < 16; ++i) { L[i] = 0; }
