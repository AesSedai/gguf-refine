+// ---------------------------------------------------------------- dispatch
+
+extern "C" bool ggml_cuda_quantize_weights_supports(enum ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_IQ4_NL:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_IQ2_XXS:
+        case GGML_TYPE_IQ2_XS:
+        case GGML_TYPE_IQ3_XXS:
+        case GGML_TYPE_IQ2_S:
+        case GGML_TYPE_IQ3_S:
+        case GGML_TYPE_IQ1_S:
+        case GGML_TYPE_IQ1_M:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_F16:
+        case GGML_TYPE_BF16:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// launch one chunk that is already resident on the device;
+// `device` must be current, it only selects which table copy to use
+static bool quantize_chunk_device(
+        int             device,
+        enum ggml_type  type,
+        const float *   src_d,
+        void *          dst_d,
+        int64_t         nrows,
+        int64_t         n_per_row,
+        const float *   imatrix_d,
+        cudaStream_t    stream) {
+
+    const int64_t nelem   = nrows*n_per_row;
+    const int64_t blck    = ggml_blck_size(type);
+    const int64_t nblocks = nelem/blck;
+
+    const int threads = 256;
+    const int64_t grid = (nblocks + threads - 1)/threads;
+
+    // types that need the runtime-built lookup tables
+    if (type == GGML_TYPE_IQ2_XXS) {
+        iq_tables_dev t;
+        if (!imatrix_d || !iq_tables_get(type, device, t)) { return false; }
+        quantize_iq2_xxs_cuda_kernel<<<grid, threads, 0, stream>>>(
+            src_d, (block_iq2_xxs *) dst_d, imatrix_d, nblocks, n_per_row/QK_K,
+            (const uint64_t *) t.grid, t.map, t.neigh);
+        return true;
+    }
+    if (type == GGML_TYPE_IQ1_M) {
+        iq_tables_dev t;
+        if (!iq_tables_get(type, device, t)) { return false; }
+        quantize_iq1_m_cuda_kernel<<<grid, threads, 0, stream>>>(
+            src_d, (block_iq1_m *) dst_d, imatrix_d, nblocks, n_per_row/QK_K,
+            (const uint64_t *) t.grid, t.map, t.neigh);
+        return true;
+    }
+    if (type == GGML_TYPE_IQ1_S) {
+        iq_tables_dev t;
+        if (!imatrix_d || !iq_tables_get(type, device, t)) { return false; }
+        quantize_iq1_s_cuda_kernel<<<grid, threads, 0, stream>>>(
+            src_d, (block_iq1_s *) dst_d, imatrix_d, nblocks, n_per_row/QK_K,
+            (const uint64_t *) t.grid, t.map, t.neigh);
+        return true;
+    }
+    if (type == GGML_TYPE_IQ3_S) {
+        iq_tables_dev t;
+        if (!iq_tables_get(type, device, t)) { return false; }
+        quantize_iq3_s_cuda_kernel<<<grid, threads, 0, stream>>>(
+            src_d, (block_iq3_s *) dst_d, imatrix_d, nblocks, n_per_row/QK_K,
+            (const uint32_t *) t.grid, t.map, t.neigh);
+        return true;
+    }
+    if (type == GGML_TYPE_IQ2_S) {
+        iq_tables_dev t;
+        if (!iq_tables_get(type, device, t)) { return false; }
+        quantize_iq2_s_cuda_kernel<<<grid, threads, 0, stream>>>(
+            src_d, (block_iq2_s *) dst_d, imatrix_d, nblocks, n_per_row/QK_K,
+            (const uint64_t *) t.grid, t.map, t.neigh);
+        return true;
+    }
+    if (type == GGML_TYPE_IQ3_XXS) {
+        iq_tables_dev t;
+        if (!iq_tables_get(type, device, t)) { return false; }
+        quantize_iq3_xxs_cuda_kernel<<<grid, threads, 0, stream>>>(
+            src_d, (block_iq3_xxs *) dst_d, imatrix_d, nblocks, n_per_row/QK_K,
+            (const uint32_t *) t.grid, t.map, t.neigh);
+        return true;
+    }
+    if (type == GGML_TYPE_IQ2_XS) {
+        iq_tables_dev t;
+        if (!imatrix_d || !iq_tables_get(type, device, t)) { return false; }
+        quantize_iq2_xs_cuda_kernel<<<grid, threads, 0, stream>>>(
+            src_d, (block_iq2_xs *) dst_d, imatrix_d, nblocks, n_per_row/QK_K,
+            (const uint64_t *) t.grid, t.map, t.neigh);
+        return true;
+    }
+
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+            // mirrors quantize_q4_0(): the imatrix selects a different algorithm
+            if (imatrix_d) {
+                quantize_q4_0_impl_cuda_kernel<<<nrows, threads, 0, stream>>>(
+                    src_d, (block_q4_0 *) dst_d, imatrix_d, n_per_row, n_per_row/QK4_0);
+            } else {
+                quantize_q4_0_cuda_kernel<<<grid, threads, 0, stream>>>(src_d, (block_q4_0 *) dst_d, nblocks);
+            }
+            return true;
+        case GGML_TYPE_Q8_0:
+            quantize_q8_0_cuda_kernel<<<grid, threads, 0, stream>>>(src_d, (block_q8_0 *) dst_d, nblocks);
+            return true;
+        case GGML_TYPE_MXFP4:
+            quantize_mxfp4_cuda_kernel<<<grid, threads, 0, stream>>>(src_d, (block_mxfp4 *) dst_d, nblocks);
+            return true;
+        case GGML_TYPE_Q4_1:
+            if (imatrix_d) {
+                quantize_q4_1_impl_cuda_kernel<<<nrows, threads, 0, stream>>>(
+                    src_d, (block_q4_1 *) dst_d, imatrix_d, n_per_row, n_per_row/QK4_1);
+            } else {
+                quantize_q4_1_ref_cuda_kernel<<<grid, threads, 0, stream>>>(src_d, (block_q4_1 *) dst_d, nblocks);
+            }
+            return true;
+        case GGML_TYPE_Q5_0:
+            if (imatrix_d) {
+                quantize_q5_0_impl_cuda_kernel<<<nrows, threads, 0, stream>>>(
+                    src_d, (block_q5_0 *) dst_d, imatrix_d, n_per_row, n_per_row/QK5_0);
+            } else {
+                quantize_q5_0_ref_cuda_kernel<<<grid, threads, 0, stream>>>(src_d, (block_q5_0 *) dst_d, nblocks);
+            }
+            return true;
+        case GGML_TYPE_Q5_1:
+            if (imatrix_d) {
+                quantize_q5_1_impl_cuda_kernel<<<nrows, threads, 0, stream>>>(
+                    src_d, (block_q5_1 *) dst_d, imatrix_d, n_per_row, n_per_row/QK5_1);
+            } else {
+                quantize_q5_1_ref_cuda_kernel<<<grid, threads, 0, stream>>>(src_d, (block_q5_1 *) dst_d, nblocks);
+            }
+            return true;
+        case GGML_TYPE_F16: {
+            const int64_t n = nrows*n_per_row;
+            quantize_f16_cuda_kernel<<<(n + threads - 1)/threads, threads, 0, stream>>>(src_d, (half *) dst_d, n);
+            return true;
+        }
+        case GGML_TYPE_BF16: {
+            const int64_t n = nrows*n_per_row;
+            quantize_bf16_cuda_kernel<<<(n + threads - 1)/threads, threads, 0, stream>>>(src_d, (uint16_t *) dst_d, n);
+            return true;
+        }
+        case GGML_TYPE_IQ4_NL:
+            quantize_iq4_nl_cuda_kernel<<<grid, threads, 0, stream>>>(
+                src_d, (block_iq4_nl *) dst_d, imatrix_d, nblocks, n_per_row/QK4_NL);
+            return true;
+        case GGML_TYPE_IQ4_XS:
+            quantize_iq4_xs_cuda_kernel<<<grid, threads, 0, stream>>>(
+                src_d, (block_iq4_xs *) dst_d, imatrix_d, nblocks, n_per_row/QK_K);
+            return true;
+        case GGML_TYPE_Q3_K:
+            // mirrors quantize_q3_K()
+            if (imatrix_d) {
+                quantize_q3_k_impl_cuda_kernel<<<grid, threads, 0, stream>>>(
+                    src_d, (block_q3_K *) dst_d, imatrix_d, nblocks, n_per_row/QK_K);
+            } else {
+                quantize_q3_k_ref_cuda_kernel<<<grid, threads, 0, stream>>>(
+                    src_d, (block_q3_K *) dst_d, nblocks);
+            }
+            return true;
+        case GGML_TYPE_Q6_K:
+            quantize_q6_k_cuda_kernel<<<grid, threads, 0, stream>>>(
+                src_d, (block_q6_K *) dst_d, imatrix_d, nblocks, n_per_row/QK_K);
+            return true;
+        case GGML_TYPE_Q4_K:
+            // mirrors quantize_q4_K()
+            if (imatrix_d) {
+                quantize_q4_k_impl_cuda_kernel<<<grid, threads, 0, stream>>>(
+                    src_d, (block_q4_K *) dst_d, imatrix_d, nblocks, n_per_row/QK_K);
+            } else {
+                quantize_q4_k_ref_cuda_kernel<<<grid, threads, 0, stream>>>(
+                    src_d, (block_q4_K *) dst_d, nblocks);
+            }
+            return true;
+        case GGML_TYPE_Q5_K:
+            // mirrors quantize_q5_K()
+            if (imatrix_d) {
+                quantize_q5_k_impl_cuda_kernel<<<grid, threads, 0, stream>>>(
+                    src_d, (block_q5_K *) dst_d, imatrix_d, nblocks, n_per_row/QK_K);
+            } else {
+                quantize_q5_k_ref_cuda_kernel<<<grid, threads, 0, stream>>>(
+                    src_d, (block_q5_K *) dst_d, nblocks);
+            }
+            return true;
+        case GGML_TYPE_Q2_K:
+            // mirrors quantize_q2_K()
+            if (imatrix_d) {
+                quantize_q2_k_impl_cuda_kernel<<<grid, threads, 0, stream>>>(
+                    src_d, (block_q2_K *) dst_d, imatrix_d, nblocks, n_per_row/QK_K);
+            } else {
+                quantize_q2_k_ref_cuda_kernel<<<grid, threads, 0, stream>>>(
+                    src_d, (block_q2_K *) dst_d, nblocks);
+            }
+            return true;
+        default:
+            return false;
+    }
+}
+
+// Per-device staging buffers, pooled.
+//
+// cudaMalloc/cudaFree and stream creation cost more than the kernel itself on
+// the sample-sized calls the bpw sweep makes, and the sweep issues those from
+// every worker thread at once. Keep the buffers and reuse them.
+struct qw_dev_buf {
+    int          device  = -1;
+    cudaStream_t stream  = nullptr;
+    float *      src_d   = nullptr;
+    void *       dst_d   = nullptr;
+    float *      imat_d  = nullptr;
+    void *       pin_src = nullptr;
+    void *       pin_dst = nullptr;
+    size_t       src_cap = 0;
+    size_t       dst_cap = 0;
+    size_t       imat_cap = 0;
+    size_t       pin_src_cap = 0;
+    size_t       pin_dst_cap = 0;
+};
+
+// cudaMemcpyAsync from pageable memory is not actually async: the driver stages
+// it and blocks, which serializes the devices. Page-locked staging lets the
+// per-device copies overlap. Only worth it for calls that fit one chunk; large
+// tensors are PCIe-bound anyway and would tie up too much pinned memory.
+#define QW_PINNED_MAX (64ull << 20)
+
+static std::vector<qw_dev_buf> g_qw_pool[QW_MAX_DEVICES];
+static std::mutex              g_qw_pool_mutex;
+
+// `device` must already be current
+static bool qw_buf_acquire(int device, size_t src_bytes, size_t dst_bytes, size_t imat_bytes,
+                           size_t pin_src_bytes, size_t pin_dst_bytes, qw_dev_buf & out) {
+    {
+        std::lock_guard<std::mutex> lock(g_qw_pool_mutex);
+        auto & v = g_qw_pool[device];
+        if (!v.empty()) {
+            out = v.back();
+            v.pop_back();
+        }
+    }
+
+    if (out.device < 0) {
+        out.device = device;
+        if (cudaStreamCreate(&out.stream) != cudaSuccess) { return false; }
+    }
+
+    // grow only; a shrink would just churn the allocator
+    if (out.src_cap < src_bytes) {
+        cudaFree(out.src_d);
+        out.src_d = nullptr;
+        if (cudaMalloc((void **) &out.src_d, src_bytes) != cudaSuccess) { out.src_cap = 0; return false; }
+        out.src_cap = src_bytes;
+    }
+    if (out.dst_cap < dst_bytes) {
+        cudaFree(out.dst_d);
+        out.dst_d = nullptr;
+        if (cudaMalloc(&out.dst_d, dst_bytes) != cudaSuccess) { out.dst_cap = 0; return false; }
+        out.dst_cap = dst_bytes;
+    }
+    if (pin_src_bytes > 0 && out.pin_src_cap < pin_src_bytes) {
+        cudaFreeHost(out.pin_src);
+        out.pin_src = nullptr;
+        if (cudaMallocHost(&out.pin_src, pin_src_bytes) != cudaSuccess) { out.pin_src_cap = 0; }
+        else                                                            { out.pin_src_cap = pin_src_bytes; }
+    }
+    if (pin_dst_bytes > 0 && out.pin_dst_cap < pin_dst_bytes) {
+        cudaFreeHost(out.pin_dst);
+        out.pin_dst = nullptr;
+        if (cudaMallocHost(&out.pin_dst, pin_dst_bytes) != cudaSuccess) { out.pin_dst_cap = 0; }
+        else                                                            { out.pin_dst_cap = pin_dst_bytes; }
+    }
+    if (imat_bytes > 0 && out.imat_cap < imat_bytes) {
+        cudaFree(out.imat_d);
+        out.imat_d = nullptr;
+        if (cudaMalloc((void **) &out.imat_d, imat_bytes) != cudaSuccess) { out.imat_cap = 0; return false; }
+        out.imat_cap = imat_bytes;
+    }
+    return true;
+}
+
+static void qw_buf_release(const qw_dev_buf & b) {
+    if (b.device < 0) { return; }
+    std::lock_guard<std::mutex> lock(g_qw_pool_mutex);
+    g_qw_pool[b.device].push_back(b);
+}
+
+extern "C" bool ggml_cuda_quantize_weights(
+        enum ggml_type type,
+        const float *  src,
+        void *         dst,
+        int64_t        nrows,
+        int64_t        n_per_row,
+        const float *  imatrix) {
+
+    if (!ggml_cuda_quantize_weights_supports(type)) {
+        return false;
+    }
+    if (nrows <= 0 || n_per_row <= 0 || n_per_row % ggml_blck_size(type) != 0) {
+        return false;
+    }
+
+    int ndev = 0;
+    if (cudaGetDeviceCount(&ndev) != cudaSuccess || ndev <= 0) {
+        return false;
+    }
+    if (ndev > QW_MAX_DEVICES) {
+        ndev = QW_MAX_DEVICES;
+    }
+    if (const char * e = getenv("GGML_CUDA_QUANTIZE_DEVICES")) {
+        const int want = atoi(e);
+        if (want > 0 && want < ndev) { ndev = want; }
+    }
+
+    int dev_prev = 0;
+    if (cudaGetDevice(&dev_prev) != cudaSuccess) {
+        return false;
+    }
+
+    const size_t  row_size      = ggml_row_size(type, n_per_row);
+    const int64_t bytes_per_row = (int64_t) n_per_row*sizeof(float);
+
+    // Split rows across devices. Below this many rows a device is not worth a
+    // launch, so narrow calls stay on one GPU; the bpw sweep issues many of
+    // those concurrently, so rotate the starting device to spread them out.
+    int64_t min_rows_per_dev = 8192;
+    if (const char * e = getenv("GGML_CUDA_QUANTIZE_MIN_ROWS")) {
+        const long long v = atoll(e);
+        if (v > 0) { min_rows_per_dev = v; }
+    }
+    int n_use = (int) std::min<int64_t>(ndev, std::max<int64_t>(1, nrows/min_rows_per_dev));
+
+    static std::atomic<unsigned> rr{0};
+    const int base = n_use == ndev ? 0 : (int) (rr.fetch_add(1) % (unsigned) ndev);
+
+    // bound the working set per launch; one MoE expert tensor does not fit
+    const int64_t max_src_bytes = 256ll << 20;
+
+    // measured: pinned staging helps compute-heavy types a little and costs the
+    // light ones more, so it is opt-in
+    bool use_pinned = false;
+    if (const char * e = getenv("GGML_CUDA_QUANTIZE_PINNED")) { use_pinned = atoi(e) != 0; }
+
+    struct dev_ctx {
+        qw_dev_buf buf;
+        int64_t    row0    = 0;
+        int64_t    nrow    = 0;
+        bool       pinned  = false;   // result still sits in buf.pin_dst
+    };
+
+    std::vector<dev_ctx> ctx((size_t) n_use);
+    bool ok = true;
+
+    for (int i = 0; i < n_use && ok; ++i) {
+        dev_ctx & c  = ctx[(size_t) i];
+        const int id = (base + i) % ndev;
+        c.row0 = nrows*i/n_use;
+        c.nrow = nrows*(i + 1)/n_use - c.row0;
+        if (c.nrow <= 0) {
+            continue;
+        }
+
+        int64_t rows_per_chunk = max_src_bytes/bytes_per_row;
+        if (rows_per_chunk < 1)      { rows_per_chunk = 1;      }
+        if (rows_per_chunk > c.nrow) { rows_per_chunk = c.nrow; }
+
+        // one chunk and small enough: stage through page-locked memory so this
+        // device's copies overlap the others instead of serializing in the driver
+        const size_t chunk_src_bytes = (size_t) (rows_per_chunk*bytes_per_row);
+        const size_t chunk_dst_bytes = (size_t) rows_per_chunk*row_size;
+        const bool   want_pin = use_pinned && rows_per_chunk >= c.nrow && chunk_src_bytes <= QW_PINNED_MAX;
+
+        if (cudaSetDevice(id) != cudaSuccess) { ok = false; break; }
+        if (!qw_buf_acquire(id, chunk_src_bytes, chunk_dst_bytes,
+                            imatrix ? n_per_row*sizeof(float) : 0,
+                            want_pin ? chunk_src_bytes : 0,
+                            want_pin ? chunk_dst_bytes : 0, c.buf)) {
+            ok = false;
+            break;
+        }
+        c.pinned = want_pin && c.buf.pin_src && c.buf.pin_dst;
+        // a pooled buffer may still hold an imat_d from an earlier call; this
+        // call's imatrix state decides what the kernel sees, not the cache
+        float * imat_d = nullptr;
+        if (imatrix) {
+            imat_d = c.buf.imat_d;
+            if (cudaMemcpyAsync(imat_d, imatrix, n_per_row*sizeof(float),
+                                cudaMemcpyHostToDevice, c.buf.stream) != cudaSuccess) { ok = false; break; }
+        }
+
+        // queue this device's whole slice; stream order keeps the staging
+        // buffers safe across chunks, and the devices run concurrently
+        for (int64_t off = 0; off < c.nrow; off += rows_per_chunk) {
+            const int64_t nr  = std::min(rows_per_chunk, c.nrow - off);
+            const int64_t row = c.row0 + off;
+
+            const void * h_src = src + row*n_per_row;
+            if (c.pinned) {
+                memcpy(c.buf.pin_src, h_src, (size_t) (nr*bytes_per_row));
+                h_src = c.buf.pin_src;
+            }
+            if (cudaMemcpyAsync(c.buf.src_d, h_src, nr*bytes_per_row,
+                                cudaMemcpyHostToDevice, c.buf.stream) != cudaSuccess) { ok = false; break; }
+            if (!quantize_chunk_device(id, type, c.buf.src_d, c.buf.dst_d, nr, n_per_row, imat_d, c.buf.stream)) { ok = false; break; }
+
+            void * h_dst = (char *) dst + row*row_size;
+            if (c.pinned) { h_dst = c.buf.pin_dst; }
+            if (cudaMemcpyAsync(h_dst, c.buf.dst_d, nr*row_size,
+                                cudaMemcpyDeviceToHost, c.buf.stream) != cudaSuccess) { ok = false; break; }
+        }
+    }
+
+    for (auto & c : ctx) {
+        if (c.buf.stream) {
+            cudaSetDevice(c.buf.device);
+            if (cudaStreamSynchronize(c.buf.stream) != cudaSuccess) { ok = false; }
+            if (cudaGetLastError()                  != cudaSuccess) { ok = false; }
+            if (ok && c.pinned && c.nrow > 0) {
+                memcpy((char *) dst + c.row0*row_size, c.buf.pin_dst, (size_t) c.nrow*row_size);
+            }
+        }
+    }
+
+    for (auto & c : ctx) {
+        qw_buf_release(c.buf);
+    }
+
+    cudaSetDevice(dev_prev);
+    return ok;
+}
diff --git a/ggml/src/ggml-cuda/quantize-weights.cuh b/ggml/src/ggml-cuda/quantize-weights.cuh
new file mode 100644
index 000000000..a10da2ee8
--- /dev/null
+++ b/ggml/src/ggml-cuda/quantize-weights.cuh
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "common.cuh"
+
+// GPU weight quantization.
+//
+// ggml quantizes weights on the CPU only (ggml-quants.c). llama-quantize's
+// --target-bpw sweep quantizes a sample of every tensor into ~15 types to
+// measure error, which makes that the dominant cost. These kernels run the
+// same per-block algorithm as the *_ref/*_impl functions in ggml-quants.c,
+// one thread per block, so the output is bit-identical to the CPU path.
+//
+// src/dst are host pointers; the copies are done here. Returns false when the
+// type has no GPU kernel, and the caller falls back to ggml_quantize_chunk.
+extern "C" GGML_BACKEND_API bool ggml_cuda_quantize_weights_supports(enum ggml_type type);
+
+extern "C" GGML_BACKEND_API bool ggml_cuda_quantize_weights(
+    enum ggml_type type,
+    const float *  src,
+    void *         dst,
+    int64_t        nrows,
+    int64_t        n_per_row,
+    const float *  imatrix);
diff --git a/tests/test-quantize-cuda.cpp b/tests/test-quantize-cuda.cpp
new file mode 100644
index 000000000..d5c4e7d67
--- /dev/null
+++ b/tests/test-quantize-cuda.cpp
@@ -0,0 +1,560 @@
+// Compare the CUDA weight quantizers against the CPU reference in ggml-quants.c.
+//
+// The CUDA kernels transliterate the same scalar algorithm, so the bar is
+// byte-for-byte equality -- except where the reference algorithm's own accept
+// test lands on a numerical tie. make_qx_quants() keeps a candidate scale when
+// sumlx*sumlx > best*suml2; on a block with one dominant outlier those two
+// sides agree to ~1 part in 1e8, so evaluation order decides the winner and
+// either answer is equally good.
+//
+// So: require equality, and where blocks differ, require the GPU's weighted
+// quantization error to be within a small margin of the CPU's.
+//
+// The margin has to clear the tie-break noise without hiding real bugs. Ties
+// cost ~1e-4 of aggregate error; a wrong helper or a wrong packing costs tens
+// of percent to orders of magnitude. 1% separates them with room to spare.
+//
+// Note the metric is only a proxy: each algorithm optimizes its own weighting
+// (q4_K's _ref path uses av_x + |x|), so a tie under the algorithm's objective
+// can look worse under the uniform/imatrix weighting measured here. That is
+// why the bar is aggregate-over-the-tensor rather than per block.
+
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <string>
+#include <thread>
+#include <vector>
+
+extern "C" bool ggml_cuda_quantize_weights_supports(enum ggml_type type);
+extern "C" bool ggml_cuda_quantize_weights(
+    enum ggml_type type, const float * src, void * dst,
+    int64_t nrows, int64_t n_per_row, const float * imatrix);
+
+struct row_case {
+    const char * name;
+    // fills one row of n floats
+    void (*fill)(float * x, int64_t n, std::mt19937 & rng);
+};
+
+static void fill_normal(float * x, int64_t n, std::mt19937 & rng) {
+    std::normal_distribution<float> d(0.0f, 1.0f);
+    for (int64_t i = 0; i < n; ++i) { x[i] = d(rng); }
+}
+
+static void fill_zeros(float * x, int64_t n, std::mt19937 &) {
+    for (int64_t i = 0; i < n; ++i) { x[i] = 0.0f; }
+}
+
+// a single spike dominates the block scale: exercises the amax/max split
+static void fill_outlier(float * x, int64_t n, std::mt19937 & rng) {
+    std::normal_distribution<float> d(0.0f, 0.01f);
+    for (int64_t i = 0; i < n; ++i) { x[i] = d(rng); }
+    x[n/3]     =  37.5f;
+    x[2*n/3]   = -41.25f;
+}
+
+// values land exactly on rounding boundaries (x.5) after scaling
+static void fill_ties(float * x, int64_t n, std::mt19937 &) {
+    for (int64_t i = 0; i < n; ++i) { x[i] = ((float)((i % 33) - 16) + 0.5f)/16.0f; }
+}
+
+// tiny magnitudes: d underflows toward denormal/zero
+static void fill_tiny(float * x, int64_t n, std::mt19937 & rng) {
+    std::normal_distribution<float> d(0.0f, 1e-30f);
+    for (int64_t i = 0; i < n; ++i) { x[i] = d(rng); }
+}
+
+// one sign only, so max and amax agree
+static void fill_positive(float * x, int64_t n, std::mt19937 & rng) {
+    std::uniform_real_distribution<float> d(0.0f, 4.0f);
+    for (int64_t i = 0; i < n; ++i) { x[i] = d(rng); }
+}
+
+static const row_case g_cases[] = {
+    { "normal",   fill_normal   },
+    { "zeros",    fill_zeros    },
+    { "outlier",  fill_outlier  },
+    { "ties",     fill_ties     },
+    { "tiny",     fill_tiny     },
+    { "positive", fill_positive },
+};
+
+static const ggml_type g_types[] = {
+    GGML_TYPE_Q4_0,
+    GGML_TYPE_Q8_0,
+    GGML_TYPE_MXFP4,
+    GGML_TYPE_Q2_K,
+    GGML_TYPE_Q3_K,
+    GGML_TYPE_Q4_K,
+    GGML_TYPE_Q5_K,
+    GGML_TYPE_Q6_K,
+    GGML_TYPE_IQ4_XS,
+    GGML_TYPE_IQ4_NL,
+    GGML_TYPE_IQ2_XXS,
+    GGML_TYPE_IQ2_XS,
+    GGML_TYPE_IQ2_S,
+    GGML_TYPE_IQ3_XXS,
+    GGML_TYPE_IQ3_S,
+    GGML_TYPE_IQ1_S,
+    GGML_TYPE_IQ1_M,
+    GGML_TYPE_Q4_1,
+    GGML_TYPE_Q5_0,
+    GGML_TYPE_Q5_1,
+    GGML_TYPE_F16,
+    GGML_TYPE_BF16,
+};
+
+static bool run_one(ggml_type type, int64_t n_per_row, bool use_imatrix, int & n_checked) {
+    const int64_t n_cases = (int64_t) (sizeof(g_cases)/sizeof(g_cases[0]));
+    const int64_t nrows   = n_cases*4;
+
+    std::mt19937 rng(1234567u + (unsigned) type + (use_imatrix ? 777u : 0u));
+
+    std::vector<float> src((size_t) nrows*n_per_row);
+    for (int64_t r = 0; r < nrows; ++r) {
+        g_cases[r % n_cases].fill(src.data() + r*n_per_row, n_per_row, rng);
+    }
+
+    std::vector<float> imatrix((size_t) n_per_row);
+    {
+        std::uniform_real_distribution<float> d(0.05f, 3.0f);
+        for (int64_t i = 0; i < n_per_row; ++i) { imatrix[i] = d(rng); }
+    }
+    const float * im = use_imatrix ? imatrix.data() : nullptr;
+
+    if (ggml_quantize_requires_imatrix(type) && !im) {
+        return true; // not a legal combination, skip
+    }
+
+    const size_t row_size = ggml_row_size(type, n_per_row);
+    std::vector<uint8_t> out_cpu((size_t) nrows*row_size, 0xAA);
+    std::vector<uint8_t> out_gpu((size_t) nrows*row_size, 0x55);
+
+    ggml_quantize_chunk(type, src.data(), out_cpu.data(), 0, nrows, n_per_row, im);
+
+    if (!ggml_cuda_quantize_weights(type, src.data(), out_gpu.data(), nrows, n_per_row, im)) {
+        printf("  %-10s n_per_row=%-5lld imatrix=%d  SKIP (no cuda kernel)\n",
+               ggml_type_name(type), (long long) n_per_row, (int) use_imatrix);
+        return true;
+    }
+
+    n_checked++;
+
+    if (memcmp(out_cpu.data(), out_gpu.data(), out_cpu.size()) == 0) {
+        printf("  %-10s n_per_row=%-5lld imatrix=%d  OK   exact (%lld rows, %zu bytes)\n",
+               ggml_type_name(type), (long long) n_per_row, (int) use_imatrix,
+               (long long) nrows, out_cpu.size());
+        return true;
+    }
+
+    // not identical: count differing blocks and compare the error each side achieved
+    const size_t blk_bytes  = ggml_type_size(type);
+    const int64_t blck      = ggml_blck_size(type);
+    const size_t blks_row   = row_size/blk_bytes;
+    size_t n_blk_diff = 0;
+    for (int64_t r = 0; r < nrows; ++r) {
+        for (size_t b = 0; b < blks_row; ++b) {
+            const size_t o = r*row_size + b*blk_bytes;
+            if (memcmp(&out_cpu[o], &out_gpu[o], blk_bytes) != 0) { n_blk_diff++; }
+        }
+    }
+    const size_t n_blk_total = (size_t) nrows*blks_row;
+
+    const ggml_type_traits * tr = ggml_get_type_traits(type);
+    double err_cpu = 0.0;
+    double err_gpu = 0.0;
+    if (tr && tr->to_float) {
+        std::vector<float> dq_cpu((size_t) n_per_row), dq_gpu((size_t) n_per_row);
+        for (int64_t r = 0; r < nrows; ++r) {
+            tr->to_float(&out_cpu[(size_t) r*row_size], dq_cpu.data(), (int) n_per_row);
+            tr->to_float(&out_gpu[(size_t) r*row_size], dq_gpu.data(), (int) n_per_row);
+            for (int64_t i = 0; i < n_per_row; ++i) {
+                const double x = src[(size_t) r*n_per_row + i];
+                const double w = im ? im[i] : 1.0;
+                const double ec = x - dq_cpu[i];
+                const double eg = x - dq_gpu[i];
+                err_cpu += w*ec*ec;
+                err_gpu += w*eg*eg;
+            }
+        }
+    }
+
+    const double ratio     = err_cpu > 0 ? err_gpu/err_cpu : 1.0;
+    const double blk_frac  = (double) n_blk_diff/(double) n_blk_total;
+    const bool   not_worse = ratio <= 1.01 && blk_frac <= 0.20;
+    if (not_worse) {
+        printf("  %-10s n_per_row=%-5lld imatrix=%d  OK   %zu/%zu blocks tie-broken (%.2f%%), "
+               "werr gpu/cpu=%.6f\n",
+               ggml_type_name(type), (long long) n_per_row, (int) use_imatrix,
+               n_blk_diff, n_blk_total, 100.0*blk_frac, ratio);
+        return true;
+    }
+
+    // locate and describe the first mismatch
+    size_t off = 0;
+    while (off < out_cpu.size() && out_cpu[off] == out_gpu[off]) { off++; }
+    const int64_t bad_row  = (int64_t) (off/row_size);
+    const size_t  in_row   = off % row_size;
+    size_t        n_diff   = 0;
+    for (size_t i = 0; i < out_cpu.size(); ++i) { n_diff += out_cpu[i] != out_gpu[i]; }
+
+    printf("  %-10s n_per_row=%-5lld imatrix=%d  FAIL\n",
+           ggml_type_name(type), (long long) n_per_row, (int) use_imatrix);
+    printf("      %zu/%zu bytes differ (%.3f%%), %zu/%zu blocks (%.2f%%), werr gpu/cpu=%.6f\n",
+           n_diff, out_cpu.size(), 100.0*(double) n_diff/(double) out_cpu.size(),
+           n_blk_diff, n_blk_total, 100.0*blk_frac, ratio);
+    printf("      first at byte %zu -> row %lld (case '%s'), offset %zu in row: cpu=0x%02x gpu=0x%02x\n",
+           off, (long long) bad_row, g_cases[bad_row % n_cases].name, in_row,
+           out_cpu[off], out_gpu[off]);
+
+    // dump the whole differing block side by side
+    const size_t blk_idx   = in_row/blk_bytes;
+    const size_t blk_off   = bad_row*row_size + blk_idx*blk_bytes;
+    printf("      block %zu of the row (%zu bytes):\n        cpu:", blk_idx, blk_bytes);
+    for (size_t i = 0; i < blk_bytes && blk_off + i < out_cpu.size(); ++i) { printf(" %02x", out_cpu[blk_off + i]); }
+    printf("\n        gpu:");
+    for (size_t i = 0; i < blk_bytes && blk_off + i < out_gpu.size(); ++i) { printf(" %02x", out_gpu[blk_off + i]); }
+    printf("\n");
+
+    // the leading fp16 of most block layouts is the scale
+    if (blk_bytes >= 2) {
+        ggml_fp16_t hc, hg;
+        memcpy(&hc, &out_cpu[blk_off], 2);
+        memcpy(&hg, &out_gpu[blk_off], 2);
+        printf("        leading fp16: cpu=%.9g gpu=%.9g\n",
+               ggml_fp16_to_fp32(hc), ggml_fp16_to_fp32(hg));
+    }
+
+    // weighted error of just this block, so one bad block is not hidden or amplified
+    if (tr && tr->to_float) {
+        std::vector<float> dc((size_t) blck), dg((size_t) blck);
+        tr->to_float(&out_cpu[blk_off], dc.data(), (int) blck);
+        tr->to_float(&out_gpu[blk_off], dg.data(), (int) blck);
+        const int64_t base = (int64_t) blk_idx*blck;
+        double bc = 0.0, bg = 0.0;
+        for (int64_t i = 0; i < blck; ++i) {
+            const double x = src[(size_t) bad_row*n_per_row + base + i];
+            const double w = im ? im[base + i] : 1.0;
+            bc += w*(x - dc[i])*(x - dc[i]);
+            bg += w*(x - dg[i])*(x - dg[i]);
+        }
+        printf("        this block alone: werr cpu=%.9g gpu=%.9g  ratio=%.9f\n",
+               bc, bg, bc > 0 ? bg/bc : 1.0);
+    }
+
+    // which source elements does that block cover
+    const int64_t e0   = (int64_t) blk_idx*blck;
+    printf("        src[%lld..%lld] head:", (long long) e0, (long long) (e0 + blck - 1));
+    for (int64_t i = 0; i < 8 && e0 + i < n_per_row; ++i) {
+        printf(" %.6g", src[(size_t) bad_row*n_per_row + e0 + i]);
+    }
+    printf("\n");
+    return false;
+}
+
+int main() {
+    ggml_cpu_init();
+
+    // optional: run one real tensor through both paths, to catch anything the
+    // synthetic cases miss (real weights are BF16-derived, so far more values
+    // land exactly on a rounding boundary after scaling)
+    // every block layout stores an fp16 scale, so a mismatch between ggml's
+    // fp32->fp16 and the device's would show up in all of them at once
+    {
+        std::mt19937 rng(11u);
+        std::uniform_int_distribution<uint32_t> bits(0, 0xFFFFFFFFu);
+        size_t n_diff = 0;
+        const size_t N = 4000000;
+        std::vector<float>  in(N);
+        std::vector<int16_t> host(N), dev(N);
+        for (size_t i = 0; i < N; ++i) {
+            const uint32_t u = bits(rng);
+            float f;
+            memcpy(&f, &u, 4);
+            if (!std::isfinite(f)) { f = (float) (int32_t) u * 1e-9f; }
+            in[i] = f;
+        }
+        for (size_t i = 0; i < N; ++i) {
+            const ggml_fp16_t h = ggml_fp32_to_fp16(in[i]);
+            memcpy(&host[i], &h, 2);
+        }
+        // the device conversion via the f16 "quantizer"
+        ggml_cuda_quantize_weights(GGML_TYPE_F16, in.data(), dev.data(), 1, (int64_t) N, nullptr);
+        for (size_t i = 0; i < N; ++i) { n_diff += host[i] != dev[i]; }
+        printf("fp32->fp16: ggml vs device differ on %zu / %zu values\n\n", n_diff, N);
+    }
+
+    if (const char * path = getenv("QW_REAL_F32")) {
+        const int64_t n_per_row = getenv("QW_REAL_NPR") ? atoll(getenv("QW_REAL_NPR")) : 1024;
+        FILE * f = fopen(path, "rb");
+        if (!f) { printf("cannot open %s\n", path); return 1; }
+        fseek(f, 0, SEEK_END);
+        const int64_t nfloat = ftell(f)/4;
+        fseek(f, 0, SEEK_SET);
+        std::vector<float> src((size_t) nfloat);
+        if (fread(src.data(), 4, (size_t) nfloat, f) != (size_t) nfloat) { printf("short read\n"); return 1; }
+        fclose(f);
+        const int64_t nrows = nfloat/n_per_row;
+        printf("real tensor: %lld rows x %lld\n", (long long) nrows, (long long) n_per_row);
+
+        // optional real imatrix row (f32, n_per_row entries)
+        std::vector<float> rim;
+        if (const char * ip = getenv("QW_REAL_IMATRIX")) {
+            FILE * fi = fopen(ip, "rb");
+            if (fi) {
+                rim.resize((size_t) n_per_row);
+                if (fread(rim.data(), 4, (size_t) n_per_row, fi) != (size_t) n_per_row) { rim.clear(); }
+                fclose(fi);
+            }
+            if (rim.empty()) { printf("could not read imatrix %s\n", ip); return 1; }
+            double lo = rim[0], hi = rim[0];
+            for (float v : rim) { lo = std::min(lo, (double) v); hi = std::max(hi, (double) v); }
+            printf("using real imatrix: min=%.4g max=%.4g\n", lo, hi);
+        }
+        const float * rimp = rim.empty() ? nullptr : rim.data();
+
+        const char * only = getenv("QW_REAL_TYPES");   // comma list, empty = all
+        for (ggml_type type : g_types) {
+            if (!ggml_cuda_quantize_weights_supports(type)) { continue; }
+            if (ggml_quantize_requires_imatrix(type) && !rimp) { continue; }
+            if (only && !strstr(only, ggml_type_name(type))) { continue; }
+            const size_t rs = ggml_row_size(type, n_per_row);
+            std::vector<uint8_t> a((size_t) nrows*rs, 0), b((size_t) nrows*rs, 0);
+            ggml_quantize_chunk(type, src.data(), a.data(), 0, nrows, n_per_row, rimp);
+            ggml_cuda_quantize_weights(type, src.data(), b.data(), nrows, n_per_row, rimp);
+            size_t nd = 0;
+            for (size_t i = 0; i < a.size(); ++i) { nd += a[i] != b[i]; }
+
+            // byte identity is not the bar; equal error is
+            const ggml_type_traits * tr = ggml_get_type_traits(type);
+            double ec = 0.0, eg = 0.0;
+            if (tr && tr->to_float) {
+                std::vector<float> dc((size_t) n_per_row), dg((size_t) n_per_row);
+                for (int64_t r = 0; r < nrows; ++r) {
+                    tr->to_float(&a[(size_t) r*rs], dc.data(), (int) n_per_row);
+                    tr->to_float(&b[(size_t) r*rs], dg.data(), (int) n_per_row);
+                    for (int64_t i = 0; i < n_per_row; ++i) {
+                        const double x = src[(size_t) r*n_per_row + i];
+                        const double w = rimp ? rimp[i] : 1.0;
+                        ec += w*(x - dc[i])*(x - dc[i]);
+                        eg += w*(x - dg[i])*(x - dg[i]);
+                    }
+                }
+            }
+            printf("  %-10s %-7s %7zu/%-8zu bytes   mse cpu=%.6e gpu=%.6e  ratio=%.7f\n",
+                   ggml_type_name(type), nd == 0 ? "exact" : "differs", nd, a.size(),
+                   ec, eg, ec > 0 ? eg/ec : 1.0);
+        }
+        return 0;
+    }
+
+    // widths that exercise both a single superblock and several per row
+    const int64_t widths[] = { 256, 512, 4096, 1024, 1280, 3072, 5120 };
+
+    int n_fail = 0;
+    int n_checked = 0;
+
+    // QW_BENCH_ONLY: skip the correctness pass, for quick perf iteration
+    const bool bench_only = getenv("QW_BENCH_ONLY") != nullptr;
+
+    for (ggml_type type : g_types) {
+        if (bench_only) { break; }
+        for (int64_t w : widths) {
+            if (w % ggml_blck_size(type) != 0) { continue; }
+            for (int use_im = 0; use_im < 2; ++use_im) {
+                if (!run_one(type, w, use_im != 0, n_checked)) { n_fail++; }
+            }
+        }
+    }
+
+    // MXFP4 round trip: a model whose experts already ship MXFP4 is dequantized
+    // to f32 before the bpw sweep, so "keep MXFP4" is only a free option for the
+    // optimizer if requantizing reproduces the original bytes.
+    {
+        const int64_t n = 4096, rows = 32;
+        std::mt19937 rng(4242u);
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        std::vector<float> src((size_t) rows*n);
+        for (auto & v : src) { v = nd(rng); }
+
+        const size_t rs = ggml_row_size(GGML_TYPE_MXFP4, n);
+        std::vector<uint8_t> q1((size_t) rows*rs), q2((size_t) rows*rs);
+        std::vector<float>   dq((size_t) rows*n);
+
+        ggml_quantize_chunk(GGML_TYPE_MXFP4, src.data(), q1.data(), 0, rows, n, nullptr);
+        const ggml_type_traits * tr = ggml_get_type_traits(GGML_TYPE_MXFP4);
+        for (int64_t r = 0; r < rows; ++r) {
+            tr->to_float(&q1[(size_t) r*rs], dq.data() + r*n, (int) n);
+        }
+        ggml_quantize_chunk(GGML_TYPE_MXFP4, dq.data(), q2.data(), 0, rows, n, nullptr);
+
+        const bool idem = memcmp(q1.data(), q2.data(), q1.size()) == 0;
+        printf("\nmxfp4 requantize round trip: %s (%lld rows x %lld)\n",
+               idem ? "idempotent, error is exactly zero" : "NOT IDEMPOTENT", 
+               (long long) rows, (long long) n);
+        if (!idem) { n_fail++; }
+    }
+
+    // does the premise hold: is the GPU actually faster on a realistic tensor
+    {
+        const int64_t n_per_row = 4096;
+        const int64_t nrows     = getenv("QW_BENCH_ROWS") ? atoll(getenv("QW_BENCH_ROWS")) : 4096;
+        std::mt19937 rng(99u);
+        std::vector<float> src((size_t) nrows*n_per_row);
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        for (auto & v : src) { v = nd(rng); }
+        std::vector<float> im((size_t) n_per_row, 1.0f);
+
+        printf("\nthroughput on %lldx%lld (%.1f MiB of f32):\n",
+               (long long) nrows, (long long) n_per_row,
+               (double) src.size()*4/1024/1024);
+
+        const char * bonly = getenv("QW_BENCH_TYPES");
+        const bool   nocpu = getenv("QW_BENCH_NOCPU") != nullptr;
+        for (ggml_type type : g_types) {
+            if (bonly && !strstr(bonly, ggml_type_name(type))) { continue; }
+            const size_t row_size = ggml_row_size(type, n_per_row);
+            std::vector<uint8_t> out((size_t) nrows*row_size);
+
+            const int64_t t0 = ggml_time_us();
+            if (!nocpu) { ggml_quantize_chunk(type, src.data(), out.data(), 0, nrows, n_per_row, im.data()); }
+            const int64_t t1 = ggml_time_us();
+
+            if (!ggml_cuda_quantize_weights_supports(type)) {
+                printf("  %-10s cpu %8.3f s   gpu       -       (cpu only)\n",
+                       ggml_type_name(type), (t1 - t0)/1e6);
+                continue;
+            }
+
+            // warm up: first touch of a (type, device) pair uploads that type's
+            // lookup tables and grows the pooled buffers. A real run amortizes
+            // that over hundreds of tensors; timing it here would not.
+            ggml_cuda_quantize_weights(type, src.data(), out.data(), nrows, n_per_row, im.data());
+            const int64_t t1b = ggml_time_us();
+            ggml_cuda_quantize_weights(type, src.data(), out.data(), nrows, n_per_row, im.data());
+            const int64_t t2 = ggml_time_us();
+            GGML_UNUSED(t1b);
+
+            printf("  %-10s cpu %8.3f s   gpu %8.3f s   %7.1fx\n",
+                   ggml_type_name(type), (t1 - t0)/1e6, (t2 - t1b)/1e6,
+                   (double) (t1 - t0)/(double) (t2 - t1b));
+        }
+    }
+
+    // What the --target-bpw sweep actually does per candidate type: quantize a
+    // sample of rows, dequantize, reduce the error. Only the first step moved to
+    // the GPU, so this is the honest end-to-end number, not the kernel number.
+    {
+        const int64_t n_per_row   = 4096;
+        const int64_t sample_rows = 512;
+        std::mt19937 rng(7u);
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        std::vector<float> src((size_t) sample_rows*n_per_row);
+        for (auto & v : src) { v = nd(rng); }
+        std::vector<float> im((size_t) n_per_row, 1.0f);
+
+        printf("\nsweep step (quantize + dequantize + reduce, %lld sampled rows x %lld):\n",
+               (long long) sample_rows, (long long) n_per_row);
+
+        for (ggml_type type : g_types) {
+            if (!ggml_cuda_quantize_weights_supports(type)) { continue; }
+            const ggml_type_traits * tr = ggml_get_type_traits(type);
+            if (!tr || !tr->to_float) { continue; }
+            const size_t rs = ggml_row_size(type, n_per_row);
+            std::vector<uint8_t> q((size_t) sample_rows*rs);
+            std::vector<float>   dq((size_t) sample_rows*n_per_row);
+            volatile double sink = 0.0;
+
+            const int64_t t0 = ggml_time_us();
+            for (int64_t r = 0; r < sample_rows; ++r) {
+                ggml_quantize_chunk(type, src.data() + r*n_per_row, q.data() + r*rs, 0, 1, n_per_row, im.data());
+                tr->to_float(q.data() + r*rs, dq.data() + r*n_per_row, (int) n_per_row);
+                double e = 0.0;
+                for (int64_t j = 0; j < n_per_row; ++j) {
+                    const double d = dq[r*n_per_row + j] - src[r*n_per_row + j];
+                    e += im[j]*d*d;
+                }
+                sink = sink + e;
+            }
+            const int64_t t1 = ggml_time_us();
+
+            ggml_cuda_quantize_weights(type, src.data(), q.data(), sample_rows, n_per_row, im.data());
+            for (int64_t r = 0; r < sample_rows; ++r) {
+                tr->to_float(q.data() + r*rs, dq.data() + r*n_per_row, (int) n_per_row);
+                double e = 0.0;
+                for (int64_t j = 0; j < n_per_row; ++j) {
+                    const double d = dq[r*n_per_row + j] - src[r*n_per_row + j];
+                    e += im[j]*d*d;
+                }
+                sink = sink + e;
+            }
+            const int64_t t2 = ggml_time_us();
+
+            printf("  %-10s cpu %7.3f s   gpu %7.3f s   %6.2fx\n",
+                   ggml_type_name(type), (t1 - t0)/1e6, (t2 - t1)/1e6,
+                   (double) (t1 - t0)/(double) (t2 - t1));
+        }
+    }
+
+    // The bpw sweep issues many sample-sized calls from many worker threads at
+    // once. That concurrency, not per-call sharding, is what should spread the
+    // work over the GPUs -- measure it the way the sweep actually behaves.
+    {
+        const int64_t n_per_row   = 4096;
+        const int64_t sample_rows = 512;
+        const int     nthread     = 32;
+        const int     per_thread  = 8;
+
+        std::mt19937 rng(5u);
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        std::vector<float> src((size_t) sample_rows*n_per_row);
+        for (auto & v : src) { v = nd(rng); }
+        std::vector<float> im((size_t) n_per_row, 1.0f);
+
+        printf("\nconcurrent sweep-shaped calls: %d threads x %d calls of %lld rows\n",
+               nthread, per_thread, (long long) sample_rows);
+
+        for (ggml_type type : { GGML_TYPE_Q4_K, GGML_TYPE_IQ2_XS, GGML_TYPE_IQ4_XS }) {
+            const size_t rs = ggml_row_size(type, n_per_row);
+            std::vector<std::vector<uint8_t>> out((size_t) nthread);
+            for (auto & o : out) { o.resize((size_t) sample_rows*rs); }
+
+            // warm every device for this type before timing
+            for (int i = 0; i < 16; ++i) {
+                ggml_cuda_quantize_weights(type, src.data(), out[0].data(), sample_rows, n_per_row, im.data());
+            }
+
+            // repeat: GPU clocks and other load make a single run unreliable
+            double best = 0.0;
+            for (int rep = 0; rep < 5; ++rep) {
+                const int64_t t0 = ggml_time_us();
+                std::vector<std::thread> th;
+                for (int t = 0; t < nthread; ++t) {
+                    th.emplace_back([&, t]() {
+                        for (int k = 0; k < per_thread; ++k) {
+                            ggml_cuda_quantize_weights(type, src.data(), out[(size_t) t].data(),
+                                                       sample_rows, n_per_row, im.data());
+                        }
+                    });
+                }
+                for (auto & x : th) { x.join(); }
+                const int64_t t1 = ggml_time_us();
+                best = std::max(best, nthread*per_thread/((t1 - t0)/1e6));
+            }
+            printf("  %-10s %8.1f calls/s (best of 5)\n", ggml_type_name(type), best);
+        }
+    }
+
+    printf("\n%d comparison(s) run against the CPU reference, %d failed\n", n_checked, n_fail);
+    if (n_checked == 0) {
+        printf("no CUDA kernels were exercised - is this a CUDA build?\n");
+        return 1;
+    }
+    return n_fail == 0 ? 0 : 1;
+}
