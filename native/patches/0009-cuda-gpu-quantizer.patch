+                        break;
+                    }
+                }
+
+                if (idx == -1) {
+                    // pruned from the hull but evaluated: keep its measured error
+                    const auto rc = std::find_if(tn.raw_candidates.begin(), tn.raw_candidates.end(), [&](const type_scores & c) { return c.type == mc; });
