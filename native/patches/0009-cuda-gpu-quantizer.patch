+// ggml-quants.c quantize_row_iq3_xxs_impl(), grid_size == 256
+static __global__ void quantize_iq3_xxs_cuda_kernel(
+        const float * __restrict__ x, block_iq3_xxs * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row,
+        const uint32_t * __restrict__ kgrid, const int * __restrict__ kmap, const uint16_t * __restrict__ kneigh) {
+
+    const int64_t ibl = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (ibl >= nsb) { return; }
+
+    const int kMaxQ = 8;
+
+    const float *   xbl = x + ibl*QK_K;
+    block_iq3_xxs * yb  = y + ibl;
+    const int64_t   sb  = ibl % nsb_per_row;
+
+    float   scales[QK_K/32];
+    float   weight[32];
+    float   xval[32];
+    int8_t  L[32];
+    int8_t  Laux[32];
+    float   waux[32];
+    bool    is_on_grid[8];
+    bool    is_on_grid_aux[8];
+    uint8_t block_signs[8];
+    uint8_t q3[3*(QK_K/8) + QK_K/32];
+
+    uint32_t * scales_and_signs = (uint32_t *) (q3 + QK_K/4);
+
+    yb->d = __float2half(0.0f);
+    for (int i = 0; i < 3*QK_K/8 + QK_K/32; ++i) { q3[i] = 0; }
+
+    float max_scale = 0.0f;
+
+    float sumx2 = 0.0f;
+    for (int i = 0; i < QK_K; ++i) { sumx2 += xbl[i]*xbl[i]; }
+    const float sigma2 = 2.0f*sumx2/QK_K;
+
+    for (int ib = 0; ib < QK_K/32; ++ib) {
+        const float * xb = xbl + 32*ib;
+        if (quant_weights) {
+            const float * qw = quant_weights + QK_K*sb + 32*ib;
+            for (int i = 0; i < 32; ++i) { weight[i] = qw[i]*sqrtf(sigma2 + xb[i]*xb[i]); }
+        } else {
+            for (int i = 0; i < 32; ++i) { weight[i] = xb[i]*xb[i]; }
+        }
+        for (int i = 0; i < 32; ++i) { waux[i] = sqrtf(weight[i]); }
+
+        for (int k = 0; k < 4; ++k) {
+            int     nflip = 0;
+            uint8_t sgn   = 0;
+            for (int i = 0; i < 8; ++i) {
+                if (xb[8*k + i] >= 0.0f) {
+                    xval[8*k + i] = xb[8*k + i];
+                } else {
+                    xval[8*k + i] = -xb[8*k + i];
+                    ++nflip;
+                    sgn |= (1 << i);
+                }
+            }
+            if (nflip%2) {
+                int   imin = 0;
+                float vmin = weight[8*k + imin]*xb[8*k + imin]*xb[8*k + imin];
+                for (int i = 1; i < 8; ++i) {
+                    const float ax = weight[8*k + i]*xb[8*k + i]*xb[8*k + i];
+                    if (ax < vmin) { vmin = ax; imin = i; }
+                }
+                xval[8*k + imin] = -xval[8*k + imin];
+                sgn ^= (1 << imin);
+            }
+            block_signs[k] = sgn & 127;
+        }
+
+        float vmax = xval[0];
+        for (int i = 1; i < 32; ++i) { vmax = fmaxf(vmax, xval[i]); }
+        for (int i = 0; i < 32; ++i) { L[i] = 0; }
+        if (vmax < GROUP_MAX_EPS_IQ3_XXS) {
+            scales[ib] = 0.0f;
+            continue;
+        }
+
+        float best  = 0.0f;
+        float scale = vmax/(2*kMaxQ - 1);
+        for (int k = 0; k < 8; ++k) { is_on_grid[k] = true; }
+
+        for (int is = -15; is <= 15; ++is) {
+            const float id         = (2*kMaxQ - 1 + is*0.2f)/vmax;
+            const float this_scale = 1.0f/id;
+            for (int k = 0; k < 8; ++k) {
+                for (int i = 0; i < 4; ++i) {
+                    const int l = nearest_int_cuda(0.5f*(id*xval[4*k + i] - 1));
+                    Laux[4*k + i] = max(0, min(kMaxQ - 1, l));
+                }
+                uint16_t u = 0;
+                for (int i = 0; i < 4; ++i) { u |= (Laux[4*k + i] << 3*i); }
+                int grid_index = kmap[u];
+                is_on_grid_aux[k] = true;
+                if (grid_index < 0) {
+                    is_on_grid_aux[k] = false;
+                    const uint16_t * neighbours = kneigh - kmap[u] - 1;
+                    grid_index = iq3_find_best_neighbour_cuda(neighbours, kgrid, xval + 4*k, waux + 4*k, this_scale, Laux + 4*k);
+                }
+            }
+            float sumqx = 0.0f, sumq2 = 0.0f;
+            for (int i = 0; i < 32; ++i) {
+                const float w = weight[i];
+                const float q = 2*Laux[i] + 1;
+                sumqx += w*xval[i]*q;
+                sumq2 += w*q*q;
+            }
+            if (sumq2 > 0.0f && sumqx*sumqx > best*sumq2) {
+                scale = sumqx/sumq2;
+                best  = scale*sumqx;
+                for (int i = 0; i < 32; ++i) { L[i] = Laux[i]; }
+                for (int k = 0; k <  8; ++k) { is_on_grid[k] = is_on_grid_aux[k]; }
+            }
+        }
+
+        int n_not_ongrid = 0;
+        for (int k = 0; k < 8; ++k) { if (!is_on_grid[k]) { ++n_not_ongrid; } }
+        if (n_not_ongrid > 0 && scale > 0.0f) {
+            const float id = 1.0f/scale;
+            for (int k = 0; k < 8; ++k) {
+                if (is_on_grid[k]) { continue; }
+                uint16_t u = 0;
+                for (int i = 0; i < 4; ++i) {
+                    int l = nearest_int_cuda(0.5f*(id*xval[4*k + i] - 1));
+                    l = max(0, min(kMaxQ - 1, l));
+                    u |= (l << 3*i);
+                }
+                int grid_index = kmap[u];
+                if (grid_index < 0) {
+                    const uint16_t * neighbours = kneigh - kmap[u] - 1;
+                    grid_index = iq3_find_best_neighbour_cuda(neighbours, kgrid, xval + 4*k, waux + 4*k, scale, L + 4*k);
+                }
+                const int8_t * pg = (const int8_t *) (kgrid + grid_index);
+                for (int i = 0; i < 4; ++i) { L[4*k + i] = (pg[i] - 1)/2; }
+            }
+            float sumqx = 0.0f, sumq2 = 0.0f;
+            for (int i = 0; i < 32; ++i) {
+                const float w = weight[i];
+                const float q = 2*L[i] + 1;
+                sumqx += w*xval[i]*q;
+                sumq2 += w*q*q;
+            }
+            if (sumq2 > 0.0f) { scale = sumqx/sumq2; }
+        }
+
+        if (scale < 0.0f) {
+            scale = -scale;
+            for (int k = 0; k < 4; ++k) { block_signs[k] = (~block_signs[k]) & 127; }
+        }
+
+        for (int k = 0; k < 8; ++k) {
+            uint16_t u = 0;
+            for (int i = 0; i < 4; ++i) { u |= (L[4*k + i] << 3*i); }
+            const int grid_index = kmap[u];
+            if (grid_index < 0) { return; }   // off-grid; the CPU path aborts here
+            q3[8*ib + k] = grid_index;
+        }
+        scales_and_signs[ib] = block_signs[0] | (block_signs[1] << 7) | (block_signs[2] << 14) | (block_signs[3] << 21);
+        scales[ib] = scale;
+        max_scale  = fmaxf(max_scale, scale);
+    }
+
+    const int quant_size = (int) (sizeof(block_iq3_xxs) - sizeof(half));
+
+    if (!max_scale) {
+        for (int i = 0; i < quant_size; ++i) { yb->qs[i] = 0; }
+        return;
+    }
+
+    const float d = max_scale/31;
+    yb->d = __float2half(d*1.0125f);   // small improvement via this fudge factor
+    const float id = 1.0f/d;
+    for (int ib = 0; ib < QK_K/32; ++ib) {
+        int l = nearest_int_cuda(0.5f*(id*scales[ib] - 1));
+        l = max(0, min(15, l));
+        scales_and_signs[ib] |= ((uint32_t) l << 28);
+    }
+    for (int i = 0; i < quant_size; ++i) { yb->qs[i] = q3[i]; }
+}
