+                for (int i = 0; i < 8; ++i) {
+                    const int l = nearest_int_cuda(0.5f*(id*xval[8*k + i] - 1));
+                    Laux[8*k + i] = max(0, min(kMaxQ - 1, l));
+                }
+                uint16_t u = 0;
+                for (int i = 0; i < 8; ++i) { u |= (Laux[8*k + i] << 2*i); }
+                int grid_index = kmap[u];
+                is_on_grid_aux[k] = true;
+                if (grid_index < 0) {
+                    is_on_grid_aux[k] = false;
+                    const uint16_t * neighbours = kneigh - kmap[u] - 1;
+                    grid_index = iq2_find_best_neighbour_cuda(neighbours, kgrid, xval + 8*k, waux + 8*k, this_scale, Laux + 8*k);
+                }
+            }
+            float sumqx = 0.0f, sumq2 = 0.0f;
+            for (int i = 0; i < 16; ++i) {
+                const float w = weight[i];
+                const float q = 2*Laux[i] + 1;
+                sumqx += w*xval[i]*q;
+                sumq2 += w*q*q;
+            }
+            if (sumq2 > 0.0f && sumqx*sumqx > best*sumq2) {
+                scale = sumqx/sumq2;
+                best  = scale*sumqx;
+                for (int i = 0; i < 16; ++i) { L[i] = Laux[i]; }
+                for (int k = 0; k <  2; ++k) { is_on_grid[k] = is_on_grid_aux[k]; }
+            }
+        }
+
+        int n_not_ongrid = 0;
+        for (int k = 0; k < 2; ++k) { if (!is_on_grid[k]) { ++n_not_ongrid; } }
+        if (n_not_ongrid > 0 && scale > 0.0f) {
+            const float id = 1.0f/scale;
+            for (int k = 0; k < 2; ++k) {
+                if (is_on_grid[k]) { continue; }
+                uint16_t u = 0;
+                for (int i = 0; i < 8; ++i) {
+                    int l = nearest_int_cuda(0.5f*(id*xval[8*k + i] - 1));
+                    l = max(0, min(kMaxQ - 1, l));
+                    u |= (l << 2*i);
+                    L[8*k + i] = l;
+                }
+                int grid_index = kmap[u];
+                if (grid_index < 0) {
+                    const uint16_t * neighbours = kneigh - kmap[u] - 1;
+                    grid_index = iq2_find_best_neighbour_cuda(neighbours, kgrid, xval + 8*k, waux + 8*k, scale, L + 8*k);
+                }
+            }
+            float sumqx = 0.0f, sumq2 = 0.0f;
+            for (int i = 0; i < 16; ++i) {
+                const float w = weight[i];
+                const float q = 2*L[i] + 1;
+                sumqx += w*xval[i]*q;
+                sumq2 += w*q*q;
+            }
+            if (sumq2 > 0.0f) { scale = sumqx/sumq2; }
+        }
+
+        if (scale < 0.0f) {
+            scale = -scale;
+            for (int k = 0; k < 2; ++k) { block_signs[k] = ~block_signs[k]; }
+        }
+
+        for (int k = 0; k < 2; ++k) {
+            uint16_t u = 0;
+            for (int i = 0; i < 8; ++i) { u |= (L[8*k + i] << 2*i); }
+            const int grid_index = kmap[u];
+            if (grid_index < 0) { return; }   // off-grid; the CPU path aborts here
+            const int i8 = 2*ib + k;
+            yb->qs[i8]            = grid_index & 255;
+            yb->qh[i8/4]         |= ((grid_index >> 8) << 2*(i8%4));
+            yb->qs[QK_K/8 + i8]   = block_signs[k];
+        }
+        scales[ib] = scale;
+        max_scale  = fmaxf(max_scale, scale);
+    }
+
+    if (!max_scale) { return; }
+
+    const float d = max_scale/31;
+    yb->d = __float2half(d*0.9875f);
+    const float id = 1.0f/d;
+    for (int ib = 0; ib < QK_K/16; ++ib) {
+        int l = nearest_int_cuda(0.5f*(id*scales[ib] - 1));
+        l = max(0, min(15, l));
+        if (ib%2 == 0) { yb->scales[ib/2]  = l;        }
+        else           { yb->scales[ib/2] |= (l << 4); }
+    }
+}
