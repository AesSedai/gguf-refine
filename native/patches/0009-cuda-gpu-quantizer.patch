+            scales[ib] = 0.0f;
+            continue;
+        }
+
+        float best  = 0.0f;
+        float scale = vmax/(2*kMaxQ - 1);
+        is_on_grid[0] = is_on_grid[1] = true;
+
+        for (int is = -9; is <= 9; ++is) {
