+// GPU weight quantization.
+//
+// ggml quantizes weights on the CPU. The --target-bpw sweep quantizes a sample
+// of every tensor into every candidate type to measure error, which makes that
+// the dominant cost, so use the CUDA kernels when the backend offers them.
+// Resolved through the backend registry so this still links without CUDA.
+// Set LLAMA_QUANT_NO_GPU=1 to force the CPU path.
+typedef bool (*llama_quant_gpu_fn)(enum ggml_type, const float *, void *, int64_t, int64_t, const float *);
+typedef bool (*llama_quant_gpu_supports_fn)(enum ggml_type);
+
+static llama_quant_gpu_fn          g_quant_gpu          = nullptr;
+static llama_quant_gpu_supports_fn g_quant_gpu_supports = nullptr;
+
+static void llama_quant_gpu_init() {
+    static std::once_flag once;
+    std::call_once(once, []() {
+        if (getenv("LLAMA_QUANT_NO_GPU")) {
+            LLAMA_LOG_INFO("%s: LLAMA_QUANT_NO_GPU set, quantizing on the CPU\n", __func__);
+            return;
+        }
+        ggml_backend_reg_t reg = ggml_backend_reg_by_name("CUDA");
+        if (!reg) { return; }
+        g_quant_gpu          = (llama_quant_gpu_fn)          ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_quantize_weights");
+        g_quant_gpu_supports = (llama_quant_gpu_supports_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_quantize_weights_supports");
+        if (!g_quant_gpu || !g_quant_gpu_supports) {
+            g_quant_gpu          = nullptr;
+            g_quant_gpu_supports = nullptr;
+            return;
+        }
+        LLAMA_LOG_INFO("%s: using CUDA for weight quantization\n", __func__);
+    });
+}
+
+static bool llama_quant_gpu_supports(enum ggml_type type) {
+    llama_quant_gpu_init();
+    return g_quant_gpu_supports && g_quant_gpu_supports(type);
+}
