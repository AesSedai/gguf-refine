diff --git a/ggml/src/ggml-cuda/quantize-weights.cu b/ggml/src/ggml-cuda/quantize-weights.cu
new file mode 100644
index 000000000..bdf0268c7
--- /dev/null
+++ b/ggml/src/ggml-cuda/quantize-weights.cu
@@ -0,0 +1,3457 @@
+#include "quantize-weights.cuh"
+
+#include "ggml-quants.h"
+
+#include <cstdint>
+#include <cstring>
+#include <atomic>
+#include <algorithm>
+#include <mutex>
+#include <vector>
+
+// Each kernel is a transliteration of the matching *_ref / *_impl function in
+// ggml-quants.c: one thread per quantization block, same scalar arithmetic in
+// the same order. Keeping the scalar form (rather than re-deriving a batched
+// one) is what makes the output bit-identical to the CPU path.
+
+#define GROUP_MAX_EPS 1e-15f
+#define GROUP_MAX_EPS_IQ3_XXS 1e-8f
+#define GROUP_MAX_EPS_IQ2_S   1e-8f
+#define GROUP_MAX_EPS_IQ1_S   1e-12f
+#define GROUP_MAX_EPS_IQ1_M   1e-7f
+
+static __device__ __forceinline__ int nearest_int_cuda(float fval) {
+    // ggml-quants.c nearest_int()
+    const float val = fval + 12582912.f;
+    const int   i   = __float_as_int(val);
+    return (i & 0x007fffff) - 0x00400000;
+}
+
+// The *_impl paths derive sigma2 from a sum over the whole row. A parallel
+// reduction would sum in a different order and change the low bits, which is
+// enough to flip a nearest_int() and break equality with the CPU. Sum it
+// serially, in the same order, and eat the cost: it is O(n) against the
+// O(n * search steps) of the block work that follows.
+static __device__ float row_sum_sq_serial(const float * __restrict__ x, const int64_t n) {
+    float sum = 0.0f;
+    for (int64_t j = 0; j < n; ++j) {
+        sum += x[j]*x[j];
+    }
+    return sum;
+}
+
+// ggml-quants.c make_qx_quants()
+template <int N>
+static __device__ float make_qx_quants_cuda(
+        const int nmax, const float * __restrict__ x, int8_t * __restrict__ L,
+        const int rmse_type_in, const float * __restrict__ qw) {
+
+    float vmax = 0.0f;
+    float amax = 0.0f;
+    for (int i = 0; i < N; ++i) {
+        const float ax = fabsf(x[i]);
+        if (ax > amax) { amax = ax; vmax = x[i]; }
+    }
+    if (amax < GROUP_MAX_EPS) {
+        for (int i = 0; i < N; ++i) { L[i] = 0; }
+        return 0.0f;
+    }
+
+    float iscale = -(float) nmax / vmax;
+
+    int  rmse_type   = rmse_type_in;
+    bool return_early = false;
+    if (rmse_type == 0) {
+        for (int i = 0; i < N; ++i) {
+            const int l = nearest_int_cuda(iscale*x[i]);
+            L[i] = nmax + max(-nmax, min(nmax - 1, l));
+        }
+        return 1.0f/iscale;
+    }
+    if (rmse_type < 0) {
+        rmse_type    = -rmse_type;
+        return_early = true;
+    }
+
+    float sumlx = 0.0f;
+    float suml2 = 0.0f;
+    for (int i = 0; i < N; ++i) {
+        int l = nearest_int_cuda(iscale*x[i]);
+        l = max(-nmax, min(nmax - 1, l));
+        L[i] = l + nmax;
+        const float w = qw ? qw[i]
+                      : rmse_type == 1 ? x[i]*x[i]
+                      : rmse_type == 2 ? 1.0f
+                      : rmse_type == 3 ? fabsf(x[i])
+                                       : sqrtf(fabsf(x[i]));
+        sumlx += w*x[i]*l;
+        suml2 += w*l*l;
+    }
+
+    float scale = suml2 ? sumlx/suml2 : 0.0f;
+    if (return_early) {
+        return suml2 > 0.0f ? 0.5f*(scale + 1.0f/iscale) : 1.0f/iscale;
+    }
+
+    float best = scale*sumlx;
+    for (int is = -9; is <= 9; ++is) {
+        if (is == 0) { continue; }
+        iscale = -((float) nmax + 0.1f*is)/vmax;
+        sumlx = suml2 = 0.0f;
+        for (int i = 0; i < N; ++i) {
+            int l = nearest_int_cuda(iscale*x[i]);
+            l = max(-nmax, min(nmax - 1, l));
+            const float w = qw ? qw[i]
+                          : rmse_type == 1 ? x[i]*x[i]
+                          : rmse_type == 2 ? 1.0f
+                          : rmse_type == 3 ? fabsf(x[i])
+                                           : sqrtf(fabsf(x[i]));
+            sumlx += w*x[i]*l;
+            suml2 += w*l*l;
+        }
+        if (suml2 > 0.0f && sumlx*sumlx > best*suml2) {
+            for (int i = 0; i < N; ++i) {
+                const int l = nearest_int_cuda(iscale*x[i]);
+                L[i] = nmax + max(-nmax, min(nmax - 1, l));
+            }
+            scale = sumlx/suml2;
+            best  = scale*sumlx;
+        }
+    }
+    return scale;
+}
+
+// ---------------------------------------------------------------- q4_0
+
+static __global__ void quantize_q4_0_cuda_kernel(
+        const float * __restrict__ x, block_q4_0 * __restrict__ y, const int64_t nblocks) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nblocks) {
+        return;
+    }
+
+    const float * xb = x + i*QK4_0;
+
+    float amax = 0.0f;
+    float vmax = 0.0f;
+    for (int j = 0; j < QK4_0; ++j) {
+        const float v = xb[j];
+        if (amax < fabsf(v)) {
+            amax = fabsf(v);
+            vmax = v;
+        }
+    }
+
+    const float d  = vmax / -8.0f;
+    const float id = d ? 1.0f/d : 0.0f;
+
+    y[i].d = __float2half(d);
+
+    for (int j = 0; j < QK4_0/2; ++j) {
+        const float x0 = xb[j]          *id;
+        const float x1 = xb[QK4_0/2 + j]*id;
+
+        const int8_t t0 = (int8_t)(x0 + 8.5f);
+        const int8_t t1 = (int8_t)(x1 + 8.5f);
+
+        const uint8_t xi0 = t0 < 15 ? (uint8_t)t0 : 15;
+        const uint8_t xi1 = t1 < 15 ? (uint8_t)t1 : 15;
+
+        y[i].qs[j] = xi0 | (xi1 << 4);
+    }
+}
+
+// ggml-quants.c quantize_row_q4_0_impl(), one CUDA block per row
+static __global__ void quantize_q4_0_impl_cuda_kernel(
+        const float * __restrict__ x, block_q4_0 * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t n_per_row, const int64_t nb_per_row) {
+
+    const int64_t    row = blockIdx.x;
+    const float *    xr  = x + row*n_per_row;
+    block_q4_0 *     yr  = y + row*nb_per_row;
+
+    __shared__ float s_sigma2;
+    if (threadIdx.x == 0) {
+        s_sigma2 = row_sum_sq_serial(xr, n_per_row)/(float) n_per_row;
+    }
+    __syncthreads();
+    const float sigma2 = s_sigma2;
+
+    float  weight[QK4_0];
+    int8_t L[QK4_0];
+
+    for (int64_t ib = threadIdx.x; ib < nb_per_row; ib += blockDim.x) {
+        const float * xb = xr + QK4_0*ib;
+        const float * qw = quant_weights + QK4_0*ib;
+        for (int j = 0; j < QK4_0; ++j) {
+            weight[j] = qw[j]*sqrtf(sigma2 + xb[j]*xb[j]);
+        }
+        const float d = make_qx_quants_cuda<QK4_0>(8, xb, L, 1, weight);
+        yr[ib].d = __float2half(d);
+        for (int j = 0; j < 16; ++j) {
+            yr[ib].qs[j] = L[j] | (L[j + 16] << 4);
+        }
+    }
+}
+
+// ---------------------------------------------------------------- q8_0
+
+static __global__ void quantize_q8_0_cuda_kernel(
+        const float * __restrict__ x, block_q8_0 * __restrict__ y, const int64_t nblocks) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nblocks) {
+        return;
+    }
+
+    const float * xb = x + i*QK8_0;
+
+    float amax = 0.0f;
+    for (int j = 0; j < QK8_0; ++j) {
+        amax = fmaxf(amax, fabsf(xb[j]));
+    }
+
+    const float d  = amax / ((1 << 7) - 1);
+    const float id = d ? 1.0f/d : 0.0f;
+
+    y[i].d = __float2half(d);
+
+    for (int j = 0; j < QK8_0; ++j) {
+        y[i].qs[j] = (int8_t)roundf(xb[j]*id);
+    }
+}
+
+// ggml-quants.c make_q3_quants(), do_rmse == true (the only way q3_K_ref calls it)
+template <int N>
+static __device__ float make_q3_quants_cuda(const int nmax, const float * __restrict__ x, int8_t * __restrict__ L) {
+    float vmax = 0.0f;
+    float amax = 0.0f;
+    for (int i = 0; i < N; ++i) {
+        const float ax = fabsf(x[i]);
+        if (ax > amax) { amax = ax; vmax = x[i]; }
+    }
+    if (amax < GROUP_MAX_EPS) {
+        for (int i = 0; i < N; ++i) { L[i] = 0; }
+        return 0.0f;
+    }
+
+    const float iscale = -(float) nmax/vmax;
+    float sumlx = 0.0f;
+    float suml2 = 0.0f;
+    for (int i = 0; i < N; ++i) {
+        int l = nearest_int_cuda(iscale*x[i]);
+        l = max(-nmax, min(nmax - 1, l));
+        L[i] = l;
+        const float w = x[i]*x[i];
+        sumlx += w*x[i]*l;
+        suml2 += w*l*l;
+    }
+
+    for (int itry = 0; itry < 5; ++itry) {
+        int n_changed = 0;
+        for (int i = 0; i < N; ++i) {
+            const float w = x[i]*x[i];
+            float slx = sumlx - w*x[i]*L[i];
+            if (slx > 0.0f) {
+                float sl2 = suml2 - w*L[i]*L[i];
+                int new_l = nearest_int_cuda(x[i]*sl2/slx);
+                new_l = max(-nmax, min(nmax - 1, new_l));
+                if (new_l != L[i]) {
+                    slx += w*x[i]*new_l;
+                    sl2 += w*new_l*new_l;
+                    if (sl2 > 0.0f && slx*slx*suml2 > sumlx*sumlx*sl2) {
+                        L[i] = new_l;
+                        sumlx = slx;
+                        suml2 = sl2;
+                        ++n_changed;
+                    }
+                }
+            }
+        }
+        if (!n_changed) { break; }
+    }
+
+    for (int i = 0; i < N; ++i) { L[i] += nmax; }
+    return suml2 > 0.0f ? sumlx/suml2 : 0.0f;
+}
+
+// ---------------------------------------------------------------- q3_K
+
+// both q3_K paths re-derive L from the packed 6-bit scales, then pack it
+static __device__ void q3_k_requant_cuda(const float * __restrict__ x, block_q3_K * __restrict__ y, int8_t * __restrict__ L) {
+    for (int j = 0; j < QK_K/16; ++j) {
+        int8_t sc = j < 8 ? (y->scales[j] & 0xF) : (y->scales[j - 8] >> 4);
+        sc = (sc | (((y->scales[8 + j%4] >> (2*(j/4))) & 3) << 4)) - 32;
+        const float d = __half2float(y->d)*sc;
+        if (!d) { continue; }
+        for (int ii = 0; ii < 16; ++ii) {
+            int l = nearest_int_cuda(x[16*j + ii]/d);
+            l = max(-4, min(3, l));
+            L[16*j + ii] = l + 4;
+        }
+    }
+}
+
+static __device__ void q3_k_pack_cuda(block_q3_K * __restrict__ y, int8_t * __restrict__ L) {
+    for (int j = 0; j < QK_K/8; ++j) { y->hmask[j] = 0; }
+
+    // high bit of the 1st 8 quants goes into bit 0, the next 8 into bit 1, etc.
+    int     m  = 0;
+    uint8_t hm = 1;
+    for (int j = 0; j < QK_K; ++j) {
+        if (L[j] > 3) {
+            y->hmask[m] |= hm;
+            L[j] -= 4;
+        }
+        if (++m == QK_K/8) { m = 0; hm <<= 1; }
+    }
+
+    for (int j = 0; j < QK_K; j += 128) {
+        for (int l = 0; l < 32; ++l) {
+            y->qs[j/4 + l] = L[j + l] | (L[j + l + 32] << 2) | (L[j + l + 64] << 4) | (L[j + l + 96] << 6);
+        }
+    }
+}
+
+// ggml-quants.c quantize_row_q3_K_ref()
+static __global__ void quantize_q3_k_ref_cuda_kernel(
+        const float * __restrict__ x, block_q3_K * __restrict__ y, const int64_t nsb) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nsb) { return; }
+
+    const float * xb = x + i*QK_K;
+    block_q3_K *  yb = y + i;
+
+    int8_t L[QK_K];
+    float  scales[QK_K/16];
+
+    float max_scale = 0.0f;
+    float amax      = 0.0f;
+    for (int j = 0; j < QK_K/16; ++j) {
+        scales[j] = make_q3_quants_cuda<16>(4, xb + 16*j, L + 16*j);
+        const float scale = fabsf(scales[j]);
+        if (scale > amax) { amax = scale; max_scale = scales[j]; }
+    }
+
+    for (int j = 0; j < 12; ++j) { yb->scales[j] = 0; }
+
+    if (max_scale) {
+        const float iscale = -32.0f/max_scale;
+        for (int j = 0; j < QK_K/16; ++j) {
+            int8_t l = nearest_int_cuda(iscale*scales[j]);   // narrowed before the clamp, as in the C
+            l = max(-32, min(31, (int) l)) + 32;
+            if (j < 8) { yb->scales[j]     = l & 0xF; }
+            else       { yb->scales[j - 8] |= ((l & 0xF) << 4); }
+            l >>= 4;
+            yb->scales[j%4 + 8] |= (l << (2*(j/4)));
+        }
+        yb->d = __float2half(1.0f/iscale);
+    } else {
+        yb->d = __float2half(0.0f);
+    }
+
+    q3_k_requant_cuda(xb, yb, L);
+    q3_k_pack_cuda(yb, L);
+}
+
+// ggml-quants.c quantize_row_q3_K_impl(); sigma2 is per superblock, so one thread per block works
+static __global__ void quantize_q3_k_impl_cuda_kernel(
+        const float * __restrict__ x, block_q3_K * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nsb) { return; }
+
+    const float * xb = x + i*QK_K;
+    block_q3_K *  yb = y + i;
+    const int64_t sb = i % nsb_per_row;   // the imatrix repeats for every row
+
+    int8_t L[QK_K];
+    float  scales[QK_K/16];
+    float  weight[16];
+    float  sw[QK_K/16];
+    int8_t Ls[QK_K/16];
+
+    float sumx2 = 0.0f;
+    for (int j = 0; j < QK_K; ++j) { sumx2 += xb[j]*xb[j]; }
+    const float sigma2 = 2.0f*sumx2/QK_K;
+
+    for (int j = 0; j < QK_K/16; ++j) {
+        const float * qw = quant_weights + QK_K*sb + 16*j;
+        for (int l = 0; l < 16; ++l) {
+            weight[l] = qw[l]*sqrtf(sigma2 + xb[16*j + l]*xb[16*j + l]);
+        }
+        float sumw = 0.0f;
+        for (int l = 0; l < 16; ++l) { sumw += weight[l]; }
+        sw[j] = sumw;
+
+        scales[j] = make_qx_quants_cuda<16>(4, xb + 16*j, L + 16*j, 1, weight);
+    }
+
+    for (int j = 0; j < 12; ++j) { yb->scales[j] = 0; }
+
+    const float d_block = make_qx_quants_cuda<QK_K/16>(32, scales, Ls, 1, sw);
+    for (int j = 0; j < QK_K/16; ++j) {
+        int l = Ls[j];
+        if (j < 8) { yb->scales[j]     = l & 0xF; }
+        else       { yb->scales[j - 8] |= ((l & 0xF) << 4); }
+        l >>= 4;
+        yb->scales[j%4 + 8] |= (l << (2*(j/4)));
+    }
+    yb->d = __float2half(d_block);
+
+    q3_k_requant_cuda(xb, yb, L);
+    q3_k_pack_cuda(yb, L);
+}
+
+// ---------------------------------------------------------------- q6_K
+
+// ggml-quants.c quantize_row_q6_K_ref() and _impl() are the same code with a
+// null vs non-null qw, so one kernel serves both.
+static __global__ void quantize_q6_k_cuda_kernel(
+        const float * __restrict__ x, block_q6_K * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nsb) { return; }
+
+    const float * xb = x + i*QK_K;
+    block_q6_K *  yb = y + i;
+    const int64_t sb = i % nsb_per_row;
+
+    int8_t L[QK_K];
+    float  scales[QK_K/16];
+
+    float max_scale     = 0.0f;
+    float max_abs_scale = 0.0f;
+
+    for (int ib = 0; ib < QK_K/16; ++ib) {
+        const float * qw = quant_weights ? quant_weights + QK_K*sb + 16*ib : nullptr;
+        const float scale = make_qx_quants_cuda<16>(32, xb + 16*ib, L + 16*ib, 1, qw);
+        scales[ib] = scale;
+
+        const float abs_scale = fabsf(scale);
+        if (abs_scale > max_abs_scale) {
+            max_abs_scale = abs_scale;
+            max_scale     = scale;
+        }
+    }
+
+    if (max_abs_scale < GROUP_MAX_EPS) {
+        uint8_t * raw = (uint8_t *) yb;
+        for (int j = 0; j < (int) sizeof(block_q6_K); ++j) { raw[j] = 0; }
+        yb->d = __float2half(0.0f);
+        return;
+    }
+
+    const float iscale = -128.0f/max_scale;
+    yb->d = __float2half(1.0f/iscale);
+    for (int ib = 0; ib < QK_K/16; ++ib) {
+        yb->scales[ib] = min(127, nearest_int_cuda(iscale*scales[ib]));
+    }
+
+    for (int j = 0; j < QK_K/16; ++j) {
+        const float d = __half2float(yb->d)*yb->scales[j];
+        if (!d) { continue; }
+        for (int ii = 0; ii < 16; ++ii) {
+            int l = nearest_int_cuda(xb[16*j + ii]/d);
+            l = max(-32, min(31, l));
+            L[16*j + ii] = l + 32;
+        }
+    }
+
+    uint8_t * ql = yb->ql;
+    uint8_t * qh = yb->qh;
+    for (int j = 0; j < QK_K; j += 128) {
+        for (int l = 0; l < 32; ++l) {
+            const uint8_t q1 = L[j + l +  0] & 0xF;
+            const uint8_t q2 = L[j + l + 32] & 0xF;
+            const uint8_t q3 = L[j + l + 64] & 0xF;
+            const uint8_t q4 = L[j + l + 96] & 0xF;
+            ql[l +  0] = q1 | (q3 << 4);
+            ql[l + 32] = q2 | (q4 << 4);
+            qh[l] = (L[j + l] >> 4) | ((L[j + l + 32] >> 4) << 2) | ((L[j + l + 64] >> 4) << 4) | ((L[j + l + 96] >> 4) << 6);
+        }
+        ql += 64;
+        qh += 32;
+    }
+}
+
+// ggml-quants.c make_qkx2_quants()
+template <int N>
+static __device__ float make_qkx2_quants_cuda(
+        const int nmax, const float * __restrict__ x, const float * __restrict__ weights,
+        uint8_t * __restrict__ L, float * __restrict__ the_min, uint8_t * __restrict__ Laux,
+        const float rmin, const float rdelta, const int nstep, const bool use_mad) {
+
+    float vmin  = x[0];
+    float vmax  = x[0];
+    float sum_w = weights[0];
+    float sum_x = sum_w*x[0];
+    for (int i = 1; i < N; ++i) {
+        if (x[i] < vmin) { vmin = x[i]; }
+        if (x[i] > vmax) { vmax = x[i]; }
+        const float w = weights[i];
+        sum_w += w;
+        sum_x += w*x[i];
+    }
+    if (vmin > 0.0f) { vmin = 0.0f; }
+    if (vmax == vmin) {
+        for (int i = 0; i < N; ++i) { L[i] = 0; }
+        *the_min = -vmin;
+        return 0.0f;
+    }
+
+    float iscale = nmax/(vmax - vmin);
+    float scale  = 1.0f/iscale;
+    float best_error = 0.0f;
+    for (int i = 0; i < N; ++i) {
+        const int l = nearest_int_cuda(iscale*(x[i] - vmin));
+        L[i] = max(0, min(nmax, l));
+        float diff = scale*L[i] + vmin - x[i];
+        diff = use_mad ? fabsf(diff) : diff*diff;
+        best_error += weights[i]*diff;
+    }
+    if (nstep < 1) {
+        *the_min = -vmin;
+        return scale;
+    }
+
+    for (int is = 0; is <= nstep; ++is) {
+        iscale = (rmin + rdelta*is + nmax)/(vmax - vmin);
+        float sum_l = 0.0f, sum_l2 = 0.0f, sum_xl = 0.0f;
+        for (int i = 0; i < N; ++i) {
+            int l = nearest_int_cuda(iscale*(x[i] - vmin));
+            l = max(0, min(nmax, l));
+            Laux[i] = l;
+            const float w = weights[i];
+            sum_l  += w*l;
+            sum_l2 += w*l*l;
+            sum_xl += w*l*x[i];
+        }
+        const float D = sum_w*sum_l2 - sum_l*sum_l;
+        if (D > 0.0f) {
+            float this_scale = (sum_w*sum_xl - sum_x*sum_l)/D;
+            float this_min   = (sum_l2*sum_x - sum_l*sum_xl)/D;
+            if (this_min > 0.0f) {
+                this_min   = 0.0f;
+                this_scale = sum_xl/sum_l2;
+            }
+            float cur_error = 0.0f;
+            for (int i = 0; i < N; ++i) {
+                float diff = this_scale*Laux[i] + this_min - x[i];
+                diff = use_mad ? fabsf(diff) : diff*diff;
+                cur_error += weights[i]*diff;
+            }
+            if (cur_error < best_error) {
+                for (int i = 0; i < N; ++i) { L[i] = Laux[i]; }
+                best_error = cur_error;
+                scale      = this_scale;
+                vmin       = this_min;
+            }
+        }
+    }
+    *the_min = -vmin;
+    return scale;
+}
+
+// ggml-quants.c make_qkx3_quants(); weights may be null, then w = x*x
+template <int N>
+static __device__ float make_qkx3_quants_cuda(
+        const int nmax, const float * __restrict__ x, const float * __restrict__ weights,
+        uint8_t * __restrict__ L, float * __restrict__ the_min, uint8_t * __restrict__ Laux,
+        const float rmin, const float rdelta, const int nstep, const bool use_mad) {
+
+    float vmin  = x[0];
+    float vmax  = x[0];
+    float sum_w = weights ? weights[0] : x[0]*x[0];
+    float sum_x = sum_w*x[0];
+    for (int i = 1; i < N; ++i) {
+        if (x[i] < vmin) { vmin = x[i]; }
+        if (x[i] > vmax) { vmax = x[i]; }
+        const float w = weights ? weights[i] : x[i]*x[i];
+        sum_w += w;
+        sum_x += w*x[i];
+    }
+    if (vmin > 0.0f) { vmin = 0.0f; }
+    if (vmax <= vmin) {
+        for (int i = 0; i < N; ++i) { L[i] = 0; }
+        *the_min = -vmin;
+        return 0.0f;
+    }
+
+    float iscale = nmax/(vmax - vmin);
+    float scale  = 1.0f/iscale;
+    float best_mad = 0.0f;
+    for (int i = 0; i < N; ++i) {
+        const int l = nearest_int_cuda(iscale*(x[i] - vmin));
+        L[i] = max(0, min(nmax, l));
+        float diff = scale*L[i] + vmin - x[i];
+        diff = use_mad ? fabsf(diff) : diff*diff;
+        best_mad += (weights ? weights[i] : x[i]*x[i])*diff;
+    }
+    if (nstep < 1) {
+        *the_min = -vmin;
+        return scale;
+    }
+
+    for (int is = 0; is <= nstep; ++is) {
+        iscale = (rmin + rdelta*is + nmax)/(vmax - vmin);
+        float sum_l = 0.0f, sum_l2 = 0.0f, sum_xl = 0.0f;
+        for (int i = 0; i < N; ++i) {
+            int l = nearest_int_cuda(iscale*(x[i] - vmin));
+            l = max(0, min(nmax, l));
+            Laux[i] = l;
+            const float w = weights ? weights[i] : x[i]*x[i];
+            sum_l  += w*l;
+            sum_l2 += w*l*l;
+            sum_xl += w*l*x[i];
+        }
+        const float D = sum_w*sum_l2 - sum_l*sum_l;
+        if (D > 0.0f) {
+            float this_scale = (sum_w*sum_xl - sum_x*sum_l)/D;
+            float this_min   = (sum_l2*sum_x - sum_l*sum_xl)/D;
+            if (this_min > 0.0f) {
+                this_min   = 0.0f;
+                this_scale = sum_xl/sum_l2;
+            }
+            float mad = 0.0f;
+            for (int i = 0; i < N; ++i) {
+                float diff = this_scale*Laux[i] + this_min - x[i];
+                diff = use_mad ? fabsf(diff) : diff*diff;
+                mad += (weights ? weights[i] : x[i]*x[i])*diff;
+            }
+            if (mad < best_mad) {
+                for (int i = 0; i < N; ++i) { L[i] = Laux[i]; }
+                best_mad = mad;
+                scale    = this_scale;
+                vmin     = this_min;
+            }
+        }
+    }
+    *the_min = -vmin;
+    return scale;
+}
+
+// ggml-quants.c make_qp_quants()
+template <int N>
+static __device__ float make_qp_quants_cuda(
+        const int nmax, const float * __restrict__ x, uint8_t * __restrict__ L,
+        const float * __restrict__ quant_weights) {
+
+    float vmax = 0.0f;
+    for (int i = 0; i < N; ++i) { vmax = fmaxf(vmax, x[i]); }
+    if (vmax < GROUP_MAX_EPS) {
+        for (int i = 0; i < N; ++i) { L[i] = 0; }
+        return 0.0f;
+    }
+
+    float iscale = nmax/vmax;
+    for (int i = 0; i < N; ++i) { L[i] = nearest_int_cuda(iscale*x[i]); }
+
+    float scale    = 1.0f/iscale;
+    float best_mse = 0.0f;
+    for (int i = 0; i < N; ++i) {
+        const float diff = x[i] - scale*L[i];
+        best_mse += quant_weights[i]*diff*diff;
+    }
+
+    for (int is = -4; is <= 4; ++is) {
+        if (is == 0) { continue; }
+        const float iscale_is = (0.1f*is + nmax)/vmax;
+        const float scale_is  = 1.0f/iscale_is;
+        float mse = 0.0f;
+        for (int i = 0; i < N; ++i) {
+            int l = nearest_int_cuda(iscale_is*x[i]);
+            l = min(nmax, l);
+            const float diff = x[i] - scale_is*l;
+            mse += quant_weights[i]*diff*diff;
+        }
+        if (mse < best_mse) {
+            best_mse = mse;
+            iscale   = iscale_is;
+        }
+    }
+
+    float sumlx = 0.0f;
+    float suml2 = 0.0f;
+    for (int i = 0; i < N; ++i) {
+        int l = nearest_int_cuda(iscale*x[i]);
+        l = min(nmax, l);
+        L[i] = l;
+        const float w = quant_weights[i];
+        sumlx += w*x[i]*l;
+        suml2 += w*l*l;
+    }
+    for (int itry = 0; itry < 5; ++itry) {
+        int n_changed = 0;
+        for (int i = 0; i < N; ++i) {
+            const float w = quant_weights[i];
+            float slx = sumlx - w*x[i]*L[i];
+            float sl2 = suml2 - w*L[i]*L[i];
+            if (slx > 0.0f && sl2 > 0.0f) {
+                int new_l = nearest_int_cuda(x[i]*sl2/slx);
+                new_l = min(nmax, new_l);
+                if (new_l != L[i]) {
+                    slx += w*x[i]*new_l;
+                    sl2 += w*new_l*new_l;
+                    if (slx*slx*suml2 > sumlx*sumlx*sl2) {
+                        L[i] = new_l;
+                        sumlx = slx;
+                        suml2 = sl2;
+                        ++n_changed;
+                    }
+                }
+            }
+        }
+        if (!n_changed) { break; }
+    }
+    return suml2 > 0.0f ? sumlx/suml2 : 0.0f;
+}
+
+// ggml-quants.c get_scale_min_k4()
+static __device__ __forceinline__ void get_scale_min_k4_cuda(
+        int j, const uint8_t * __restrict__ q, uint8_t * __restrict__ d, uint8_t * __restrict__ m) {
+    if (j < 4) {
+        *d = q[j] & 63;
+        *m = q[j + 4] & 63;
+    } else {
+        *d = (q[j + 4] & 0xF) | ((q[j - 4] >> 6) << 4);
+        *m = (q[j + 4] >>  4) | ((q[j - 0] >> 6) << 4);
+    }
+}
+
+// ---------------------------------------------------------------- q4_K
+
+// shared tail: re-derive L from the packed scales, then pack into qs
+static __device__ void q4_k_finish_cuda(const float * __restrict__ x, block_q4_K * __restrict__ y, uint8_t * __restrict__ L) {
+    uint8_t sc, m;
+    for (int j = 0; j < QK_K/32; ++j) {
+        get_scale_min_k4_cuda(j, y->scales, &sc, &m);
+        const float d = __half2float(__low2half(y->dm))*sc;
+        if (!d) { continue; }
+        const float dm = __half2float(__high2half(y->dm))*m;
+        for (int ii = 0; ii < 32; ++ii) {
+            int l = nearest_int_cuda((x[32*j + ii] + dm)/d);
+            l = max(0, min(15, l));
+            L[32*j + ii] = l;
+        }
+    }
+    uint8_t * q = y->qs;
+    for (int j = 0; j < QK_K; j += 64) {
+        for (int l = 0; l < 32; ++l) { q[l] = L[j + l] | (L[j + l + 32] << 4); }
+        q += 32;
+    }
+}
+
+// pack the 6-bit sub-block scales/mins into the 12-byte split layout
+static __device__ __forceinline__ void q4_k_pack_scales_cuda(
+        block_q4_K * __restrict__ y, const uint8_t * __restrict__ Ls, const uint8_t * __restrict__ Lm) {
+    for (int j = 0; j < QK_K/32; ++j) {
+        const uint8_t ls = Ls[j];
+        const uint8_t lm = Lm[j];
+        if (j < 4) {
+            y->scales[j]     = ls;
+            y->scales[j + 4] = lm;
+        } else {
+            y->scales[j + 4] = (ls & 0xF) | ((lm & 0xF) << 4);
+            y->scales[j - 4] |= ((ls >> 4) << 6);
+            y->scales[j - 0] |= ((lm >> 4) << 6);
+        }
+    }
+}
+
+// ggml-quants.c quantize_row_q4_K_ref()
+static __global__ void quantize_q4_k_ref_cuda_kernel(
+        const float * __restrict__ x, block_q4_K * __restrict__ y, const int64_t nsb) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nsb) { return; }
+
+    const float * xb = x + i*QK_K;
+    block_q4_K *  yb = y + i;
+
+    uint8_t L[QK_K];
+    uint8_t Laux[32];
+    float   weights[32];
+    float   mins[QK_K/32];
+    float   scales[QK_K/32];
+
+    float max_scale = 0.0f;
+    float max_min   = 0.0f;
+    for (int j = 0; j < QK_K/32; ++j) {
+        float sum_x2 = 0.0f;
+        for (int l = 0; l < 32; ++l) { sum_x2 += xb[32*j + l]*xb[32*j + l]; }
+        const float av_x = sqrtf(sum_x2/32);
+        for (int l = 0; l < 32; ++l) { weights[l] = av_x + fabsf(xb[32*j + l]); }
+        scales[j] = make_qkx2_quants_cuda<32>(15, xb + 32*j, weights, L + 32*j, &mins[j], Laux, -1.0f, 0.1f, 20, false);
+        if (scales[j] > max_scale) { max_scale = scales[j]; }
+        if (mins[j]   > max_min)   { max_min   = mins[j];   }
+    }
+
+    const float inv_scale = max_scale > 0.0f ? 63.0f/max_scale : 0.0f;
+    const float inv_min   = max_min   > 0.0f ? 63.0f/max_min   : 0.0f;
+
+    uint8_t Ls[QK_K/32];
+    uint8_t Lm[QK_K/32];
+    for (int j = 0; j < QK_K/32; ++j) {
+        const uint8_t ls = nearest_int_cuda(inv_scale*scales[j]);   // narrowed before MIN, as in the C
+        const uint8_t lm = nearest_int_cuda(inv_min*mins[j]);
+        Ls[j] = ls < 63 ? ls : 63;
+        Lm[j] = lm < 63 ? lm : 63;
+    }
+    q4_k_pack_scales_cuda(yb, Ls, Lm);
+
+    yb->dm = __halves2half2(__float2half(max_scale/63.0f), __float2half(max_min/63.0f));
+
+    q4_k_finish_cuda(xb, yb, L);
+}
+
+// ggml-quants.c quantize_row_q4_K_impl()
+static __global__ void quantize_q4_k_impl_cuda_kernel(
+        const float * __restrict__ x, block_q4_K * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nsb) { return; }
+
+    const float * xb = x + i*QK_K;
+    block_q4_K *  yb = y + i;
+    const int64_t sb = i % nsb_per_row;
+
+    uint8_t L[QK_K];
+    uint8_t Laux[32];
+    uint8_t Ls[QK_K/32];
+    uint8_t Lm[QK_K/32];
+    float   weights[32];
+    float   sw[QK_K/32];
+    float   mins[QK_K/32];
+    float   scales[QK_K/32];
+
+    float sum_x2 = 0.0f;
+    for (int l = 0; l < QK_K; ++l) { sum_x2 += xb[l]*xb[l]; }
+    const float sigma2 = 2.0f*sum_x2/QK_K;
+    const float av_x   = sqrtf(sigma2);
+
+    for (int j = 0; j < QK_K/32; ++j) {
+        if (quant_weights) {
+            const float * qw = quant_weights + QK_K*sb + 32*j;
+            for (int l = 0; l < 32; ++l) { weights[l] = qw[l]*sqrtf(sigma2 + xb[32*j + l]*xb[32*j + l]); }
+        } else {
+            for (int l = 0; l < 32; ++l) { weights[l] = av_x + fabsf(xb[32*j + l]); }
+        }
+        float sumw = 0.0f;
+        for (int l = 0; l < 32; ++l) { sumw += weights[l]; }
+        sw[j] = sumw;
+        scales[j] = make_qkx3_quants_cuda<32>(15, xb + 32*j, weights, L + 32*j, &mins[j], Laux, -0.9f, 0.05f, 36, false);
+    }
+
+    const float d_block = make_qp_quants_cuda<QK_K/32>(63, scales, Ls, sw);
+    const float m_block = make_qp_quants_cuda<QK_K/32>(63, mins,   Lm, sw);
+
+    q4_k_pack_scales_cuda(yb, Ls, Lm);
+
+    yb->dm = __halves2half2(__float2half(d_block), __float2half(m_block));
+
+    q4_k_finish_cuda(xb, yb, L);
+}
+
+// ---------------------------------------------------------------- q5_K
+
+// same shape as q4_K: 6-bit sub-block scales/mins, then a 5-bit tail
+static __device__ __forceinline__ void q5_k_pack_scales_cuda(
+        block_q5_K * __restrict__ y, const uint8_t * __restrict__ Ls, const uint8_t * __restrict__ Lm) {
+    for (int j = 0; j < QK_K/32; ++j) {
+        const uint8_t ls = Ls[j];
+        const uint8_t lm = Lm[j];
+        if (j < 4) {
+            y->scales[j]     = ls;
+            y->scales[j + 4] = lm;
+        } else {
+            y->scales[j + 4] = (ls & 0xF) | ((lm & 0xF) << 4);
+            y->scales[j - 4] |= ((ls >> 4) << 6);
+            y->scales[j - 0] |= ((lm >> 4) << 6);
+        }
+    }
+}
+
+static __device__ void q5_k_finish_cuda(const float * __restrict__ x, block_q5_K * __restrict__ y, uint8_t * __restrict__ L) {
+    uint8_t sc, m;
+    for (int j = 0; j < QK_K/32; ++j) {
+        get_scale_min_k4_cuda(j, y->scales, &sc, &m);
+        const float d = __half2float(__low2half(y->dm))*sc;
+        if (!d) { continue; }
+        const float dm = __half2float(__high2half(y->dm))*m;
+        for (int ii = 0; ii < 32; ++ii) {
+            int l = nearest_int_cuda((x[32*j + ii] + dm)/d);
+            l = max(0, min(31, l));
+            L[32*j + ii] = l;
+        }
+    }
+
+    uint8_t * qh = y->qh;
+    uint8_t * ql = y->qs;
+    for (int j = 0; j < QK_K/8; ++j) { qh[j] = 0; }
+
+    uint8_t m1 = 1, m2 = 2;
+    for (int n = 0; n < QK_K; n += 64) {
+        for (int j = 0; j < 32; ++j) {
+            int l1 = L[n + j];
+            if (l1 > 15) { l1 -= 16; qh[j] |= m1; }
+            int l2 = L[n + j + 32];
+            if (l2 > 15) { l2 -= 16; qh[j] |= m2; }
+            ql[j] = l1 | (l2 << 4);
+        }
+        m1 <<= 2;
+        m2 <<= 2;
+        ql += 32;
+    }
+}
+
+// ggml-quants.c quantize_row_q5_K_ref()
+static __global__ void quantize_q5_k_ref_cuda_kernel(
+        const float * __restrict__ x, block_q5_K * __restrict__ y, const int64_t nsb) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nsb) { return; }
+
+    const float * xb = x + i*QK_K;
+    block_q5_K *  yb = y + i;
+
+    uint8_t L[QK_K];
+    uint8_t Laux[32];
+    float   weights[32];
+    float   mins[QK_K/32];
+    float   scales[QK_K/32];
+
+    float max_scale = 0.0f;
+    float max_min   = 0.0f;
+    for (int j = 0; j < QK_K/32; ++j) {
+        float sum_x2 = 0.0f;
+        for (int l = 0; l < 32; ++l) { sum_x2 += xb[32*j + l]*xb[32*j + l]; }
+        const float av_x = sqrtf(sum_x2/32);
+        for (int l = 0; l < 32; ++l) { weights[l] = av_x + fabsf(xb[32*j + l]); }
+        scales[j] = make_qkx2_quants_cuda<32>(31, xb + 32*j, weights, L + 32*j, &mins[j], Laux, -0.5f, 0.1f, 15, false);
+        if (scales[j] > max_scale) { max_scale = scales[j]; }
+        if (mins[j]   > max_min)   { max_min   = mins[j];   }
+    }
+
+    const float inv_scale = max_scale > 0.0f ? 63.0f/max_scale : 0.0f;
+    const float inv_min   = max_min   > 0.0f ? 63.0f/max_min   : 0.0f;
+
+    uint8_t Ls[QK_K/32];
+    uint8_t Lm[QK_K/32];
+    for (int j = 0; j < QK_K/32; ++j) {
+        const uint8_t ls = nearest_int_cuda(inv_scale*scales[j]);
+        const uint8_t lm = nearest_int_cuda(inv_min*mins[j]);
+        Ls[j] = ls < 63 ? ls : 63;
+        Lm[j] = lm < 63 ? lm : 63;
+    }
+    q5_k_pack_scales_cuda(yb, Ls, Lm);
+
+    yb->dm = __halves2half2(__float2half(max_scale/63.0f), __float2half(max_min/63.0f));
+
+    q5_k_finish_cuda(xb, yb, L);
+}
+
+// ggml-quants.c quantize_row_q5_K_impl()
+static __global__ void quantize_q5_k_impl_cuda_kernel(
+        const float * __restrict__ x, block_q5_K * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nsb) { return; }
+
+    const float * xb = x + i*QK_K;
+    block_q5_K *  yb = y + i;
+    const int64_t sb = i % nsb_per_row;
+
+    uint8_t L[QK_K];
+    uint8_t Laux[32];
+    uint8_t Ls[QK_K/32];
+    uint8_t Lm[QK_K/32];
+    float   mins[QK_K/32];
+    float   scales[QK_K/32];
+    float   sw[QK_K/32];
+    float   weights[32];
+
+    float sum_x2 = 0.0f;
+    for (int l = 0; l < QK_K; ++l) { sum_x2 += xb[l]*xb[l]; }
+    const float sigma2 = 2.0f*sum_x2/QK_K;
+    const float av_x   = sqrtf(sigma2);
+
+    for (int j = 0; j < QK_K/32; ++j) {
+        if (quant_weights) {
+            const float * qw = quant_weights + QK_K*sb + 32*j;
+            for (int l = 0; l < 32; ++l) { weights[l] = qw[l]*sqrtf(sigma2 + xb[32*j + l]*xb[32*j + l]); }
+        } else {
+            for (int l = 0; l < 32; ++l) { weights[l] = av_x + fabsf(xb[32*j + l]); }
+        }
+        float sumw = 0.0f;
+        for (int l = 0; l < 32; ++l) { sumw += weights[l]; }
+        sw[j] = sumw;
+        scales[j] = make_qkx3_quants_cuda<32>(31, xb + 32*j, weights, L + 32*j, &mins[j], Laux, -0.9f, 0.05f, 36, false);
+    }
+
+    const float d_block = make_qp_quants_cuda<QK_K/32>(63, scales, Ls, sw);
+    const float m_block = make_qp_quants_cuda<QK_K/32>(63, mins,   Lm, sw);
+
+    for (int j = 0; j < QK_K/32; ++j) {
+        Ls[j] = Ls[j] < 63 ? Ls[j] : 63;
+        Lm[j] = Lm[j] < 63 ? Lm[j] : 63;
+    }
+    q5_k_pack_scales_cuda(yb, Ls, Lm);
+
+    yb->dm = __halves2half2(__float2half(d_block), __float2half(m_block));
+
+    q5_k_finish_cuda(xb, yb, L);
+}
+
+// ---------------------------------------------------------------- q2_K
+
+// shared tail of both q2_K paths: requantize against the 4-bit scales, then pack
+static __device__ void q2_k_finish_cuda(const float * __restrict__ x, block_q2_K * __restrict__ y, uint8_t * __restrict__ L) {
+    const float dm = __half2float(__low2half(y->dm));
+    const float mm = __half2float(__high2half(y->dm));
+    for (int j = 0; j < QK_K/16; ++j) {
+        const float d = dm*(y->scales[j] & 0xF);
+        if (!d) { continue; }
+        const float m = mm*(y->scales[j] >> 4);
+        for (int ii = 0; ii < 16; ++ii) {
+            int l = nearest_int_cuda((x[16*j + ii] + m)/d);
+            l = max(0, min(3, l));
+            L[16*j + ii] = l;
+        }
+    }
+    for (int j = 0; j < QK_K; j += 128) {
+        for (int l = 0; l < 32; ++l) {
+            y->qs[j/4 + l] = L[j + l] | (L[j + l + 32] << 2) | (L[j + l + 64] << 4) | (L[j + l + 96] << 6);
+        }
+    }
+}
+
+// ggml-quants.c quantize_row_q2_K_ref()
+static __global__ void quantize_q2_k_ref_cuda_kernel(
+        const float * __restrict__ x, block_q2_K * __restrict__ y, const int64_t nsb) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nsb) { return; }
+
+    const float * xb = x + i*QK_K;
+    block_q2_K *  yb = y + i;
+
+    uint8_t L[QK_K];
+    uint8_t Laux[16];
+    float   weights[16];
+    float   mins[QK_K/16];
+    float   scales[QK_K/16];
+
+    const float q4scale = 15.0f;
+
+    float max_scale = 0.0f;
+    float max_min   = 0.0f;
+    for (int j = 0; j < QK_K/16; ++j) {
+        for (int l = 0; l < 16; ++l) { weights[l] = fabsf(xb[16*j + l]); }
+        scales[j] = make_qkx2_quants_cuda<16>(3, xb + 16*j, weights, L + 16*j, &mins[j], Laux, -0.5f, 0.1f, 15, true);
+        if (scales[j] > max_scale) { max_scale = scales[j]; }
+        if (mins[j]   > max_min)   { max_min   = mins[j];   }
+    }
+
+    half hd, hm;
+    if (max_scale > 0.0f) {
+        const float iscale = q4scale/max_scale;
+        for (int j = 0; j < QK_K/16; ++j) {
+            const int l = nearest_int_cuda(iscale*scales[j]);
+            yb->scales[j] = l;
+        }
+        hd = __float2half(max_scale/q4scale);
+    } else {
+        for (int j = 0; j < QK_K/16; ++j) { yb->scales[j] = 0; }
+        hd = __float2half(0.0f);
+    }
+    if (max_min > 0.0f) {
+        const float iscale = q4scale/max_min;
+        for (int j = 0; j < QK_K/16; ++j) {
+            const int l = nearest_int_cuda(iscale*mins[j]);
+            yb->scales[j] |= (l << 4);
+        }
+        hm = __float2half(max_min/q4scale);
+    } else {
+        hm = __float2half(0.0f);
+    }
+    yb->dm = __halves2half2(hd, hm);
+
+    q2_k_finish_cuda(xb, yb, L);
+}
+
+// ggml-quants.c quantize_row_q2_K_impl(); an imatrix is required
+static __global__ void quantize_q2_k_impl_cuda_kernel(
+        const float * __restrict__ x, block_q2_K * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nsb) { return; }
+
+    const float * xb = x + i*QK_K;
+    block_q2_K *  yb = y + i;
+    const int64_t sb = i % nsb_per_row;
+
+    uint8_t L[QK_K];
+    uint8_t Laux[16];
+    float   mins[QK_K/16];
+    float   scales[QK_K/16];
+    float   sw[QK_K/16];
+    float   weight[16];
+    uint8_t Ls[QK_K/16], Lm[QK_K/16];
+
+    for (int j = 0; j < QK_K/16; ++j) { sw[j] = 0.0f; }
+
+    float sumx2 = 0.0f;
+    for (int j = 0; j < QK_K; ++j) { sumx2 += xb[j]*xb[j]; }
+    const float sigma2 = sumx2/QK_K;
+
+    for (int j = 0; j < QK_K/16; ++j) {
+        const float * qw = quant_weights + QK_K*sb + 16*j;
+        for (int l = 0; l < 16; ++l) { weight[l] = qw[l]*sqrtf(sigma2 + xb[16*j + l]*xb[16*j + l]); }
+        for (int l = 0; l < QK_K/16; ++l) { sw[j] += weight[l]; }
+        scales[j] = make_qkx3_quants_cuda<16>(3, xb + 16*j, weight, L + 16*j, &mins[j], Laux, -0.9f, 0.05f, 36, false);
+    }
+
+    const float d_block = make_qp_quants_cuda<QK_K/16>(15, scales, Ls, sw);
+    const float m_block = make_qp_quants_cuda<QK_K/16>(15, mins,   Lm, sw);
+
+    yb->dm = __halves2half2(__float2half(d_block), __float2half(m_block));
+
+    for (int j = 0; j < QK_K/16; ++j) {
+        yb->scales[j] = Ls[j] | (Lm[j] << 4);
+    }
+
+    q2_k_finish_cuda(xb, yb, L);
+}
+
+// ---------------------------------------------------------------- mxfp4
+
+// ggml-impl.h ggml_e8m0_to_fp32_half()
+static __device__ __forceinline__ float e8m0_to_fp32_half_cuda(uint8_t x) {
+    const uint32_t bits = x < 2 ? (uint32_t) (0x00200000u << x) : ((uint32_t) (x - 1) << 23);
+    return __uint_as_float(bits);
+}
+
+// ggml-quants.c best_index_mxfp4()
+static __device__ __forceinline__ int best_index_mxfp4_cuda(float x, float e) {
+    int   best_index = 0;
+    float best_err   = fabsf(kvalues_mxfp4[0]*e - x);
+    for (int i = 1; i < 16; ++i) {
+        const float err = fabsf(kvalues_mxfp4[i]*e - x);
+        if (err < best_err) {
+            best_index = i;
+            best_err   = err;
+        }
+    }
+    return best_index;
+}
+
+// ggml-quants.c quantize_row_mxfp4_ref(); quantize_mxfp4() ignores the imatrix
+static __global__ void quantize_mxfp4_cuda_kernel(
+        const float * __restrict__ x, block_mxfp4 * __restrict__ y, const int64_t nblocks) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nblocks) { return; }
+
+    const float * xb = x + i*QK_MXFP4;
+
+    float amax = 0.0f;
+    for (int j = 0; j < QK_MXFP4; ++j) {
+        amax = fmaxf(amax, fabsf(xb[j]));
+    }
+
+    const uint8_t e = amax > 0.0f ? (uint8_t) (floorf(log2f(amax)) - 2 + 127) : 0;
+    const float   d = e8m0_to_fp32_half_cuda(e);
+
+    y[i].e = e;
+
+    for (int j = 0; j < QK_MXFP4/2; ++j) {
+        const uint8_t x0 = best_index_mxfp4_cuda(xb[j],               d);
+        const uint8_t x1 = best_index_mxfp4_cuda(xb[QK_MXFP4/2 + j],  d);
+        y[i].qs[j] = x0 | (x1 << 4);
+    }
+}
+
+// ---------------------------------------------------------------- iq4_nl / iq4_xs
+
+// ggml-quants.c best_index_int8()
+static __device__ __forceinline__ int best_index_int8_cuda(int n, const int8_t * __restrict__ val, float x) {
+    if (x <= val[0])     { return 0;     }
+    if (x >= val[n - 1]) { return n - 1; }
+    int ml = 0, mu = n - 1;
+    while (mu - ml > 1) {
+        const int mav = (ml + mu)/2;
+        if (x < val[mav]) { mu = mav; } else { ml = mav; }
+    }
+    return x - val[mu - 1] < val[mu] - x ? mu - 1 : mu;
+}
+
+// ggml-quants.c quantize_row_iq4_nl_impl(); SUPER/BLOCK pick iq4_nl (32/32) or iq4_xs (256/32)
+template <int SUPER, int BLOCK>
+static __device__ void quantize_iq4_nl_impl_cuda(
+        const float * __restrict__ x, half * dh, uint8_t * q4,
+        uint16_t * scales_h, uint8_t * scales_l, float * scales,
+        const int8_t * __restrict__ values, const float * __restrict__ quant_weights, const int ntry) {
+
+    float weight[BLOCK];
+    uint8_t L[SUPER];
+
+    float sigma2 = 0.0f;
+    for (int j = 0; j < SUPER; ++j) { sigma2 += x[j]*x[j]; }
+    sigma2 *= 2.0f/SUPER;
+
+    for (int j = 0; j < SUPER/2; ++j) { q4[j] = 0; }
+    dh[0] = __float2half(0.0f);
+
+    float max_scale  = 0.0f;
+    float amax_scale = 0.0f;
+
+    for (int ib = 0; ib < SUPER/BLOCK; ++ib) {
+        const float * xb = x + ib*BLOCK;
+        uint8_t *     Lb = L + ib*BLOCK;
+        if (quant_weights) {
+            const float * qw = quant_weights + ib*BLOCK;
+            for (int j = 0; j < BLOCK; ++j) { weight[j] = qw[j]*sqrtf(sigma2 + xb[j]*xb[j]); }
+        } else {
+            for (int j = 0; j < BLOCK; ++j) { weight[j] = xb[j]*xb[j]; }
+        }
+
+        float amax = 0.0f, vmax = 0.0f;
+        for (int j = 0; j < BLOCK; ++j) {
+            const float ax = fabsf(xb[j]);
+            if (ax > amax) { amax = ax; vmax = xb[j]; }
+        }
+        if (amax < GROUP_MAX_EPS) {
+            scales[ib] = 0.0f;
+            continue;
+        }
+
+        float d  = ntry > 0 ? -vmax/values[0] : vmax/values[0];
+        float id = 1.0f/d;
+        float sumqx = 0.0f, sumq2 = 0.0f;
+        for (int j = 0; j < BLOCK; ++j) {
+            const float al = id*xb[j];
+            const int   l  = best_index_int8_cuda(16, values, al);
+            Lb[j] = l;
+            const float q = values[l];
+            const float w = weight[j];
+            sumqx += w*q*xb[j];
+            sumq2 += w*q*q;
+        }
+        d = sumq2 > 0.0f ? sumqx/sumq2 : 0.0f;
+        float best = d*sumqx;
+
+        for (int itry = -ntry; itry <= ntry; ++itry) {
+            id = (itry + values[0])/vmax;
+            sumqx = sumq2 = 0.0f;
+            for (int j = 0; j < BLOCK; ++j) {
+                const float al = id*xb[j];
+                const int   l  = best_index_int8_cuda(16, values, al);
+                const float q  = values[l];
+                const float w  = weight[j];
+                sumqx += w*q*xb[j];
+                sumq2 += w*q*q;
+            }
+            if (sumq2 > 0.0f && sumqx*sumqx > best*sumq2) {
+                d    = sumqx/sumq2;
+                best = d*sumqx;
+            }
+        }
+
+        scales[ib] = d;
+        const float abs_d = fabsf(d);
+        if (abs_d > amax_scale) { amax_scale = abs_d; max_scale = d; }
+    }
+
+    if (SUPER/BLOCK > 1) {
+        const int nb = SUPER/BLOCK;
+        for (int j = 0; j < (nb + 7)/8; ++j) { scales_h[j] = 0; }
+        const float d = -max_scale/32;
+        dh[0] = __float2half(d);
+        const float id = d ? 1.0f/d : 0.0f;
+        for (int ib = 0; ib < SUPER/BLOCK; ++ib) {
+            int l = nearest_int_cuda(id*scales[ib]);
+            l = max(-32, min(31, l));
+            const float dl  = d*l;
+            const float idl = dl ? 1.0f/dl : 0.0f;
+            uint8_t *     Lb = L + ib*BLOCK;
+            const float * xb = x + ib*BLOCK;
+            for (int j = 0; j < BLOCK; ++j) {
+                Lb[j] = best_index_int8_cuda(16, values, idl*xb[j]);
+            }
+            l += 32;
+            const uint8_t l_l = l & 0xf;
+            const uint8_t l_h = l >> 4;
+            if (ib%2 == 0) { scales_l[ib/2]  = l_l;        }
+            else           { scales_l[ib/2] |= (l_l << 4); }
+            scales_h[ib/8] |= (l_h << 2*(ib%8));
+        }
+    } else {
+        dh[0] = __float2half(scales[0]);
+        if (ntry > 0) {
+            const float id = scales[0] ? 1.0f/scales[0] : 0.0f;
+            for (int j = 0; j < SUPER; ++j) {
+                L[j] = best_index_int8_cuda(16, values, id*x[j]);
+            }
+        }
+    }
+
+    for (int i = 0; i < SUPER/32; ++i) {
+        for (int j = 0; j < 16; ++j) {
+            q4[16*i + j] = L[32*i + j] | (L[32*i + 16 + j] << 4);
+        }
+    }
+}
+
+static __global__ void quantize_iq4_nl_cuda_kernel(
+        const float * __restrict__ x, block_iq4_nl * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nblocks, const int64_t nb_per_row) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nblocks) { return; }
+
+    const int64_t ib = i % nb_per_row;
+    const float * qw = quant_weights ? quant_weights + QK4_NL*ib : nullptr;
+
+    uint16_t unused_h;
+    float    scale;
+    quantize_iq4_nl_impl_cuda<QK4_NL, 32>(
+        x + i*QK4_NL, &y[i].d, y[i].qs, &unused_h, nullptr, &scale, kvalues_iq4nl, qw, 7);
+}
+
+static __global__ void quantize_iq4_xs_cuda_kernel(
+        const float * __restrict__ x, block_iq4_xs * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nsb) { return; }
+
+    const int64_t sb = i % nsb_per_row;
+    const float * qw = quant_weights ? quant_weights + QK_K*sb : nullptr;
+
+    float scales[QK_K/32];
+    quantize_iq4_nl_impl_cuda<QK_K, 32>(
+        x + i*QK_K, &y[i].d, y[i].qs, &y[i].scales_h, y[i].scales_l, scales, kvalues_iq4nl, qw, 7);
+}
+
+// ---------------------------------------------------------------- IQ lookup tables
+
+// iq2xs_init_impl / iq3xs_init_impl build the grid, the index map and the
+// neighbour lists on the host at runtime. Mirror them onto the device once per
+// type; they are a few hundred KiB each and live for the process.
+struct iq_tables_dev {
+    void *     grid  = nullptr;
+    int *      map   = nullptr;
+    uint16_t * neigh = nullptr;
+};
+
+#define QW_MAX_DEVICES 16
+
+// one copy per device: a kernel can only read the tables on the device it runs on
+static iq_tables_dev g_iq_tables[GGML_TYPE_COUNT][QW_MAX_DEVICES];
+static std::mutex    g_iq_tables_mutex;
+
+// the caller must already have this device current
+static bool iq_tables_get(enum ggml_type type, int device, iq_tables_dev & out) {
+    std::lock_guard<std::mutex> lock(g_iq_tables_mutex);
+
+    if (device < 0 || device >= QW_MAX_DEVICES) {
+        return false;
+    }
+
+    iq_tables_dev & e = g_iq_tables[type][device];
+    if (e.grid) {
+        out = e;
+        return true;
+    }
+
+    ggml_quantize_init(type);   // no-op if the host tables already exist
+
+    int grid_size = 0, map_size = 0, nneigh = 0;
+    const int *      hmap   = nullptr;
+    const uint16_t * hneigh = nullptr;
+    const void *     hgrid  = nullptr;
+    size_t           gsz    = 0;
+
+    switch (type) {
+        case GGML_TYPE_IQ2_XXS:
+        case GGML_TYPE_IQ2_XS:
+        case GGML_TYPE_IQ2_S:
+        case GGML_TYPE_IQ1_S:
+        case GGML_TYPE_IQ1_M:
+            hgrid = ggml_iq2_tables(type, &grid_size, &map_size, &nneigh, &hmap, &hneigh);
+            gsz   = sizeof(uint64_t);
+            break;
+        case GGML_TYPE_IQ3_XXS:
+            hgrid = ggml_iq3_tables(256, &grid_size, &map_size, &nneigh, &hmap, &hneigh);
+            gsz   = sizeof(uint32_t);
+            break;
+        case GGML_TYPE_IQ3_S:
+            hgrid = ggml_iq3_tables(512, &grid_size, &map_size, &nneigh, &hmap, &hneigh);
+            gsz   = sizeof(uint32_t);
+            break;
+        default:
+            return false;
+    }
+
+    if (!hgrid || !hmap || !hneigh || nneigh <= 0) {
+        return false;
+    }
+
+    iq_tables_dev t;
+    bool ok = cudaMalloc(&t.grid, grid_size*gsz) == cudaSuccess
+           && cudaMalloc((void **) &t.map,   map_size*sizeof(int))      == cudaSuccess
+           && cudaMalloc((void **) &t.neigh, nneigh*sizeof(uint16_t))   == cudaSuccess;
+    if (ok) {
+        ok = cudaMemcpy(t.grid,  hgrid,  grid_size*gsz,            cudaMemcpyHostToDevice) == cudaSuccess
+          && cudaMemcpy(t.map,   hmap,   map_size*sizeof(int),     cudaMemcpyHostToDevice) == cudaSuccess
+          && cudaMemcpy(t.neigh, hneigh, nneigh*sizeof(uint16_t),  cudaMemcpyHostToDevice) == cudaSuccess;
+    }
+    if (!ok) {
+        cudaFree(t.grid);
+        cudaFree(t.map);
+        cudaFree(t.neigh);
+        return false;
+    }
+
+    e   = t;
+    out = t;
+    return true;
+}
+
+// ggml-quants.c iq2_find_best_neighbour()
+static __device__ int iq2_find_best_neighbour_cuda(
+        const uint16_t * __restrict__ neighbours, const uint64_t * __restrict__ grid,
+        const float * __restrict__ xval, const float * __restrict__ weight, float scale, int8_t * __restrict__ L) {
+
+    const int num_neighbors = neighbours[0];
+    float best_d2    = INFINITY;
+    int   grid_index = -1;
+    for (int j = 1; j <= num_neighbors; ++j) {
+        const int8_t * pg = (const int8_t *) (grid + neighbours[j]);
+        float d2 = 0.0f;
+        for (int i = 0; i < 8; ++i) {
+            const float q    = pg[i];
+            const float diff = scale*q - xval[i];
+            d2 += weight[i]*diff*diff;
+        }
+        if (d2 < best_d2) { best_d2 = d2; grid_index = neighbours[j]; }
+    }
+    const int8_t * pg = (const int8_t *) (grid + grid_index);
+    for (int i = 0; i < 8; ++i) { L[i] = (pg[i] - 1)/2; }
+    return grid_index;
+}
+
+// ---------------------------------------------------------------- iq2_xxs
+
+// ggml-quants.c quantize_row_iq2_xxs_impl(); an imatrix is required
+static __global__ void quantize_iq2_xxs_cuda_kernel(
+        const float * __restrict__ x, block_iq2_xxs * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row,
+        const uint64_t * __restrict__ kgrid, const int * __restrict__ kmap, const uint16_t * __restrict__ kneigh) {
+
+    const int64_t ibl = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (ibl >= nsb) { return; }
+
+    const int kMaxQ = 3;
+
+    const float *   xbl = x + ibl*QK_K;
+    block_iq2_xxs * yb  = y + ibl;
+    const int64_t   sb  = ibl % nsb_per_row;
+
+    float    scales[QK_K/32];
+    float    weight[32];
+    float    xval[32];
+    int8_t   L[32];
+    int8_t   Laux[32];
+    float    waux[32];
+    uint8_t  block_signs[4];
+    uint32_t q2[2*(QK_K/32)];
+
+    yb->d = __float2half(0.0f);
+    for (int i = 0; i < 2*(QK_K/32); ++i) { q2[i] = 0; }
+
+    float max_scale = 0.0f;
+
+    float sumx2 = 0.0f;
+    for (int i = 0; i < QK_K; ++i) { sumx2 += xbl[i]*xbl[i]; }
+    const float sigma2 = sumx2/QK_K;
+
+    for (int ib = 0; ib < QK_K/32; ++ib) {
+        const float * xb = xbl + 32*ib;
+        const float * qw = quant_weights + QK_K*sb + 32*ib;
+        for (int i = 0; i < 32; ++i) { weight[i] = qw[i]*sqrtf(sigma2 + xb[i]*xb[i]); }
+        for (int i = 0; i < 32; ++i) { waux[i]   = sqrtf(weight[i]); }
+
+        for (int k = 0; k < 4; ++k) {
+            int     nflip = 0;
+            uint8_t sgn   = 0;
+            for (int i = 0; i < 8; ++i) {
+                if (xb[8*k + i] >= 0.0f) {
+                    xval[8*k + i] = xb[8*k + i];
+                } else {
+                    xval[8*k + i] = -xb[8*k + i];
+                    ++nflip;
+                    sgn |= (1 << i);
+                }
+            }
+            if (nflip%2) {
+                int   imin = 0;
+                float vmin = weight[8*k + imin]*xb[8*k + imin]*xb[8*k + imin];
+                for (int i = 1; i < 8; ++i) {
+                    const float ax = weight[8*k + i]*xb[8*k + i]*xb[8*k + i];
+                    if (ax < vmin) { vmin = ax; imin = i; }
+                }
+                xval[8*k + imin] = -xval[8*k + imin];
+                sgn ^= (1 << imin);
+            }
+            block_signs[k] = sgn & 127;
+        }
+
+        float vmax = xval[0];
+        for (int i = 1; i < 32; ++i) { vmax = fmaxf(vmax, xval[i]); }
+        if (vmax < GROUP_MAX_EPS) {
+            scales[ib] = 0.0f;
+            for (int i = 0; i < 32; ++i) { L[i] = 0; }
+            continue;
+        }
+
+        float scale = make_qp_quants_cuda<32>(kMaxQ + 1, xval, (uint8_t *) L, weight);
+        const float eff_max = scale*kMaxQ;
+        if (eff_max <= 0.0f) {
+            scales[ib] = 0.0f;
+            for (int i = 0; i < 32; ++i) { L[i] = 0; }
+            continue;
+        }
+
+        float best = 0.0f;
+        for (int is = -6; is <= 6; ++is) {
+            const float id         = (2*kMaxQ - 1 + is*0.1f)/eff_max;
+            const float this_scale = 1.0f/id;
+            for (int k = 0; k < 4; ++k) {
+                for (int i = 0; i < 8; ++i) {
+                    const int l = nearest_int_cuda(0.5f*(id*xval[8*k + i] - 1));
+                    Laux[8*k + i] = max(0, min(kMaxQ - 1, l));
+                }
+                uint16_t u = 0;
+                for (int i = 0; i < 8; ++i) { u |= (Laux[8*k + i] << 2*i); }
+                int grid_index = kmap[u];
+                if (grid_index < 0) {
+                    const uint16_t * neighbours = kneigh - kmap[u] - 1;
+                    grid_index = iq2_find_best_neighbour_cuda(neighbours, kgrid, xval + 8*k, waux + 8*k, this_scale, Laux + 8*k);
+                }
+            }
+            float sumqx = 0.0f, sumq2 = 0.0f;
+            for (int i = 0; i < 32; ++i) {
+                const float w = weight[i];
+                const float q = 2*Laux[i] + 1;
+                sumqx += w*xval[i]*q;
+                sumq2 += w*q*q;
+            }
+            if (sumq2 > 0.0f && sumqx*sumqx > best*sumq2) {
+                scale = sumqx/sumq2;
+                best  = scale*sumqx;
+                for (int i = 0; i < 32; ++i) { L[i] = Laux[i]; }
+            }
+        }
+
+        if (scale > 0.0f) {
+            const float id = 1.0f/scale;
+            for (int k = 0; k < 4; ++k) {
+                uint16_t u = 0;
+                for (int i = 0; i < 8; ++i) {
+                    int l = nearest_int_cuda(0.5f*(id*xval[8*k + i] - 1));
+                    l = max(0, min(kMaxQ - 1, l));
+                    u |= (l << 2*i);
+                }
+                int grid_index = kmap[u];
+                if (grid_index < 0) {
+                    const uint16_t * neighbours = kneigh - kmap[u] - 1;
+                    grid_index = iq2_find_best_neighbour_cuda(neighbours, kgrid, xval + 8*k, waux + 8*k, scale, L + 8*k);
+                }
+                const int8_t * pg = (const int8_t *) (kgrid + grid_index);
+                for (int i = 0; i < 8; ++i) { L[8*k + i] = (pg[i] - 1)/2; }
+            }
+            float sumqx = 0.0f, sumq2 = 0.0f;
+            for (int i = 0; i < 32; ++i) {
+                const float w = weight[i];
+                const float q = 2*L[i] + 1;
+                sumqx += w*xval[i]*q;
+                sumq2 += w*q*q;
+            }
+            if (sumq2 > 0.0f) { scale = sumqx/sumq2; }
+        }
+
+        if (scale < 0.0f) {
+            // uints encode the scale, so flip it positive and flip the signs to match
+            scale = -scale;
+            for (int k = 0; k < 4; ++k) { block_signs[k] = (~block_signs[k]) & 127; }
+        }
+
+        for (int k = 0; k < 4; ++k) {
+            uint16_t u = 0;
+            for (int i = 0; i < 8; ++i) { u |= (L[8*k + i] << 2*i); }
+            const int grid_index = kmap[u];
+            if (grid_index < 0) { return; }   // off-grid; the CPU path aborts here
+            q2[2*ib + 0] |= ((uint32_t) grid_index << 8*k);
+            q2[2*ib + 1] |= ((uint32_t) block_signs[k] << 7*k);
+        }
+        scales[ib] = scale;
+        max_scale  = fmaxf(max_scale, scale);
+    }
+
+    if (!max_scale) {
+        for (int i = 0; i < QK_K/4; ++i) { ((uint8_t *) yb->qs)[i] = 0; }
+        return;
+    }
+
+    const float d = max_scale/31;
+    yb->d = __float2half(d);
+    const float id = 1.0f/d;
+    for (int ib = 0; ib < QK_K/32; ++ib) {
+        int l = nearest_int_cuda(0.5f*(id*scales[ib] - 1));
+        l = max(0, min(15, l));
+        q2[2*ib + 1] |= ((uint32_t) l << 28);
+    }
+    for (int i = 0; i < QK_K/4; ++i) {
+        ((uint8_t *) yb->qs)[i] = ((const uint8_t *) q2)[i];
+    }
+}
+
+// ---------------------------------------------------------------- iq2_xs
+
+// ggml-quants.c quantize_row_iq2_xs_impl(); an imatrix is required
+static __global__ void quantize_iq2_xs_cuda_kernel(
+        const float * __restrict__ x, block_iq2_xs * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row,
+        const uint64_t * __restrict__ kgrid, const int * __restrict__ kmap, const uint16_t * __restrict__ kneigh) {
+
+    const int64_t ibl = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (ibl >= nsb) { return; }
+
+    const int kMaxQ = 3;
+
+    const float *  xbl = x + ibl*QK_K;
+    block_iq2_xs * yb  = y + ibl;
+    const int64_t  sb  = ibl % nsb_per_row;
+
+    float    scales[QK_K/16];
+    float    weight[16];
+    float    xval[16];
+    int8_t   L[16];
+    int8_t   Laux[16];
+    float    waux[16];
+    bool     is_on_grid[2];
+    bool     is_on_grid_aux[2];
+    uint8_t  block_signs[2];
+    uint16_t q2[2*(QK_K/16)];
+
+    yb->d = __float2half(0.0f);
+    for (int i = 0; i < 2*(QK_K/16); ++i) { q2[i] = 0; }
+    for (int i = 0; i < QK_K/32; ++i) { yb->scales[i] = 0; }
+
+    float max_scale = 0.0f;
+
+    float sumx2 = 0.0f;
+    for (int i = 0; i < QK_K; ++i) { sumx2 += xbl[i]*xbl[i]; }
+    const float sigma2 = sumx2/QK_K;
+
+    for (int ib = 0; ib < QK_K/16; ++ib) {
+        const float * xb = xbl + 16*ib;
+        const float * qw = quant_weights + QK_K*sb + 16*ib;
+        for (int i = 0; i < 16; ++i) { weight[i] = qw[i]*sqrtf(sigma2 + xb[i]*xb[i]); }
+        for (int i = 0; i < 16; ++i) { waux[i]   = sqrtf(weight[i]); }
+
+        for (int k = 0; k < 2; ++k) {
+            int     nflip = 0;
+            uint8_t sgn   = 0;
+            for (int i = 0; i < 8; ++i) {
+                if (xb[8*k + i] >= 0.0f) {
+                    xval[8*k + i] = xb[8*k + i];
+                } else {
+                    xval[8*k + i] = -xb[8*k + i];
+                    ++nflip;
+                    sgn |= (1 << i);
+                }
+            }
+            if (nflip%2) {
+                int   imin = 0;
+                float vmin = weight[8*k + imin]*xb[8*k + imin]*xb[8*k + imin];
+                for (int i = 1; i < 8; ++i) {
+                    const float ax = weight[8*k + i]*xb[8*k + i]*xb[8*k + i];
+                    if (ax < vmin) { vmin = ax; imin = i; }
+                }
+                xval[8*k + imin] = -xval[8*k + imin];
+                sgn ^= (1 << imin);
+            }
+            block_signs[k] = sgn & 127;
+        }
+
+        float vmax = xval[0];
+        for (int i = 1; i < 16; ++i) { vmax = fmaxf(vmax, xval[i]); }
+        for (int i = 0; i < 16; ++i) { L[i] = 0; }
+        if (vmax < GROUP_MAX_EPS) {
+            scales[ib] = 0.0f;
+            continue;
+        }
+
+        float best  = 0.0f;
+        float scale = vmax/(2*kMaxQ - 1);
+        is_on_grid[0] = is_on_grid[1] = true;
+
+        for (int is = -9; is <= 9; ++is) {
+            const float id         = (2*kMaxQ - 1 + is*0.1f)/vmax;
+            const float this_scale = 1.0f/id;
+            for (int k = 0; k < 2; ++k) {
+                for (int i = 0; i < 8; ++i) {
+                    const int l = nearest_int_cuda(0.5f*(id*xval[8*k + i] - 1));
+                    Laux[8*k + i] = max(0, min(kMaxQ - 1, l));
+                }
+                uint16_t u = 0;
+                for (int i = 0; i < 8; ++i) { u |= (Laux[8*k + i] << 2*i); }
+                int grid_index = kmap[u];
+                is_on_grid_aux[k] = true;
+                if (grid_index < 0) {
+                    is_on_grid_aux[k] = false;
+                    const uint16_t * neighbours = kneigh - kmap[u] - 1;
+                    grid_index = iq2_find_best_neighbour_cuda(neighbours, kgrid, xval + 8*k, waux + 8*k, this_scale, Laux + 8*k);
+                }
+            }
+            float sumqx = 0.0f, sumq2 = 0.0f;
+            for (int i = 0; i < 16; ++i) {
+                const float w = weight[i];
+                const float q = 2*Laux[i] + 1;
+                sumqx += w*xval[i]*q;
+                sumq2 += w*q*q;
+            }
+            if (sumq2 > 0.0f && sumqx*sumqx > best*sumq2) {
+                scale = sumqx/sumq2;
+                best  = scale*sumqx;
+                for (int i = 0; i < 16; ++i) { L[i] = Laux[i]; }
+                for (int k = 0; k <  2; ++k) { is_on_grid[k] = is_on_grid_aux[k]; }
+            }
+        }
+
+        int n_not_ongrid = 0;
+        for (int k = 0; k < 2; ++k) { if (!is_on_grid[k]) { ++n_not_ongrid; } }
+        if (n_not_ongrid > 0 && scale > 0.0f) {
+            const float id = 1.0f/scale;
+            for (int k = 0; k < 2; ++k) {
+                if (is_on_grid[k]) { continue; }
+                uint16_t u = 0;
+                for (int i = 0; i < 8; ++i) {
+                    int l = nearest_int_cuda(0.5f*(id*xval[8*k + i] - 1));
+                    l = max(0, min(kMaxQ - 1, l));
+                    u |= (l << 2*i);
+                    L[8*k + i] = l;
+                }
+                int grid_index = kmap[u];
+                if (grid_index < 0) {
+                    const uint16_t * neighbours = kneigh - kmap[u] - 1;
+                    grid_index = iq2_find_best_neighbour_cuda(neighbours, kgrid, xval + 8*k, waux + 8*k, scale, L + 8*k);
+                }
+            }
+            float sumqx = 0.0f, sumq2 = 0.0f;
+            for (int i = 0; i < 16; ++i) {
+                const float w = weight[i];
+                const float q = 2*L[i] + 1;
+                sumqx += w*xval[i]*q;
+                sumq2 += w*q*q;
+            }
+            if (sumq2 > 0.0f) { scale = sumqx/sumq2; }
+        }
+
+        if (scale < 0.0f) {
+            scale = -scale;
+            for (int k = 0; k < 2; ++k) { block_signs[k] = (~block_signs[k]) & 127; }
+        }
+
+        for (int k = 0; k < 2; ++k) {
+            uint16_t u = 0;
+            for (int i = 0; i < 8; ++i) { u |= (L[8*k + i] << 2*i); }
+            const int grid_index = kmap[u];
+            if (grid_index < 0) { return; }   // off-grid; the CPU path aborts here
+            q2[2*ib + k] = grid_index | (block_signs[k] << 9);
+        }
+        scales[ib] = scale;
+        max_scale  = fmaxf(max_scale, scale);
+    }
+
+    if (!max_scale) {
+        for (int i = 0; i < QK_K/4; ++i) { ((uint8_t *) yb->qs)[i] = 0; }
+        return;
+    }
+
+    const float d = max_scale/31;
+    yb->d = __float2half(d);
+    const float id = 1.0f/d;
+    for (int ib = 0; ib < QK_K/16; ++ib) {
+        int l = nearest_int_cuda(0.5f*(id*scales[ib] - 1));
+        l = max(0, min(15, l));
+        if (ib%2 == 0) { yb->scales[ib/2]  = l;        }
+        else           { yb->scales[ib/2] |= (l << 4); }
+    }
+    for (int i = 0; i < QK_K/4; ++i) {
+        ((uint8_t *) yb->qs)[i] = ((const uint8_t *) q2)[i];
+    }
+}
