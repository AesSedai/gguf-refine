+// ggml-quants.c quantize_row_iq2_s_impl()
+static __global__ void quantize_iq2_s_cuda_kernel(
+        const float * __restrict__ x, block_iq2_s * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row,
+        const uint64_t * __restrict__ kgrid, const int * __restrict__ kmap, const uint16_t * __restrict__ kneigh) {
+
+    const int64_t ibl = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (ibl >= nsb) { return; }
+
+    const int kMaxQ = 3;
+
+    const float * xbl = x + ibl*QK_K;
+    block_iq2_s * yb  = y + ibl;
+    const int64_t sb  = ibl % nsb_per_row;
+
+    float   scales[QK_K/16];
+    float   weight[16];
+    float   xval[16];
+    int8_t  L[16];
+    int8_t  Laux[16];
+    float   waux[16];
+    bool    is_on_grid[2];
+    bool    is_on_grid_aux[2];
+    uint8_t block_signs[2];
+
+    {   // memset(&y[ibl], 0, sizeof(block_iq2_s))
+        uint8_t * raw = (uint8_t *) yb;
+        for (int i = 0; i < (int) sizeof(block_iq2_s); ++i) { raw[i] = 0; }
+    }
+    yb->d = __float2half(0.0f);
+
+    float max_scale = 0.0f;
+
+    float sumx2 = 0.0f;
+    for (int i = 0; i < QK_K; ++i) { sumx2 += xbl[i]*xbl[i]; }
+    const float sigma2 = 2.0f*sumx2/QK_K;
+
+    for (int ib = 0; ib < QK_K/16; ++ib) {
+        const float * xb = xbl + 16*ib;
+        if (quant_weights) {
+            const float * qw = quant_weights + QK_K*sb + 16*ib;
+            for (int i = 0; i < 16; ++i) { weight[i] = qw[i]*sqrtf(sigma2 + xb[i]*xb[i]); }
+        } else {
+            for (int i = 0; i < 16; ++i) { weight[i] = 0.25f*sigma2 + xb[i]*xb[i]; }
+        }
+        for (int i = 0; i < 16; ++i) { waux[i] = sqrtf(weight[i]); }
+
