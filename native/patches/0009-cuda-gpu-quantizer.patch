+            if (sumq2 > 0.0f) { scale = sumqx/sumq2; }
+        }
+
+        if (scale < 0.0f) {
+            scale = -scale;
+            for (int k = 0; k < bs8; ++k) { block_signs[k] = ~block_signs[k]; }
+        }
+
+        for (int k = 0; k < bs4; ++k) {
+            uint16_t u = 0;
+            for (int i = 0; i < 4; ++i) { u |= (L[4*k + i] << 3*i); }
+            const int grid_index = kmap[u];
+            if (grid_index < 0) { return; }   // off-grid; the CPU path aborts here
+            qs[k] = grid_index & 255;
+            qh[(ib*bs4 + k)/8] |= ((grid_index >> 8) << ((ib*bs4 + k)%8));
+        }
+        qs += bs4;
+        for (int k = 0; k < bs8; ++k) { signs[k] = block_signs[k]; }
+        signs += bs8;
+
+        scales[ib] = scale;
+        max_scale  = fmaxf(max_scale, scale);
+    }
+
+    if (!max_scale) { return; }
+
+    const float d = max_scale/31;
+    yb->d = __float2half(d*1.033f);
+    const float id = 1.0f/d;
+    for (int ib = 0; ib < QK_K/block_size; ib += 2) {
+        int l1 = nearest_int_cuda(0.5f*(id*scales[ib + 0] - 1));
+        l1 = max(0, min(15, l1));
+        int l2 = nearest_int_cuda(0.5f*(id*scales[ib + 1] - 1));
+        l2 = max(0, min(15, l2));
+        yb->scales[ib/2] = l1 | (l2 << 4);
+    }
+}
+
+// ---------------------------------------------------------------- iq1_s / iq1_m
+
+// The CPU sorts the block with qsort() and a comparator that only looks at the
+// value, so ties keep their original order (glibc uses a stable mergesort at
+// this size). Insertion sort is stable, so equal values land the same way.
+template <int N>
+static __device__ void iq1_sort_stable_cuda(float * __restrict__ val, int * __restrict__ idx) {
+    for (int i = 1; i < N; ++i) {
+        const float v = val[i];
+        const int   k = idx[i];
+        int j = i - 1;
+        while (j >= 0 && val[j] > v) {
+            val[j + 1] = val[j];
+            idx[j + 1] = idx[j];
+            --j;
+        }
+        val[j + 1] = v;
+        idx[j + 1] = k;
+    }
+}
+
+// ggml-quants.c iq1_find_best_neighbour2()
+static __device__ int iq1_find_best_neighbour2_cuda(
+        const uint16_t * __restrict__ neighbours, const uint64_t * __restrict__ grid,
+        const float * __restrict__ xval, const float * __restrict__ weight, float scale,
+        const float * __restrict__ xg, int8_t * __restrict__ L, int ngrid) {
+
+    const int num_neighbors = neighbours[0];
+    float best_score = INFINITY;
+    int   grid_index = -1;
+    for (int j = 1; j <= num_neighbors; ++j) {
+        const int8_t * pg = (const int8_t *) (grid + neighbours[j]);
+        float d2 = 0.0f;
+        for (int i = 0; i < 8; ++i) {
+            const float q    = xg[(pg[i] - 1)/2];
+            const float w    = weight[i];
+            const float diff = scale*q - xval[i];
+            d2 += w*diff*diff;
+        }
+        if (d2 < best_score) { best_score = d2; grid_index = neighbours[j]; }
+    }
+    if (grid_index < 0) {
+        // the C falls back to a full scan; note it indexes xval[i] with the outer i
+        for (int i = 0; i < ngrid; ++i) {
+            const int8_t * grid_i = (const int8_t *) (grid + i);
+            float d2 = 0.0f;
+            for (int j = 0; j < 8; ++j) {
+                const float w    = weight[j];
+                const float q    = xg[(grid_i[j] - 1)/2];
+                const float diff = scale*q - xval[i];
+                d2 += w*diff*diff;
+            }
+            if (d2 < best_score) { best_score = d2; grid_index = i; }
+        }
+    }
+    if (grid_index < 0) { return -1; }
+    const int8_t * pg = (const int8_t *) (grid + grid_index);
+    for (int i = 0; i < 8; ++i) { L[i] = (pg[i] - 1)/2; }
+    return grid_index;
+}
+
+// ggml-quants.c quantize_row_iq1_s_impl(); an imatrix is required
+static __global__ void quantize_iq1_s_cuda_kernel(
+        const float * __restrict__ x, block_iq1_s * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row,
+        const uint64_t * __restrict__ kgrid, const int * __restrict__ kmap, const uint16_t * __restrict__ kneigh) {
+
+    const int64_t ibl = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (ibl >= nsb) { return; }
+
+    const int block_size = 32;   // IQ1S_BLOCK_SIZE
+
+    const float x_p[3] = {-1 + IQ1S_DELTA,  IQ1S_DELTA, 1 + IQ1S_DELTA};
+    const float x_m[3] = {-1 - IQ1S_DELTA, -IQ1S_DELTA, 1 - IQ1S_DELTA};
+
+    const float * xbl = x + ibl*QK_K;
+    block_iq1_s * yb  = y + ibl;
+    const int64_t sb  = ibl % nsb_per_row;
+
+    float    scales[QK_K/32];
+    float    weight[32];
+    int8_t   L[32];
+    float    sumx[33];
+    float    sumw[33];
+    float    sval[32];
+    int      sidx[32];
+    uint16_t index[4];
+    int8_t   shifts[QK_K/32];
+
+    yb->d = __float2half(0.0f);
+    for (int i = 0; i < QK_K/8;  ++i) { yb->qs[i] = 0; }
+    for (int i = 0; i < QK_K/32; ++i) { yb->qh[i] = 0; }
+
+    float max_scale = 0.0f;
+
+    float sumx2 = 0.0f;
+    for (int i = 0; i < QK_K; ++i) { sumx2 += xbl[i]*xbl[i]; }
+    const float sigma2 = 2.0f*sumx2/QK_K;
+
+    for (int ib = 0; ib < QK_K/block_size; ++ib) {
+        const float * xb = xbl + block_size*ib;
+        const float * qw = quant_weights + QK_K*sb + block_size*ib;
+        for (int i = 0; i < block_size; ++i) { weight[i] = qw[i]*sqrtf(sigma2 + xb[i]*xb[i]); }
+
+        float vmax = fabsf(xb[0]);
+        for (int i = 1; i < block_size; ++i) { vmax = fmaxf(vmax, fabsf(xb[i])); }
+        if (vmax < GROUP_MAX_EPS_IQ1_S) {
+            scales[ib] = 0.0f;
+            shifts[ib] = 1;
+            for (int i = 0; i < block_size; ++i) { L[i] = 1; }
+            continue;
+        }
+
+        // exhaustive search over the two split points of the sorted block
+        for (int j = 0; j < block_size; ++j) { sval[j] = xb[j]; sidx[j] = j; }
+        iq1_sort_stable_cuda<32>(sval, sidx);
+
+        sumx[0] = sumw[0] = 0.0f;
+        for (int j = 0; j < block_size; ++j) {
+            const int i = sidx[j];
+            sumx[j + 1] = sumx[j] + weight[i]*xb[i];
+            sumw[j + 1] = sumw[j] + weight[i];
+        }
+
+        float best_score = -INFINITY;
+        float scale      = vmax;
+        int   besti1 = -1, besti2 = -1, best_shift = 0;
+        for (int i1 = 0; i1 <= block_size; ++i1) {
+            for (int i2 = i1; i2 <= block_size; ++i2) {
+                float sumqx = (sumx[i1] - sumx[0])*x_p[0] + (sumx[i2] - sumx[i1])*x_p[1] + (sumx[block_size] - sumx[i2])*x_p[2];
+                float sumq2 = (sumw[i1] - sumw[0])*x_p[0]*x_p[0] + (sumw[i2] - sumw[i1])*x_p[1]*x_p[1] + (sumw[block_size] - sumw[i2])*x_p[2]*x_p[2];
+                if (sumq2 > 0.0f && sumqx*sumqx > best_score*sumq2) {
+                    scale = sumqx/sumq2;
+                    best_score = scale*sumqx;
+                    besti1 = i1; besti2 = i2; best_shift = 1;
+                }
+                sumqx = (sumx[i1] - sumx[0])*x_m[0] + (sumx[i2] - sumx[i1])*x_m[1] + (sumx[block_size] - sumx[i2])*x_m[2];
+                sumq2 = (sumw[i1] - sumw[0])*x_m[0]*x_m[0] + (sumw[i2] - sumw[i1])*x_m[1]*x_m[1] + (sumw[block_size] - sumw[i2])*x_m[2]*x_m[2];
+                if (sumq2 > 0.0f && sumqx*sumqx > best_score*sumq2) {
+                    scale = sumqx/sumq2;
+                    best_score = scale*sumqx;
+                    besti1 = i1; besti2 = i2; best_shift = -1;
+                }
+            }
+        }
+
+        if (besti1 < 0 || besti2 < 0 || best_shift == 0) {
+            scales[ib] = 0.0f;
+            shifts[ib] = 1;
+            for (int i = 0; i < block_size; ++i) { L[i] = 1; }
+            continue;
+        }
+
+        for (int j =      0; j < besti1;     ++j) { L[sidx[j]] = 0; }
+        for (int j = besti1; j < besti2;     ++j) { L[sidx[j]] = 1; }
+        for (int j = besti2; j < block_size; ++j) { L[sidx[j]] = 2; }
+
+        if (scale < 0.0f) {
+            for (int j = 0; j < block_size; ++j) { L[j] = 2 - L[j]; }
+            scale = -scale;
+            best_shift = -best_shift;
+        }
+
+        bool all_on_grid = true;
+        const float * xx = best_shift == 1 ? x_p : x_m;
+        for (int k = 0; k < block_size/8; ++k) {
+            uint16_t u = 0;
+            for (int j = 0; j < 8; ++j) { u |= (L[8*k + j] << 2*j); }
+            int grid_index = kmap[u];
+            if (grid_index < 0) {
+                all_on_grid = false;
+                const uint16_t * neighbours = kneigh - kmap[u] - 1;
+                grid_index = iq1_find_best_neighbour2_cuda(neighbours, kgrid, xb + 8*k, weight + 8*k, scale, xx, L + 8*k, NGRID_IQ1S);
+                if (grid_index < 0) { return; }
+            }
+            index[k] = grid_index;
+        }
+
+        if (!all_on_grid) {
+            float sumqx = 0.0f, sumq2 = 0.0f;
+            for (int k = 0; k < block_size/8; ++k) {
+                const int8_t * pg = (const int8_t *) (kgrid + index[k]);
+                for (int j = 0; j < 8; ++j) {
+                    const float w = weight[8*k + j];
+                    const float q = xx[(pg[j] - 1)/2];
+                    sumqx += w*q*xb[8*k + j];
+                    sumq2 += w*q*q;
+                }
+            }
+            if (sumqx > 0.0f && sumq2 > 0.0f) { scale = sumqx/sumq2; }
+        }
+
+        uint16_t h = 0;
+        for (int k = 0; k < block_size/8; ++k) {
+            yb->qs[(block_size/8)*ib + k] = index[k] & 255;
+            h |= (index[k] >> 8) << 3*k;
+        }
+        yb->qh[ib] = h;
+
+        scales[ib] = scale;
+        shifts[ib] = best_shift;
+        max_scale  = fmaxf(max_scale, scale);
+    }
+
+    if (!max_scale) { return; }
+
+    const float d = max_scale/15;
+    yb->d = __float2half(d*1.125f);   // fudge factor, as in the C
+    const float id = 1.0f/d;
+    for (int ib = 0; ib < QK_K/block_size; ++ib) {
+        int l = nearest_int_cuda(0.5f*(id*scales[ib] - 1));
+        l = max(0, min(7, l));
+        if (shifts[ib] == -1) { l |= 8; }
+        yb->qh[ib] |= (l << 12);
+    }
+}
+
+// ---------------------------------------------------------------- iq1_m
+
+// ggml-quants.c quantize_row_iq1_m_impl(); block_size 16, and the two halves of
+// a block may take different shifts, so the split search scores 4 sign combinations.
+static __global__ void quantize_iq1_m_cuda_kernel(
+        const float * __restrict__ x, block_iq1_m * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t nsb, const int64_t nsb_per_row,
+        const uint64_t * __restrict__ kgrid, const int * __restrict__ kmap, const uint16_t * __restrict__ kneigh) {
+
+    const int64_t ibl = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (ibl >= nsb) { return; }
+
+    const int block_size = 16;   // IQ1M_BLOCK_SIZE
+
+    const float   x_p[3]   = {-1 + IQ1M_DELTA,  IQ1M_DELTA, 1 + IQ1M_DELTA};
+    const float   x_m[3]   = {-1 - IQ1M_DELTA, -IQ1M_DELTA, 1 - IQ1M_DELTA};
+    const uint8_t masks[4] = {0x00, 0x80, 0x08, 0x88};
+
+    const float * xbl = x + ibl*QK_K;
+    block_iq1_m * yb  = y + ibl;
+    const int64_t sb  = ibl % nsb_per_row;
+
+    float    scales[QK_K/16];
+    float    weight[16];
+    int8_t   L[16];
+    float    sval[16];
+    int      sidx[16];
+    uint16_t index[2];
+    int8_t   shifts[QK_K/16];
+    float    sumqx[4], sumq2[4];
+
+    for (int i = 0; i < QK_K/8;  ++i) { yb->qs[i]     = 0; }
+    for (int i = 0; i < QK_K/16; ++i) { yb->qh[i]     = 0; }
+    for (int i = 0; i < QK_K/32; ++i) { yb->scales[i] = 0; }
+
+    float max_scale = 0.0f;
+
+    float sumx2 = 0.0f;
+    for (int i = 0; i < QK_K; ++i) { sumx2 += xbl[i]*xbl[i]; }
+    const float sigma2 = 2.0f*sumx2/QK_K;
+
+    const float * xx;
+
+    for (int ib = 0; ib < QK_K/block_size; ++ib) {
+        const float * xb = xbl + block_size*ib;
+        if (quant_weights) {
+            const float * qw = quant_weights + QK_K*sb + block_size*ib;
+            for (int i = 0; i < block_size; ++i) { weight[i] = qw[i]*sqrtf(sigma2 + xb[i]*xb[i]); }
+        } else {
+            for (int i = 0; i < block_size; ++i) { weight[i] = xb[i]*xb[i]; }
+        }
+
+        float vmax = fabsf(xb[0]);
+        for (int i = 1; i < block_size; ++i) { vmax = fmaxf(vmax, fabsf(xb[i])); }
+        if (vmax < GROUP_MAX_EPS_IQ1_M) {
+            scales[ib] = 0.0f;
+            shifts[ib] = 0;
+            for (int i = 0; i < block_size; ++i) { L[i] = 1; }
+            continue;
+        }
+
+        for (int j = 0; j < block_size; ++j) { sval[j] = xb[j]; sidx[j] = j; }
+        iq1_sort_stable_cuda<16>(sval, sidx);
+
+        float best_score = -INFINITY;
+        float scale      = vmax;
+        int   besti1 = -1, besti2 = -1, best_k = -1;
+        // k: 0 = (+,+), 1 = (+,-), 2 = (-,+), 3 = (-,-)
+        // prefix sums per half of the block, since each half can take a different
+        // shift; mirrors the CPU form so the float rounding (and thus the choice) matches
+        float px[2][16+1];
+        float pw[2][16+1];
+        px[0][0] = px[1][0] = 0.0f;
+        pw[0][0] = pw[1][0] = 0.0f;
+        for (int j = 0; j < block_size; ++j) {
+            const int i = sidx[j];
+            const int h = i < block_size/2 ? 0 : 1;
+            px[h][j+1]   = px[h][j] + weight[i]*xb[i];
+            px[1-h][j+1] = px[1-h][j];
+            pw[h][j+1]   = pw[h][j] + weight[i];
+            pw[1-h][j+1] = pw[1-h][j];
+        }
+        const float txs[2] = {px[0][block_size], px[1][block_size]};
+        const float tws[2] = {pw[0][block_size], pw[1][block_size]};
+        const float p2  = x_p[2], m2 = x_m[2];
+        const float cp1 = x_p[0]*x_p[0] - x_p[1]*x_p[1];
+        const float cp2 = x_p[1]*x_p[1] - x_p[2]*x_p[2];
+        const float cm1 = x_m[0]*x_m[0] - x_m[1]*x_m[1];
+        const float cm2 = x_m[1]*x_m[1] - x_m[2]*x_m[2];
+        for (int i1 = 0; i1 <= block_size; ++i1) {
+            for (int i2 = i1; i2 <= block_size; ++i2) {
+                float qx_p[2], qx_m[2], q2_p[2], q2_m[2];
+                for (int h = 0; h < 2; ++h) {
+                    const float sx = px[h][i1] + px[h][i2];
+                    qx_p[h] = txs[h]*p2 - sx;
+                    qx_m[h] = txs[h]*m2 - sx;
+                    q2_p[h] = tws[h]*p2*p2 + pw[h][i1]*cp1 + pw[h][i2]*cp2;
+                    q2_m[h] = tws[h]*m2*m2 + pw[h][i1]*cm1 + pw[h][i2]*cm2;
+                }
+                sumqx[0] = qx_p[0] + qx_p[1];
+                sumqx[1] = qx_p[0] + qx_m[1];
+                sumqx[2] = qx_m[0] + qx_p[1];
+                sumqx[3] = qx_m[0] + qx_m[1];
+                sumq2[0] = q2_p[0] + q2_p[1];
+                sumq2[1] = q2_p[0] + q2_m[1];
+                sumq2[2] = q2_m[0] + q2_p[1];
+                sumq2[3] = q2_m[0] + q2_m[1];
+
+                for (int k = 0; k < 4; ++k) {
+                    if (sumq2[k] > 0.0f && sumqx[k]*sumqx[k] > best_score*sumq2[k]) {
+                        scale = sumqx[k]/sumq2[k];
+                        best_score = scale*sumqx[k];
+                        besti1 = i1; besti2 = i2; best_k = k;
+                    }
+                }
+            }
+        }
+
+        if (besti1 < 0 || besti2 < 0 || best_k < 0) {
+            scales[ib] = 0.0f;
+            shifts[ib] = 0;
+            for (int i = 0; i < block_size; ++i) { L[i] = 1; }
+            continue;
+        }
+
+        for (int j =      0; j < besti1;     ++j) { L[sidx[j]] = 0; }
+        for (int j = besti1; j < besti2;     ++j) { L[sidx[j]] = 1; }
+        for (int j = besti2; j < block_size; ++j) { L[sidx[j]] = 2; }
+
+        if (scale < 0.0f) {
+            for (int j = 0; j < block_size; ++j) { L[j] = 2 - L[j]; }
+            scale = -scale;
+            best_k = best_k == 0 ? 3 : best_k == 1 ? 2 : best_k == 2 ? 1 : 0;
+        }
+
+        bool all_on_grid = true;
+        for (int k = 0; k < block_size/8; ++k) {
+            xx = (k == 0) ? (best_k < 2 ? x_p : x_m) : (best_k%2 == 0 ? x_p : x_m);
+            uint16_t u = 0;
+            for (int j = 0; j < 8; ++j) { u |= (L[8*k + j] << 2*j); }
+            int grid_index = kmap[u];
+            if (grid_index < 0) {
+                all_on_grid = false;
+                const uint16_t * neighbours = kneigh - kmap[u] - 1;
+                grid_index = iq1_find_best_neighbour2_cuda(neighbours, kgrid, xb + 8*k, weight + 8*k, scale, xx, L + 8*k, NGRID_IQ1S);
+                if (grid_index < 0) { return; }
+            }
+            index[k] = grid_index;
+        }
+
+        if (!all_on_grid) {
+            float sumqx_f = 0.0f, sumq2_f = 0.0f;
+            for (int k = 0; k < block_size/8; ++k) {
+                xx = (k == 0) ? (best_k < 2 ? x_p : x_m) : (best_k%2 == 0 ? x_p : x_m);
+                const int8_t * pg = (const int8_t *) (kgrid + index[k]);
+                for (int j = 0; j < 8; ++j) {
+                    const float w = weight[8*k + j];
+                    const float q = xx[(pg[j] - 1)/2];
+                    sumqx_f += w*q*xb[8*k + j];
+                    sumq2_f += w*q*q;
+                }
+            }
+            if (sumqx_f > 0.0f && sumq2_f > 0.0f) { scale = sumqx_f/sumq2_f; }
+        }
+
+        yb->qs[2*ib + 0] = index[0] & 255;
+        yb->qs[2*ib + 1] = index[1] & 255;
+        yb->qh[ib]       = (index[0] >> 8) | ((index[1] >> 8) << 4);
+
+        scales[ib] = scale;
+        shifts[ib] = best_k;
+        max_scale  = fmaxf(max_scale, scale);
+    }
+
+    if (!max_scale) { return; }
+
+    uint16_t * sc = (uint16_t *) yb->scales;
+    float d  = max_scale/15;
+    const float id = 1.0f/d;
+    float sumqx_f = 0.0f, sumq2_f = 0.0f;
+    for (int ib = 0; ib < QK_K/block_size; ++ib) {
+        int l = nearest_int_cuda(0.5f*(id*scales[ib + 0] - 1));
+        l = max(0, min(7, l));
+        sc[ib/4]   |= (l << 3*(ib%4));
+        yb->qh[ib] |= masks[shifts[ib]];
+
+        const float * xb = xbl + block_size*ib;
+        if (quant_weights) {
+            const float * qw = quant_weights + QK_K*sb + block_size*ib;
+            for (int i = 0; i < block_size; ++i) { weight[i] = qw[i]*sqrtf(sigma2 + xb[i]*xb[i]); }
+        } else {
+            for (int i = 0; i < block_size; ++i) { weight[i] = xb[i]*xb[i]; }
+        }
+        for (int k = 0; k < block_size/8; ++k) {
+            xx = (k == 0) ? (shifts[ib] < 2 ? x_p : x_m) : (shifts[ib]%2 == 0 ? x_p : x_m);
+            const int8_t * pg = (const int8_t *) (kgrid + yb->qs[2*ib + k] + ((yb->qh[ib] << (8 - 4*k)) & 0x700));
+            for (int j = 0; j < 8; ++j) {
+                const float w = weight[8*k + j];
+                const float q = xx[(pg[j] - 1)/2]*(2*l + 1);
+                sumqx_f += w*q*xb[8*k + j];
+                sumq2_f += w*q*q;
+            }
+        }
+    }
+    if (sumq2_f > 0.0f) { d = sumqx_f/sumq2_f; }
+
+    const half     dh  = __float2half(d*1.1125f);   // fudge factor, as in the C
+    const uint16_t u16 = __half_as_ushort(dh);
+    sc[0] |= ((u16 & 0x000f) << 12);
+    sc[1] |= ((u16 & 0x00f0) <<  8);
+    sc[2] |= ((u16 & 0x0f00) <<  4);
+    sc[3] |= ((u16 & 0xf000) <<  0);
+}
+
+// ---------------------------------------------------------------- q4_1 / q5_0 / q5_1 / f16 / bf16
+
+// ggml-quants.c quantize_row_q4_1_ref()
+static __global__ void quantize_q4_1_ref_cuda_kernel(
+        const float * __restrict__ x, block_q4_1 * __restrict__ y, const int64_t nblocks) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nblocks) { return; }
+
+    const float * xb = x + i*QK4_1;
+
+    float vmin =  INFINITY;
+    float vmax = -INFINITY;
+    for (int j = 0; j < QK4_1; ++j) {
+        const float v = xb[j];
+        if (v < vmin) { vmin = v; }
+        if (v > vmax) { vmax = v; }
+    }
+
+    const float d  = (vmax - vmin)/((1 << 4) - 1);
+    const float id = d ? 1.0f/d : 0.0f;
+
+    y[i].dm = __halves2half2(__float2half(d), __float2half(vmin));
+
+    for (int j = 0; j < QK4_1/2; ++j) {
+        const float x0 = (xb[j]           - vmin)*id;
+        const float x1 = (xb[QK4_1/2 + j] - vmin)*id;
+        const int8_t t0 = (int8_t)(x0 + 0.5f);
+        const int8_t t1 = (int8_t)(x1 + 0.5f);
+        const uint8_t xi0 = t0 < 15 ? (uint8_t)t0 : 15;
+        const uint8_t xi1 = t1 < 15 ? (uint8_t)t1 : 15;
+        y[i].qs[j] = xi0 | (xi1 << 4);
+    }
+}
+
+// ggml-quants.c quantize_row_q4_1_impl(), one CUDA block per row
+static __global__ void quantize_q4_1_impl_cuda_kernel(
+        const float * __restrict__ x, block_q4_1 * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t n_per_row, const int64_t nb_per_row) {
+
+    const int64_t row = blockIdx.x;
+    const float * xr  = x + row*n_per_row;
+    block_q4_1 *  yr  = y + row*nb_per_row;
+
+    __shared__ float s_sigma2;
+    if (threadIdx.x == 0) { s_sigma2 = row_sum_sq_serial(xr, n_per_row)/(float) n_per_row; }
+    __syncthreads();
+    const float sigma2 = s_sigma2;
+
+    float   weight[QK4_1];
+    uint8_t L[QK4_1], Laux[QK4_1];
+
+    for (int64_t ib = threadIdx.x; ib < nb_per_row; ib += blockDim.x) {
+        const float * xb = xr + QK4_1*ib;
+        const float * qw = quant_weights + QK4_1*ib;
+        for (int j = 0; j < QK4_1; ++j) { weight[j] = qw[j]*sqrtf(sigma2 + xb[j]*xb[j]); }
+        float vmin;
+        const float d = make_qkx3_quants_cuda<QK4_1>(15, xb, weight, L, &vmin, Laux, -0.9f, 0.05f, 36, false);
+        yr[ib].dm = __halves2half2(__float2half(d), __float2half(-vmin));
+        for (int j = 0; j < 16; ++j) { yr[ib].qs[j] = L[j] | (L[j + 16] << 4); }
+    }
+}
+
+// ggml-quants.c quantize_row_q5_0_ref()
+static __global__ void quantize_q5_0_ref_cuda_kernel(
+        const float * __restrict__ x, block_q5_0 * __restrict__ y, const int64_t nblocks) {
+
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= nblocks) { return; }
+
+    const float * xb = x + i*QK5_0;
+
+    float amax = 0.0f, vmax = 0.0f;
+    for (int j = 0; j < QK5_0; ++j) {
+        const float v = xb[j];
+        if (amax < fabsf(v)) { amax = fabsf(v); vmax = v; }
+    }
+
+    const float d  = vmax/-16;
+    const float id = d ? 1.0f/d : 0.0f;
+    y[i].d = __float2half(d);
+
+    uint32_t qh = 0;
+    for (int j = 0; j < QK5_0/2; ++j) {
+        const float x0 = xb[j]           *id;
+        const float x1 = xb[QK5_0/2 + j] *id;
+        const int8_t t0 = (int8_t)(x0 + 16.5f);
+        const int8_t t1 = (int8_t)(x1 + 16.5f);
+        const uint8_t xi0 = t0 < 31 ? (uint8_t)t0 : 31;
+        const uint8_t xi1 = t1 < 31 ? (uint8_t)t1 : 31;
+        y[i].qs[j] = (xi0 & 0x0F) | ((xi1 & 0x0F) << 4);
+        qh |= ((xi0 & 0x10u) >> 4) << (j + 0);
+        qh |= ((xi1 & 0x10u) >> 4) << (j + QK5_0/2);
+    }
+    memcpy(&y[i].qh, &qh, sizeof(qh));
+}
+
+// ggml-quants.c quantize_row_q5_0_impl()
+static __global__ void quantize_q5_0_impl_cuda_kernel(
+        const float * __restrict__ x, block_q5_0 * __restrict__ y,
+        const float * __restrict__ quant_weights, const int64_t n_per_row, const int64_t nb_per_row) {
