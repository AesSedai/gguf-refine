+// plain conversions
+static __global__ void quantize_f16_cuda_kernel(const float * __restrict__ x, half * __restrict__ y, const int64_t n) {
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i < n) { y[i] = __float2half(x[i]); }
+}
+
+static __global__ void quantize_bf16_cuda_kernel(const float * __restrict__ x, uint16_t * __restrict__ y, const int64_t n) {
+    const int64_t i = blockIdx.x*(int64_t)blockDim.x + threadIdx.x;
+    if (i >= n) { return; }
+    // ggml_compute_fp32_to_bf16: round to nearest even, NaN forced quiet
+    const float    f = x[i];
+    const uint32_t u = __float_as_uint(f);
+    if ((u & 0x7fffffff) > 0x7f800000) { y[i] = (uint16_t) ((u >> 16) | 64); return; }
+    y[i] = (uint16_t) ((u + (0x7fff + ((u >> 16) & 1))) >> 16);
+}
