+// The IQ grids/maps/neighbour lists are built at runtime by iq2xs_init_impl /
+// iq3xs_init_impl. Expose them so a backend can mirror them onto its own device
+// instead of rebuilding them. Call ggml_quantize_init(type) first.
+const void * ggml_iq2_tables(enum ggml_type type, int * grid_size, int * map_size, int * nneighbours,
+                             const int ** map, const uint16_t ** neighbours) {
+    const int gindex = iq2_data_index(type);
+    if (grid_size)   { *grid_size   = iq2_grid_size(type); }
+    if (map_size)    { *map_size    = 43692; }
+    if (nneighbours) { *nneighbours = iq2_data[gindex].nneighbours; }
+    if (map)         { *map         = iq2_data[gindex].map; }
+    if (neighbours)  { *neighbours  = iq2_data[gindex].neighbours; }
+    return iq2_data[gindex].grid;
+}
+
+const void * ggml_iq3_tables(int grid_size_in, int * grid_size, int * map_size, int * nneighbours,
+                             const int ** map, const uint16_t ** neighbours) {
+    const int gindex = iq3_data_index(grid_size_in);
+    if (grid_size)   { *grid_size   = grid_size_in; }
+    if (map_size)    { *map_size    = 4096; }
+    if (nneighbours) { *nneighbours = iq3_data[gindex].nneighbours; }
+    if (map)         { *map         = iq3_data[gindex].map; }
+    if (neighbours)  { *neighbours  = iq3_data[gindex].neighbours; }
+    return iq3_data[gindex].grid;
+}
