+// --tokens-file: raw int32 token ids
+static std::vector<llama_token> read_tokens_file(const std::string & path) {
+    std::ifstream f(path, std::ios::binary | std::ios::ate);
+    if (!f) {
+        throw std::runtime_error("cannot open --tokens-file " + path);
+    }
+    const std::streamsize n = f.tellg();
+    if (n % (std::streamsize) sizeof(llama_token) != 0) {
+        throw std::runtime_error("--tokens-file " + path + ": size is not a multiple of 4");
+    }
+    std::vector<llama_token> tokens(n / sizeof(llama_token));
+    f.seekg(0);
+    f.read(reinterpret_cast<char *>(tokens.data()), n);
+    LOG_INF("%s: %zu tokens from %s\n", __func__, tokens.size(), path.c_str());
+    return tokens;
+}
