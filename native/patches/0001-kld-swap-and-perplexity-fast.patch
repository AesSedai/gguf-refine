+static std::string fmt(const char * f, ...) {
+    va_list ap;
+    va_start(ap, f);
+    char buf[4096];
+    vsnprintf(buf, sizeof(buf), f, ap);
+    va_end(ap);
+    return buf;
+}
+
+#define OUT(...) do { fprintf(stderr, __VA_ARGS__); fflush(stderr); } while (0)
