+//
+// file helpers
+//
+
+static void pread_all(int fd, void * dst, size_t n, size_t off, const std::string & what) {
+    uint8_t * p = (uint8_t *) dst;
+    while (n > 0) {
+        const size_t  want = std::min<size_t>(n, 1ull << 30);
+        const ssize_t got  = pread(fd, p, want, (off_t) off);
+        if (got < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            throw std::runtime_error(fmt("read error on %s at offset %zu: %s", what.c_str(), off, strerror(errno)));
+        }
+        if (got == 0) {
+            throw std::runtime_error(fmt("unexpected end of file in %s at offset %zu", what.c_str(), off));
+        }
+        p += got; n -= got; off += got;
+    }
+}
+
+static void read_file_range(const std::string & path, size_t off, size_t n, std::vector<uint8_t> & dst) {
+    const int fd = open(path.c_str(), O_RDONLY);
+    if (fd < 0) {
+        throw std::runtime_error(fmt("cannot open %s: %s", path.c_str(), strerror(errno)));
+    }
+    dst.resize(n);
+    try {
+        pread_all(fd, dst.data(), n, off, path);
+    } catch (...) {
+        close(fd);
+        throw;
+    }
+    close(fd);
+}
+
+static size_t file_size(const std::string & path) {
+    struct stat st;
+    if (stat(path.c_str(), &st) != 0) {
+        throw std::runtime_error(fmt("cannot stat %s: %s", path.c_str(), strerror(errno)));
+    }
+    return (size_t) st.st_size;
+}
+
+// 64-bit hash over the bytes, to check that saved originals are restored unchanged (not cryptographic)
+static uint64_t hash_bytes(const void * data, size_t n) {
+    const size_t n_thread = std::max<size_t>(1, std::min<size_t>(16, n >> 26));
+    const size_t chunk    = (n / n_thread) & ~size_t(7);
+    std::vector<uint64_t> part(n_thread);
+    auto work = [&](size_t it) {
+        const uint8_t * p   = (const uint8_t *) data + it*chunk;
+        const size_t    len = it + 1 == n_thread ? n - it*chunk : chunk;
+        uint64_t h = 0x9e3779b97f4a7c15ull ^ (len * 0xff51afd7ed558ccdull);
+        size_t i = 0;
+        for (; i + 8 <= len; i += 8) {
+            uint64_t w;
+            memcpy(&w, p + i, 8);
+            h = (h ^ w) * 0x100000001b3ull;
+            h ^= h >> 29;
+        }
+        for (; i < len; ++i) {
+            h = (h ^ p[i]) * 0x100000001b3ull;
+        }
+        part[it] = h;
+    };
+    std::vector<std::thread> th;
+    for (size_t it = 1; it < n_thread; ++it) {
+        th.emplace_back(work, it);
+    }
+    work(0);
+    for (auto & t : th) {
+        t.join();
+    }
+    uint64_t h = 0xcbf29ce484222325ull;
+    for (uint64_t x : part) {
+        h = (h ^ x) * 0x100000001b3ull;
+        h ^= h >> 31;
+    }
+    return h;
+}
+
+static std::string hex64(uint64_t h) {
+    return fmt("%016llx", (unsigned long long) h);
+}
+
+// true if [p, p+n) lies entirely in writable mappings of this process
+static bool host_range_writable(const void * p, size_t n, std::string & why) {
+#if defined(__linux__)
+    std::ifstream f("/proc/self/maps");
+    if (!f) {
+        why = "cannot read /proc/self/maps";
+        return false;
+    }
+    const uintptr_t a = (uintptr_t) p;
+    const uintptr_t b = a + n;
+    uintptr_t cur = a;
+    std::string line;
+    while (std::getline(f, line)) {
+        unsigned long lo = 0, hi = 0;
+        char perms[8] = {0};
+        if (sscanf(line.c_str(), "%lx-%lx %7s", &lo, &hi, perms) != 3) {
+            continue;
+        }
+        if (hi <= cur) {
+            continue;
+        }
+        if (lo > cur) {
+            why = "address range not fully mapped";
+            return false;
+        }
+        if (perms[1] != 'w') {
+            why = "read-only mapping: " + line;
+            return false;
+        }
+        cur = hi;
+        if (cur >= b) {
+            return true;
+        }
+    }
+    why = "address range not found in /proc/self/maps";
+    return false;
+#else
+    GGML_UNUSED(p); GGML_UNUSED(n);
+    why = "";
+    return true;
+#endif
+}
+
+//
+// GGUF index: where each tensor of the loaded model lives on disk
+//
+
+struct gguf_loc {
+    std::string path;
+    size_t      offset = 0; // absolute offset of the data in the file
+    size_t      nbytes = 0;
+    ggml_type   type   = GGML_TYPE_COUNT;
+    int64_t     ne[4]  = {1, 1, 1, 1};
+};
+
+static std::map<std::string, gguf_loc> gguf_index_file(const std::string & path) {
+    ggml_context * meta = nullptr;
+    gguf_init_params ip = { /*.no_alloc =*/ true, /*.ctx =*/ &meta };
+    gguf_context * g = gguf_init_from_file(path.c_str(), ip);
+    if (!g) {
+        throw std::runtime_error("failed to read GGUF " + path);
+    }
+    std::map<std::string, gguf_loc> res;
+    const size_t data_off = gguf_get_data_offset(g);
+    for (int64_t i = 0; i < gguf_get_n_tensors(g); ++i) {
+        gguf_loc l;
+        const char * name = gguf_get_tensor_name(g, i);
+        l.path   = path;
+        l.offset = data_off + gguf_get_tensor_offset(g, i);
+        l.nbytes = gguf_get_tensor_size(g, i);
+        l.type   = gguf_get_tensor_type(g, i);
+        if (const ggml_tensor * t = ggml_get_tensor(meta, name)) {
+            for (int d = 0; d < 4; ++d) {
+                l.ne[d] = t->ne[d];
+            }
+        }
+        res[name] = l;
+    }
+    gguf_free(g);
+    ggml_free(meta);
+    return res;
+}
+
+static std::map<std::string, gguf_loc> gguf_index_model(const std::string & path) {
+    std::map<std::string, gguf_loc> res = gguf_index_file(path);
+
+    int n_split = 1;
+    {
+        gguf_init_params ip = { /*.no_alloc =*/ true, /*.ctx =*/ nullptr };
+        gguf_context * g = gguf_init_from_file(path.c_str(), ip);
+        if (g) {
+            const int64_t k = gguf_find_key(g, "split.count");
+            if (k >= 0) {
+                n_split = gguf_get_val_u16(g, k);
+            }
+            gguf_free(g);
+        }
+    }
+    if (n_split > 1) {
+        char prefix[4096] = {0};
+        if (!llama_split_prefix(prefix, sizeof(prefix), path.c_str(), 0, n_split)) {
+            throw std::runtime_error("model is split in " + std::to_string(n_split) + " files, but " + path + " is not the first split");
+        }
+        for (int i = 1; i < n_split; ++i) {
+            char sp[4096] = {0};
+            llama_split_path(sp, sizeof(sp), prefix, i, n_split);
+            for (auto & [k, v] : gguf_index_file(sp)) {
+                res[k] = v;
+            }
+        }
+    }
+    return res;
+}
+
+//
+// tensor placement
+//
+
+enum class placement {
+    DEVICE,     // device buffer, read and written with ggml_backend_tensor_get/set
+    HOST,       // writable host memory (CPU or pinned buffer)
+    HOST_RO,    // host memory in a read-only mapping (mmap of the model file): refused
+    EXTRA,      // CPU extra buffer type (REPACK, AMX, ...): stored in a different layout, set_tensor converts, no get_tensor
+    NO_BUFFER,  // not allocated: refused
+};
+
+static const char * placement_name(placement p) {
+    switch (p) {
+        case placement::DEVICE:    return "device";
+        case placement::HOST:      return "host";
+        case placement::HOST_RO:   return "host-readonly-mmap";
+        case placement::EXTRA:     return "cpu-extra-repacked";
+        case placement::NO_BUFFER: return "no-buffer";
+    }
+    return "?";
+}
+
+static std::set<ggml_backend_buffer_type_t> collect_extra_bufts() {
+    std::set<ggml_backend_buffer_type_t> res;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+        auto fn = (ggml_backend_dev_get_extra_bufts_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_dev_get_extra_bufts");
+        if (!fn) {
+            continue;
+        }
+        for (ggml_backend_buffer_type_t * b = fn(dev); b && *b; ++b) {
+            res.insert(*b);
+        }
+    }
+    return res;
+}
+
+static placement classify(const ggml_tensor * t, const std::set<ggml_backend_buffer_type_t> & extra, std::string & why) {
+    why.clear();
+    if (!t->buffer || !t->data) {
+        why = "tensor has no buffer";
+        return placement::NO_BUFFER;
+    }
+    if (t->view_src) {
+        why = "tensor is a view";
+        return placement::NO_BUFFER;
+    }
+    ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(t->buffer);
+    if (extra.count(buft)) {
+        return placement::EXTRA;
+    }
+    if (ggml_backend_buffer_is_host(t->buffer)) {
+        if (!host_range_writable(t->data, ggml_nbytes(t), why)) {
+            return placement::HOST_RO;
+        }
+        return placement::HOST;
+    }
+    return placement::DEVICE;
+}
+
+//
+// KLD base logits file (llama-perplexity --kl-divergence-base format)
+//
+
+struct base_logits {
+    std::string path;
+    int         fd = -1;
+    uint32_t    n_ctx   = 0;
+    int         n_vocab = 0;
+    int         n_chunk = 0;
+    int         nv      = 0;
+    size_t      n_tok_chunk = 0; // scored tokens per chunk: n_ctx - 1 - n_ctx/2
+    size_t      data_off  = 0;
+    size_t      rec_bytes = 0;
+    std::vector<llama_token> tokens;
+
+    ~base_logits() {
+        if (fd >= 0) {
+            close(fd);
+        }
+    }
+
+    void open_file(const std::string & p) {
+        path = p;
+        fd = open(p.c_str(), O_RDONLY);
+        if (fd < 0) {
+            throw std::runtime_error(fmt("cannot open %s: %s", p.c_str(), strerror(errno)));
+        }
+        char magic[8];
+        pread_all(fd, magic, 8, 0, p);
+        if (strncmp(magic, "_logits_", 8) != 0) {
+            throw std::runtime_error(p + " does not look like a file containing log-probabilities");
+        }
+        int32_t hdr[3];
+        pread_all(fd, hdr, sizeof(hdr), 8, p);
+        n_ctx   = (uint32_t) hdr[0];
+        n_vocab = hdr[1];
+        n_chunk = hdr[2];
+        if (n_ctx < 4 || n_vocab <= 0 || n_chunk <= 0) {
+            throw std::runtime_error(fmt("bad header in %s: n_ctx=%u n_vocab=%d n_chunk=%d", p.c_str(), n_ctx, n_vocab, n_chunk));
+        }
+        nv          = 2*((n_vocab + 1)/2) + 4;
+        n_tok_chunk = n_ctx - 1 - n_ctx/2;
+        tokens.resize(size_t(n_ctx) * n_chunk);
+        pread_all(fd, tokens.data(), tokens.size()*sizeof(llama_token), 20, p);
+        data_off  = 20 + tokens.size()*sizeof(llama_token);
+        rec_bytes = n_tok_chunk * nv * sizeof(uint16_t);
+        const size_t need = data_off + size_t(n_chunk)*rec_bytes;
+        const size_t have = file_size(p);
+        if (have < need) {
+            throw std::runtime_error(fmt("%s is truncated: %zu bytes, the header implies %zu", p.c_str(), have, need));
+        }
+        if (have > need) {
+            OUT("kld-swap: warning: %s has %zu trailing bytes beyond the %d chunks of its header\n", p.c_str(), have - need, n_chunk);
+        }
+    }
+
+    void read_chunk(int c, uint16_t * dst) const {
+        pread_all(fd, dst, rec_bytes, data_off + size_t(c)*rec_bytes, path);
+    }
+};
+
+//
+// KLD statistics, as in tools/perplexity/perplexity.cpp
+//
+
+struct kld_sums {
+    double sum_nll          = 0.0;
+    double sum_nll2         = 0.0;
+    double sum_nll_base     = 0.0;
+    double sum_nll_base2    = 0.0;
+    double sum_nll_nll_base = 0.0;
+    double sum_kld          = 0.0;
+    double sum_kld2         = 0.0;
+    double sum_p_diff       = 0.0;
+    double sum_p_diff2      = 0.0;
+    double sum_p_diff4      = 0.0;
+    float  max_p_diff       = 0.0f;
+    size_t n_same_top       = 0;
+    size_t count            = 0;
+
+    void add(const kld_sums & o) {
+        sum_nll          += o.sum_nll;
+        sum_nll2         += o.sum_nll2;
+        sum_nll_base     += o.sum_nll_base;
+        sum_nll_base2    += o.sum_nll_base2;
+        sum_nll_nll_base += o.sum_nll_nll_base;
+        sum_kld          += o.sum_kld;
+        sum_kld2         += o.sum_kld2;
+        sum_p_diff       += o.sum_p_diff;
+        sum_p_diff2      += o.sum_p_diff2;
+        sum_p_diff4      += o.sum_p_diff4;
+        n_same_top       += o.n_same_top;
+        max_p_diff        = std::max(max_p_diff, o.max_p_diff);
+        count            += o.count;
+    }
+};
+
+struct token_stat {
+    float   kld;
+    float   p_diff;
+    float   nll;
+    float   nll_base;
+    uint8_t same_top;
+};
+
+// identical arithmetic to log_softmax(..., kl_divergence_result &) in perplexity.cpp
+static token_stat kld_token(int n_vocab, const float * logits, const uint16_t * base_log_prob, int tok, kld_sums & kld) {
+    float max_logit = logits[0];
+    int imax = 0;
+    for (int i = 1; i < n_vocab; ++i) {
+        if (logits[i] > max_logit) {
+            max_logit = logits[i];
+            imax = i;
+        }
+    }
+    double sum_exp = 0.0;
+    for (int i = 0; i < n_vocab; ++i) {
+        sum_exp += expf(logits[i] - max_logit);
+    }
+    const float log_sum_exp = log(sum_exp);
+    const float * d = (const float *)base_log_prob;
+    const float scale = d[0];
+    const float min_log_prob = d[1];
+    base_log_prob += 4;
+
+    const float nll = max_logit + log_sum_exp - logits[tok];
+    kld.sum_nll  += nll;
+    kld.sum_nll2 += nll*nll;
+
+    const float nll_base = -(scale*base_log_prob[tok] + min_log_prob);
+    kld.sum_nll_base  += nll_base;
+    kld.sum_nll_base2 += nll_base*nll_base;
+
+    kld.sum_nll_nll_base += nll*nll_base;
+
+    max_logit += log_sum_exp;
+    double sum = 0;
+    int imax_base = -1;
+    float p_log_base_max = 0;
+    for (int i = 0; i < n_vocab; ++i) {
+        const float p_log_base = scale*base_log_prob[i] + min_log_prob;
+        if (i == 0 || p_log_base > p_log_base_max) {
+            p_log_base_max = p_log_base;
+            imax_base = i;
+        }
+        if (p_log_base > -16.f) {
+            const float p_base = expf(p_log_base);
+            sum += p_base * (p_log_base - logits[i] + max_logit);
+        }
+    }
+    kld.sum_kld  += sum;
+    kld.sum_kld2 += sum*sum;
+    ++kld.count;
+    const bool same_top = imax == imax_base;
+    if (same_top) {
+        ++kld.n_same_top;
+    }
+
+    const float p_base = expf(-nll_base);
+    const float p = expf(-nll);
+    const float p_diff = p - p_base;
+    kld.sum_p_diff  += p_diff;
+    const double p_diff2 = p_diff*p_diff;
+    kld.sum_p_diff2 += p_diff2;
+    kld.sum_p_diff4 += p_diff2*p_diff2;
+    kld.max_p_diff = std::max(kld.max_p_diff, std::fabs(p_diff));
+
+    return { (float) sum, p_diff, nll, nll_base, (uint8_t) same_top };
+}
+
+static void kld_chunk(int n_vocab, int nv, const float * logits, const llama_token * tokens, int n_token,
+        std::vector<std::thread> & workers, const uint16_t * base_log_probs, kld_sums & kld, token_stat * out) {
+    std::mutex mutex;
+    int counter = 0;
+    auto compute = [&]() {
+        kld_sums local;
+        while (true) {
+            std::unique_lock<std::mutex> lock(mutex);
+            int i = counter++;
+            if (i >= n_token) {
+                kld.add(local);
+                break;
+            }
+            lock.unlock();
+            out[i] = kld_token(n_vocab, logits + size_t(i)*n_vocab, base_log_probs + size_t(i)*nv, tokens[i+1], local);
+        }
+    };
+    for (auto & w : workers) {
+        w = std::thread(compute);
+    }
+    compute();
+    for (auto & w : workers) {
+        w.join();
+    }
+}
+
+static std::pair<double, double> mean_and_uncertainty(double sum, double sum2, size_t count) {
+    if (count < 1) {
+        return std::make_pair(0., 0.);
+    }
+    double f = sum/count;
+    double df = sum2/count - f*f;
+    df = df > 0 && count > 10 ? sqrt(df/(count-1)) : 0.;
+    return std::make_pair(f, df);
+}
+
+static double covariance(double suma, double sumb, double sumab, size_t count) {
+    if (count < 10) {
+        return 0.0;
+    }
+    double var = sumab/count - (suma/count)*(sumb/count);
+    var /= count - 1;
+    return var;
+}
+
+static float percentile(const std::vector<float> & values, float fraction) {
+    if (fraction <= 0) return values.front();
+    if (fraction >= 1) return values.back();
+    float p = fraction*(values.size() - 1);
+    size_t ip = size_t(p); p -= ip;
+    return (1 - p)*values[ip] + p*values[std::min(ip+1, values.size()-1)];
+}
+
+static float median_sorted(const std::vector<float> & v) {
+    return v.size()%2 == 0 ? 0.5f*(v[v.size()/2] + v[v.size()/2-1]) : v[v.size()/2];
+}
+
+// prints the summary in the llama-perplexity format and returns it as json
+static json summarize(const kld_sums & kld, std::vector<float> kld_values, std::vector<float> p_diff_values) {
+    json j;
+    j["n_tokens"] = kld.count;
+    if (kld.count < 2) {
+        return j;
+    }
+    std::sort(kld_values.begin(), kld_values.end());
+    std::sort(p_diff_values.begin(), p_diff_values.end());
+
+    OUT("====== Perplexity statistics ======\n");
+    auto log_ppl = mean_and_uncertainty(kld.sum_nll, kld.sum_nll2, kld.count);
+    const double ppl_val = exp(log_ppl.first);
+    const double ppl_unc = ppl_val * log_ppl.second;
+    OUT("Mean PPL(Q)                   : %10.6lf ± %10.6lf\n", ppl_val, ppl_unc);
+
+    auto log_ppl_base = mean_and_uncertainty(kld.sum_nll_base, kld.sum_nll_base2, kld.count);
+    const double ppl_base_val = exp(log_ppl_base.first);
+    const double ppl_base_unc = ppl_base_val * log_ppl_base.second;
+    OUT("Mean PPL(base)                : %10.6lf ± %10.6lf\n", ppl_base_val, ppl_base_unc);
+
+    const double log_ppl_cov = covariance(kld.sum_nll, kld.sum_nll_base, kld.sum_nll_nll_base, kld.count);
+    const double log_ppl_cor = log_ppl_cov / (log_ppl.second*log_ppl_base.second);
+    OUT("Cor(ln(PPL(Q)), ln(PPL(base))): %6.2lf%%\n", 100.0*log_ppl_cor);
+
+    const double log_ppl_ratio_val = log_ppl.first - log_ppl_base.first;
+    const double log_ppl_ratio_unc = sqrt(log_ppl.second*log_ppl.second + log_ppl_base.second*log_ppl_base.second - 2.0*log_ppl_cov);
+    OUT("Mean ln(PPL(Q)/PPL(base))     : %10.6lf ± %10.6lf\n", log_ppl_ratio_val, log_ppl_ratio_unc);
+
+    const double ppl_ratio_val = exp(log_ppl_ratio_val);
+    const double ppl_ratio_unc = ppl_ratio_val * log_ppl_ratio_unc;
+    OUT("Mean PPL(Q)/PPL(base)         : %10.6lf ± %10.6lf\n", ppl_ratio_val, ppl_ratio_unc);
+
+    const double ppl_cov = ppl_val * ppl_base_val * log_ppl_cov;
+    const double ppl_diff_val = ppl_val - ppl_base_val;
+    const double ppl_diff_unc = sqrt(ppl_unc*ppl_unc + ppl_base_unc*ppl_base_unc - 2.0*ppl_cov);
+    OUT("Mean PPL(Q)-PPL(base)         : %10.6lf ± %10.6lf\n", ppl_diff_val, ppl_diff_unc);
+    OUT("\n");
+
+    OUT("====== KL divergence statistics ======\n");
+    auto kl_div = mean_and_uncertainty(kld.sum_kld, kld.sum_kld2, kld.count);
+    OUT("Mean    KLD: %10.6lf ± %10.6lf\n", kl_div.first, kl_div.second);
+    const float kld_median = median_sorted(kld_values);
+    OUT("Maximum KLD: %10.6f\n", kld_values.back());
+    OUT("99.9%%   KLD: %10.6f\n", percentile(kld_values, 0.999f));
+    OUT("99.0%%   KLD: %10.6f\n", percentile(kld_values, 0.990f));
+    OUT("95.0%%   KLD: %10.6f\n", percentile(kld_values, 0.950f));
+    OUT("90.0%%   KLD: %10.6f\n", percentile(kld_values, 0.900f));
+    OUT("Median  KLD: %10.6f\n", kld_median);
+    OUT("10.0%%   KLD: %10.6f\n", percentile(kld_values, 0.100f));
+    OUT(" 5.0%%   KLD: %10.6f\n", percentile(kld_values, 0.050f));
+    OUT(" 1.0%%   KLD: %10.6f\n", percentile(kld_values, 0.010f));
+    OUT(" 0.1%%   KLD: %10.6f\n", percentile(kld_values, 0.001f));
+    OUT("Minimum KLD: %10.6f\n", kld_values.front());
+    OUT("\n");
+
+    OUT("====== Token probability statistics ======\n");
+    auto p_diff = mean_and_uncertainty(kld.sum_p_diff, kld.sum_p_diff2, kld.count);
+    OUT("Mean    Δp: %6.3lf ± %5.3lf %%\n",  100.0*p_diff.first, 100.0*p_diff.second);
+    const float p_diff_median = median_sorted(p_diff_values);
+    OUT("Maximum Δp: %6.3lf%%\n",  100.0*p_diff_values.back());
+    OUT("99.9%%   Δp: %6.3lf%%\n", 100.0*percentile(p_diff_values, 0.999f));
+    OUT("99.0%%   Δp: %6.3lf%%\n", 100.0*percentile(p_diff_values, 0.990f));
+    OUT("95.0%%   Δp: %6.3lf%%\n", 100.0*percentile(p_diff_values, 0.950f));
+    OUT("90.0%%   Δp: %6.3lf%%\n", 100.0*percentile(p_diff_values, 0.900f));
+    OUT("75.0%%   Δp: %6.3lf%%\n", 100.0*percentile(p_diff_values, 0.750f));
+    OUT("Median  Δp: %6.3lf%%\n",  100.0*p_diff_median);
+    OUT("25.0%%   Δp: %6.3lf%%\n", 100.0*percentile(p_diff_values, 0.250f));
+    OUT("10.0%%   Δp: %6.3lf%%\n", 100.0*percentile(p_diff_values, 0.100f));
+    OUT(" 5.0%%   Δp: %6.3lf%%\n", 100.0*percentile(p_diff_values, 0.050f));
+    OUT(" 1.0%%   Δp: %6.3lf%%\n", 100.0*percentile(p_diff_values, 0.010f));
+    OUT(" 0.1%%   Δp: %6.3lf%%\n", 100.0*percentile(p_diff_values, 0.001f));
+    OUT("Minimum Δp: %6.3lf%%\n",  100.0*p_diff_values.front());
+
+    auto p_diff_mse = mean_and_uncertainty(kld.sum_p_diff2, kld.sum_p_diff4, kld.count);
+    const double p_diff_rms_val = sqrt(p_diff_mse.first);
+    const double p_diff_rms_unc = 0.5/p_diff_rms_val * p_diff_mse.second;
+    OUT("RMS Δp    : %6.3lf ± %5.3lf %%\n", 100.0*p_diff_rms_val, 100.0*p_diff_rms_unc);
+
+    const double same_top_p = 1.0*kld.n_same_top/kld.count;
+    const double same_top_unc = sqrt(same_top_p*(1.0 - same_top_p)/(kld.count - 1));
+    OUT("Same top p: %6.3lf ± %5.3lf %%\n", 100.0*same_top_p, 100.0*same_top_unc);
+    OUT("\n");
+
+    j["ppl_q"]              = ppl_val;
+    j["ppl_q_unc"]          = ppl_unc;
+    j["ppl_base"]           = ppl_base_val;
+    j["ppl_base_unc"]       = ppl_base_unc;
+    j["ln_ppl_ratio"]       = log_ppl_ratio_val;
+    j["ln_ppl_ratio_unc"]   = log_ppl_ratio_unc;
+    j["kld_mean"]           = kl_div.first;
+    j["kld_mean_unc"]       = kl_div.second;
+    j["kld_median"]         = kld_median;
+    j["kld_p90"]            = percentile(kld_values, 0.900f);
+    j["kld_p95"]            = percentile(kld_values, 0.950f);
+    j["kld_p99"]            = percentile(kld_values, 0.990f);
+    j["kld_p999"]           = percentile(kld_values, 0.999f);
+    j["kld_max"]            = kld_values.back();
+    j["kld_min"]            = kld_values.front();
+    j["dp_mean"]            = p_diff.first;
+    j["dp_mean_unc"]        = p_diff.second;
+    j["dp_rms"]             = p_diff_rms_val;
+    j["dp_rms_unc"]         = p_diff_rms_unc;
+    j["dp_max_abs"]         = kld.max_p_diff;
+    j["same_top"]           = same_top_p;
+    j["same_top_unc"]       = same_top_unc;
+    return j;
+}
+
+//
+// state
+//
+
+enum class orig_mode { RAM, SPILL, GGUF };
+
+// References to owners in the model's buffer vectors. Those vectors move into the model after allocation.
+using expert_buffers = std::map<ggml_tensor *, ggml_backend_buffer_ptr *>;
+
+static bool alloc_expert_buffers(ggml_context * ctx, ggml_backend_buffer_type_t buft,
+        std::vector<ggml_backend_buffer_ptr> & buffers, expert_buffers & owners) {
+    auto * dev = ggml_backend_buft_get_device(buft);
+    if (!dev || buft != ggml_backend_dev_buffer_type(dev) ||
+            strcmp(ggml_backend_reg_name(ggml_backend_dev_backend_reg(dev)), "CUDA") != 0) {
+        return false;
+    }
+    static const std::regex expert(R"(blk\.[0-9]+\.ffn_(gate|up|down)_exps\.weight)");
+    std::vector<ggml_tensor *> experts, other;
+    for (auto * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+        if (t->view_src || t->data) {
+            return false;
+        }
+        (std::regex_match(t->name, expert) ? experts : other).push_back(t);
+    }
+    if (experts.empty()) {
+        return false;
+    }
+    buffers.reserve(experts.size() + 1);
+    auto allocate = [&](ggml_tensor ** ts, int count) {
+        buffers.emplace_back(ggml_backend_buft_alloc_buffer_n(buft, ts, count));
+        if (!buffers.back()) {
+            throw std::runtime_error(fmt("cannot allocate %s weight buffer for %s", ggml_backend_buft_name(buft), ts[0]->name));
+        }
+    };
+    if (!other.empty()) {
+        allocate(other.data(), other.size());
+    }
+    for (auto * t : experts) {
+        allocate(&t, 1);
+        owners[t] = &buffers.back();
+    }
+    return true;
+}
+
+// one instance of a retyped tensor: where the loader put it, and the buffer retype allocated when the new type did not fit
+struct retype_inst {
+    ggml_tensor *         t           = nullptr;
+    ggml_type             orig_type   = GGML_TYPE_COUNT;
+    size_t                orig_nb[GGML_MAX_DIMS] = {0};
+    void *                orig_data   = nullptr;
+    ggml_backend_buffer_t orig_buffer = nullptr;
+    size_t                orig_cap    = 0;       // bytes the model buffer reserved for the tensor (alloc size of the original type)
+    ggml_backend_buffer_t own         = nullptr; // allocated by retype, freed on revert; the tensor lives here when set
+    bool                  dedicated   = false;
+    bool                  dirty       = false;   // the original slot holds bytes other than the originals
+};
+
+struct patch_entry {
+    std::string                 name;
+    std::vector<ggml_tensor *>  inst;        // every model tensor carrying this name (e.g. tied embeddings)
+    size_t                      nbytes = 0;
+    orig_mode                   mode = orig_mode::RAM;
+    std::vector<uint8_t>        orig;        // RAM mode
+    std::string                 spill_path;  // SPILL mode
+    uint64_t                    orig_hash = 0;
+    uint64_t                    cur_hash  = 0;
+    std::string                 source;      // what the current bytes came from
+    std::vector<retype_inst>    rt;          // non-empty once the tensor was retyped
+};
+
+struct swap_state {
+    expert_buffers experts;
+    llama_context * ctx   = nullptr;
+    llama_model   * model = nullptr;
+    common_params * params = nullptr;
+
+    std::map<std::string, gguf_loc> index;
+    std::multimap<std::string, ggml_tensor *> tensors;
+    std::set<ggml_backend_buffer_type_t> extra_bufts;
+    std::set<ggml_backend_buffer_type_t> plain_bufts; // default and host buffer types of the devices: the placements retype handles
+
+    std::unique_ptr<base_logits> base;
+    std::map<std::string, patch_entry> patched;
+
+    orig_mode   omode = orig_mode::RAM;
+    std::string spill_dir;
+    bool        check_gguf = false;
+
+    std::vector<ggml_tensor *> find(const std::string & name) const {
+        std::vector<ggml_tensor *> res;
+        auto range = tensors.equal_range(name);
+        for (auto it = range.first; it != range.second; ++it) {
+            res.push_back(it->second);
+        }
+        return res;
+    }
+};
+
+using args_t = std::map<std::string, std::string>;
+
+static std::string arg_req(const args_t & a, const std::string & k) {
+    auto it = a.find(k);
+    if (it == a.end() || it->second.empty()) {
+        throw std::runtime_error("missing argument '" + k + "'");
+    }
+    return it->second;
+}
+
+static std::string arg_opt(const args_t & a, const std::string & k, const std::string & def = "") {
+    auto it = a.find(k);
+    return it == a.end() ? def : it->second;
+}
+
+static json tensor_info(const swap_state & st, const std::string & name) {
+    auto inst = st.find(name);
+    if (inst.empty()) {
+        throw std::runtime_error("no tensor named '" + name + "' in the model");
+    }
+    json j;
+    j["name"] = name;
+    j["type"] = ggml_type_name(inst[0]->type);
+    j["nbytes"] = ggml_nbytes(inst[0]);
+    j["ne"] = { inst[0]->ne[0], inst[0]->ne[1], inst[0]->ne[2], inst[0]->ne[3] };
+    json ji = json::array();
+    for (auto * t : inst) {
+        std::string why;
+        placement p = classify(t, st.extra_bufts, why);
+        json e;
+        e["buffer_type"] = t->buffer ? ggml_backend_buft_name(ggml_backend_buffer_get_type(t->buffer)) : "none";
+        e["placement"] = placement_name(p);
+        e["patchable"] = p == placement::DEVICE || p == placement::HOST || p == placement::EXTRA;
+        if (!why.empty()) {
+            e["why"] = why;
+        }
+        ji.push_back(e);
+    }
+    j["instances"] = ji;
+    auto it = st.index.find(name);
+    if (it != st.index.end()) {
+        j["gguf_file"] = it->second.path;
+        j["gguf_offset"] = it->second.offset;
+        j["gguf_type"] = ggml_type_name(it->second.type);
+    }
+    j["patched"] = st.patched.count(name) > 0;
+    auto pit = st.patched.find(name);
+    if (pit != st.patched.end() && !pit->second.rt.empty()) {
+        j["retyped"]   = true;
+        j["orig_type"] = ggml_type_name(pit->second.rt[0].orig_type);
+    }
+    return j;
+}
+
+static bool is_retyped(const swap_state & st, const std::string & name) {
+    auto it = st.patched.find(name);
+    return it != st.patched.end() && !it->second.rt.empty();
+}
+
+// check a tensor and all its instances can be patched, throws otherwise
+static void check_patchable(const swap_state & st, const std::string & name, const std::vector<ggml_tensor *> & inst) {
+    if (inst.empty()) {
+        throw std::runtime_error("no tensor named '" + name + "' in the model");
+    }
+    if (is_retyped(st, name)) {
+        throw std::runtime_error(name + " is retyped to " + ggml_type_name(inst[0]->type) + ": change its bytes with retype, or revert it first");
+    }
+    for (auto * t : inst) {
+        if (t->type != inst[0]->type || ggml_nbytes(t) != ggml_nbytes(inst[0])) {
+            throw std::runtime_error(name + ": instances differ in type or size");
+        }
+        std::string why;
+        placement p = classify(t, st.extra_bufts, why);
+        if (p == placement::HOST_RO) {
+            throw std::runtime_error(name + " is in a read-only file mapping (" + why + "): restart with -lm none or -lm dio (not mmap / dio+map) to make host tensors writable");
+        }
+        if (p == placement::NO_BUFFER) {
+            throw std::runtime_error(name + ": " + why);
+        }
+    }
+    auto it = st.index.find(name);
+    if (it == st.index.end()) {
+        throw std::runtime_error(name + ": not found in the model GGUF");
+    }
+    if (it->second.type != inst[0]->type || it->second.nbytes != ggml_nbytes(inst[0])) {
+        throw std::runtime_error(fmt("%s: the loaded tensor (%s, %zu bytes) differs from the GGUF (%s, %zu bytes): the loader converted it",
+                name.c_str(), ggml_type_name(inst[0]->type), ggml_nbytes(inst[0]), ggml_type_name(it->second.type), it->second.nbytes));
+    }
+}
+
+static bool readable(const swap_state & st, const ggml_tensor * t) {
+    std::string why;
+    return classify(t, st.extra_bufts, why) != placement::EXTRA;
+}
+
+// write bytes into every instance and read back the ones that can be read
+static void write_tensor(swap_state & st, const std::vector<ggml_tensor *> & inst, const std::vector<uint8_t> & data, const std::string & name) {
+    std::vector<uint8_t> back;
+    for (auto * t : inst) {
+        GGML_ASSERT(data.size() == ggml_nbytes(t));
+        ggml_backend_tensor_set(t, data.data(), 0, data.size());
+        if (readable(st, t)) {
+            back.resize(data.size());
+            ggml_backend_tensor_get(t, back.data(), 0, back.size());
+            if (memcmp(back.data(), data.data(), data.size()) != 0) {
+                throw std::runtime_error(name + ": read-back after write does not match the written bytes (" +
+                        ggml_backend_buft_name(ggml_backend_buffer_get_type(t->buffer)) + ")");
+            }
+        }
+    }
+}
+
+static void get_gguf_bytes(const swap_state & st, const std::string & name, std::vector<uint8_t> & dst) {
+    const gguf_loc & l = st.index.at(name);
+    read_file_range(l.path, l.offset, l.nbytes, dst);
+}
+
+// the bytes the model holds now: from a readable instance, or from the GGUF if every instance is repacked
+static void get_live_bytes(swap_state & st, const std::vector<ggml_tensor *> & inst, const std::string & name, std::vector<uint8_t> & dst, bool & from_gguf) {
+    for (auto * t : inst) {
+        if (readable(st, t)) {
+            dst.resize(ggml_nbytes(t));
+            ggml_backend_tensor_get(t, dst.data(), 0, dst.size());
+            from_gguf = false;
+            return;
+        }
+    }
+    get_gguf_bytes(st, name, dst);
+    from_gguf = true;
+}
+
+//
+// retype helpers
+//
+
+// contiguous strides of `type` for the tensor's shape
+static void set_type_nb(ggml_tensor * t, ggml_type type) {
+    t->type  = type;
+    t->nb[0] = ggml_type_size(type);
+    t->nb[1] = t->nb[0]*(t->ne[0]/ggml_blck_size(type));
+    for (int i = 2; i < GGML_MAX_DIMS; ++i) {
+        t->nb[i] = t->nb[i - 1]*t->ne[i - 1];
+    }
+}
+
+static void restore_inst(retype_inst & r) {
+    r.t->type   = r.orig_type;
+    r.t->data   = r.orig_data;
+    r.t->buffer = r.orig_buffer;
+    memcpy(r.t->nb, r.orig_nb, sizeof(r.orig_nb));
+}
+
+// Publish only after the replacement passes read-back. Allocation or verification failure leaves the live tensor intact.
+static void replace_expert(swap_state & st, ggml_tensor * t, ggml_type type, const std::vector<uint8_t> & bytes) {
+    auto & owner = *st.experts.at(t);
+    GGML_ASSERT(owner.get() == t->buffer);
+    auto * buft = ggml_backend_buffer_get_type(t->buffer);
+    ggml_tensor next = *t;
+    set_type_nb(&next, type);
+    next.buffer = nullptr;
+    next.data = nullptr;
+    ggml_tensor * ptr = &next;
+    ggml_backend_buffer_ptr buf(ggml_backend_buft_alloc_buffer_n(buft, &ptr, 1));
+    if (!buf) {
+        throw std::runtime_error(fmt("cannot allocate %zu bytes on %s for %s", ggml_backend_buft_get_alloc_size(buft, &next), ggml_backend_buft_name(buft), t->name));
+    }
+    ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    write_tensor(st, {&next}, bytes, t->name);
+    *t = next;
+    owner = std::move(buf);
+}
+
+// Graphs built for the old type, strides or data pointer of a weight must not run again: llama reuses the previous graph
+// when the ubatch shape is unchanged, and a reused graph keeps its scheduler split ids, so ggml-cuda replays its captured
+// CUDA graph without comparing node properties. Toggling the embeddings flag makes the next decode re-reserve, which
+// drops the reusable graphs; the rebuilt graph gets new split ids, and the CUDA backend compares the node sources
+// (including their type) against the captured graph.
+static void invalidate_graphs(swap_state & st) {
+    llama_set_embeddings(st.ctx, !st.params->embedding);
+    llama_set_embeddings(st.ctx, st.params->embedding);
+}
+
+static ggml_type parse_type(const std::string & s) {
+    std::string want = s;
+    std::transform(want.begin(), want.end(), want.begin(), ::tolower);
+    for (int i = 0; i < GGML_TYPE_COUNT; ++i) {
+        const char * n = ggml_type_name((ggml_type) i);
+        if (!n || ggml_blck_size((ggml_type) i) == 0 || ggml_type_size((ggml_type) i) == 0) {
+            continue;
+        }
+        std::string have = n;
+        std::transform(have.begin(), have.end(), have.begin(), ::tolower);
+        if (have == want) {
+            return (ggml_type) i;
+        }
+    }
+    throw std::runtime_error("unknown ggml type '" + s + "'");
+}
+
+// device (or host) the tensor's op runs on, for the supports_op check
+static ggml_backend_dev_t inst_device(const retype_inst & r) {
+    if (ggml_backend_buffer_is_host(r.t->buffer)) {
+        return ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    }
+    return ggml_backend_buft_get_device(ggml_backend_buffer_get_type(r.t->buffer));
+}
+
+static std::string inst_dev_name(const retype_inst & r) {
+    ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(r.t->buffer);
+    if (ggml_backend_buffer_is_host(r.t->buffer)) {
+        return ggml_backend_buft_name(buft);
+    }
+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+    return dev ? ggml_backend_dev_name(dev) : ggml_backend_buft_name(buft);
+}
+
+// alloc size of the tensor as `type` in the buffer type of its original placement (includes the CUDA row padding)
+static size_t alloc_size_as(const retype_inst & r, ggml_type type) {
+    ggml_tensor tmp = *r.t;
+    set_type_nb(&tmp, type);
+    return ggml_backend_buft_get_alloc_size(ggml_backend_buffer_get_type(r.t->buffer), &tmp);
+}
+
+// the op the model runs on this weight, with the weight as `type`, must be supported where it lives
+static void check_op_supported(const retype_inst & r, const std::string & name, ggml_type type) {
+    ggml_backend_dev_t dev = inst_device(r);
+    if (!dev) {
+        throw std::runtime_error(name + ": cannot determine the device of its buffer");
+    }
+    ggml_init_params ip = { /*.mem_size =*/ 16*ggml_tensor_overhead(), /*.mem_buffer =*/ nullptr, /*.no_alloc =*/ true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor w = *r.t;
+    set_type_nb(&w, type);
+    std::vector<std::pair<std::string, ggml_tensor *>> ops;
+    for (int64_t n_tok : { (int64_t) 1, (int64_t) 512 }) {
+        if (name.find("token_embd") != std::string::npos) {
+            ops.emplace_back("GET_ROWS", ggml_get_rows(ctx, &w, ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_tok)));
+        } else if (w.ne[2] > 1) {
+            // stacked experts: [ne0, n_ff, n_expert] x [ne0, 1, n_tok] with 2 experts per token
+            ggml_tensor * b   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, w.ne[0], 1, n_tok);
+            ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 2, n_tok);
+            ops.emplace_back("MUL_MAT_ID", ggml_mul_mat_id(ctx, &w, b, ids));
+        } else {
+            ops.emplace_back("MUL_MAT", ggml_mul_mat(ctx, &w, ggml_new_tensor_2d(ctx, GGML_TYPE_F32, w.ne[0], n_tok)));
+        }
+    }
+    std::string bad;
+    for (auto & [op_name, op] : ops) {
+        if (!ggml_backend_dev_supports_op(dev, op)) {
+            bad = fmt("%s: %s with a %s weight (%lld tokens) is not supported by %s", name.c_str(), op_name.c_str(), ggml_type_name(type),
+                    (long long) op->ne[op->op == GGML_OP_MUL_MAT_ID ? 2 : 1], ggml_backend_dev_name(dev));
+            break;
+        }
+    }
+    ggml_free(ctx);
+    if (!bad.empty()) {
+        throw std::runtime_error(bad);
+    }
+}
+
+// checks for retype on top of check_patchable's placement checks: the tensor and every instance must be in a plain
+// device or host buffer, contiguous, without backend extra data; the new type must fit the shape and run there
+static void check_retypable(const swap_state & st, const std::string & name, const std::vector<ggml_tensor *> & inst, ggml_type type) {
+    if (inst.empty()) {
+        throw std::runtime_error("no tensor named '" + name + "' in the model");
+    }
+    if (!st.index.count(name)) {
+        throw std::runtime_error(name + ": not found in the model GGUF");
+    }
+    const ggml_type cur = inst[0]->type;
+    for (ggml_type x : { cur, type }) {
+        if (x == GGML_TYPE_NVFP4 || x == GGML_TYPE_F8_E4M3) {
+            throw std::runtime_error(fmt("%s: %s weights come with a separate scale tensor and graph-level settings, retype does not handle them", name.c_str(), ggml_type_name(x)));
+        }
+    }
+    if (inst[0]->ne[0] % ggml_blck_size(type) != 0) {
+        throw std::runtime_error(fmt("%s: ne0 = %lld is not a multiple of the %s block size %lld", name.c_str(), (long long) inst[0]->ne[0],
+                ggml_type_name(type), (long long) ggml_blck_size(type)));
+    }
+    for (auto * t : inst) {
+        if (t->type != cur) {
+            throw std::runtime_error(name + ": instances differ in type");
+        }
+        std::string why;
+        const placement p = classify(t, st.extra_bufts, why);
+        if (p == placement::HOST_RO) {
+            throw std::runtime_error(name + " is in a read-only file mapping (" + why + "): restart with -lm none or -lm dio (not mmap / dio+map) to make host tensors writable");
+        }
+        if (p != placement::DEVICE && p != placement::HOST) {
+            throw std::runtime_error(fmt("%s: placement %s (%s) cannot be retyped: only plain device and host buffers can", name.c_str(), placement_name(p),
+                    t->buffer ? ggml_backend_buft_name(ggml_backend_buffer_get_type(t->buffer)) : "none"));
+        }
+        if (t->extra) {
+            throw std::runtime_error(name + ": the backend keeps extra data for it (" + ggml_backend_buft_name(ggml_backend_buffer_get_type(t->buffer)) + "), not retypable");
+        }
+        if (!ggml_is_contiguous(t)) {
+            throw std::runtime_error(name + ": not contiguous");
+        }
+    }
+    for (auto * t : inst) {
+        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(t->buffer);
+        if (!st.plain_bufts.count(buft)) {
+            throw std::runtime_error(fmt("%s: buffer type %s is not a device's default or host buffer type (split / tensor-parallel / repacked buffers are not retypable)",
+                    name.c_str(), ggml_backend_buft_name(buft)));
+        }
+    }
+}
+
+// allocated retype buffers and stranded original slots, per device
+static json retype_memory(const swap_state & st) {
+    struct usage {
+        size_t allocated = 0;
+        size_t stranded = 0;
+        size_t released = 0;
+    };
+    std::map<std::string, usage> m;
+    for (auto & [name, e] : st.patched) {
+        for (auto & r : e.rt) {
+            auto & v = m[inst_dev_name(r)];
+            if (r.dedicated) {
+                v.allocated += ggml_backend_buffer_get_size(r.t->buffer);
+                v.released += r.orig_cap;
+            } else if (r.own) {
+                v.allocated  += ggml_backend_buffer_get_size(r.own);
+                v.stranded += r.orig_cap;
+            } else {
+                v.stranded += r.orig_cap - alloc_size_as(r, r.t->type);
+            }
+        }
+    }
+    json j = json::object();
+    for (auto & [dev, v] : m) {
+        j[dev] = { {"released_bytes", v.released}, {"net_bytes", int64_t(v.allocated) - int64_t(v.released)}, {"allocated_bytes", v.allocated}, {"stranded_bytes", v.stranded},
+                   {"allocated_MiB", v.allocated/1048576.0}, {"stranded_MiB", v.stranded/1048576.0} };
+    }
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            continue;
+        }
+        size_t free = 0, total = 0;
+        ggml_backend_dev_memory(dev, &free, &total);
+        j[ggml_backend_dev_name(dev)]["free_MiB"] = free/1048576.0;
+    }
+    return j;
+}
+
+static json do_revert(swap_state & st, const std::string & name);
+
+// first patch or retype of a tensor: keep its original bytes (as set by orig=) and add it to st.patched
+static void add_entry(swap_state & st, const std::string & name, const std::vector<ggml_tensor *> & inst, json & j) {
+    patch_entry e;
+    e.name   = name;
+    e.inst   = inst;
+    e.nbytes = ggml_nbytes(inst[0]);
+    e.mode   = st.omode;
+
+    std::vector<uint8_t> orig;
+    bool from_gguf = false;
+    if (st.omode == orig_mode::GGUF) {
+        get_gguf_bytes(st, name, orig);
+        from_gguf = true;
+        std::vector<uint8_t> live;
+        bool live_from_gguf = false;
+        get_live_bytes(st, inst, name, live, live_from_gguf);
+        if (!live_from_gguf && live != orig) {
+            throw std::runtime_error(name + ": the loaded bytes differ from the GGUF on disk, cannot use orig=gguf for it");
+        }
+    } else {
+        get_live_bytes(st, inst, name, orig, from_gguf);
+        if (st.check_gguf && !from_gguf) {
+            std::vector<uint8_t> g;
+            get_gguf_bytes(st, name, g);
+            if (g != orig) {
+                throw std::runtime_error(name + ": the loaded bytes differ from the GGUF on disk (check_gguf=1)");
+            }
+        }
+    }
+    e.orig_hash = hash_bytes(orig.data(), orig.size());
+    j["orig_from"] = from_gguf ? "gguf" : "buffer";
+    if (st.omode == orig_mode::RAM) {
+        e.orig = std::move(orig);
+    } else if (st.omode == orig_mode::SPILL) {
+        e.spill_path = st.spill_dir + "/" + name + ".orig";
+        FILE * f = fopen(e.spill_path.c_str(), "wb");
+        if (!f || fwrite(orig.data(), 1, orig.size(), f) != orig.size() || fclose(f) != 0) {
+            throw std::runtime_error("failed to write spill file " + e.spill_path);
+        }
+    }
+    st.patched[name] = std::move(e);
+}
+
+static json do_patch(swap_state & st, const std::string & name, std::vector<uint8_t> & data, const std::string & source) {
+    auto inst = st.find(name);
+    check_patchable(st, name, inst);
+    const size_t nbytes = ggml_nbytes(inst[0]);
+    if (data.size() != nbytes) {
+        throw std::runtime_error(fmt("%s: %zu bytes given, the tensor holds %zu (%s)", name.c_str(), data.size(), nbytes, ggml_type_name(inst[0]->type)));
+    }
+
+    llama_synchronize(st.ctx);
+    const auto t0 = std::chrono::steady_clock::now();
+
+    json j;
+    bool first = st.patched.count(name) == 0;
+    if (first) {
+        // keep the original bytes before the first write
+        add_entry(st, name, inst, j);
+    }
+
+    patch_entry & e = st.patched.at(name);
+    try {
+        write_tensor(st, inst, data, name);
+    } catch (...) {
+        if (first) {
+            // restore what was there before, so a failed first patch leaves the model unchanged
+            try { do_revert(st, name); } catch (const std::exception & ex) {
+                OUT("kld-swap: error: restoring %s after the failed patch also failed: %s (it stays listed as patched)\n", name.c_str(), ex.what());
+            }
+        }
+        throw;
+    }
+    e.cur_hash = hash_bytes(data.data(), data.size());
+    e.source   = source;
+
+    const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    j["name"]          = name;
+    j["type"]          = ggml_type_name(inst[0]->type);
+    j["nbytes"]        = nbytes;
+    j["instances"]     = inst.size();
+    j["orig_hash"]     = hex64(e.orig_hash);
+    j["new_hash"]      = hex64(e.cur_hash);
+    j["same_as_orig"]  = e.orig_hash == e.cur_hash;
+    j["ms"]            = ms;
+    json pl = json::array();
+    for (auto * t : inst) {
+        std::string why;
+        pl.push_back(std::string(ggml_backend_buft_name(ggml_backend_buffer_get_type(t->buffer))) + ":" + placement_name(classify(t, st.extra_bufts, why)));
+    }
+    j["placement"] = pl;
+    OUT("kld-swap: patched %s (%s, %.1f MiB, %s) from %s in %.0f ms\n", name.c_str(), ggml_type_name(inst[0]->type),
+            nbytes/1048576.0, pl.dump().c_str(), source.c_str(), ms);
+    return j;
+}
+
+static json do_revert(swap_state & st, const std::string & name) {
+    auto it = st.patched.find(name);
+    if (it == st.patched.end()) {
+        throw std::runtime_error(name + " is not patched");
+    }
+    patch_entry & e = it->second;
+    llama_synchronize(st.ctx);
+
+    // the instances whose original slot must be rewritten: all of a patch, the overwritten ones of a retype
+    std::vector<ggml_tensor *> to_write;
+    for (size_t i = 0; i < e.inst.size(); ++i) {
+        if (e.rt.empty() || e.rt[i].dirty) {
+            to_write.push_back(e.inst[i]);
+        }
+    }
+    std::vector<uint8_t> tmp;
+    const std::vector<uint8_t> * orig = &e.orig;
+    if (!to_write.empty()) {
+        if (e.mode == orig_mode::SPILL) {
+            read_file_range(e.spill_path, 0, e.nbytes, tmp);
+            orig = &tmp;
+        } else if (e.mode == orig_mode::GGUF) {
+            get_gguf_bytes(st, name, tmp);
+            orig = &tmp;
+        }
+        if (hash_bytes(orig->data(), orig->size()) != e.orig_hash) {
+            throw std::runtime_error(name + ": the saved original bytes do not match their hash (spill file or GGUF changed?), not restoring");
+        }
+    }
+    json j;
+    size_t freed = 0;
+    const bool dedicated = !e.rt.empty() && e.rt[0].dedicated;
+    if (dedicated) {
+        auto & r = e.rt[0];
+        freed = ggml_backend_buffer_get_size(r.t->buffer);
+        replace_expert(st, r.t, r.orig_type, *orig);
+    } else {
+        for (auto & r : e.rt) {
+            restore_inst(r);
+        }
+        if (!to_write.empty()) {
+            write_tensor(st, to_write, *orig, name);
+        }
+    }
+    for (auto & r : e.rt) {
+        if (r.own) {
+            freed += ggml_backend_buffer_get_size(r.own);
+            ggml_backend_buffer_free(r.own);
+            r.own = nullptr;
+        }
+    }
+    if (!e.rt.empty()) {
+        invalidate_graphs(st);
+        j["type"]        = ggml_type_name(e.rt[0].orig_type);
+        j["freed_bytes"] = freed;
+        j["rewritten"]   = to_write.size();
+    }
+    if (e.mode == orig_mode::SPILL) {
+        unlink(e.spill_path.c_str());
+    }
+    j["name"] = name;
+    j["hash"] = hex64(e.orig_hash);
+    st.patched.erase(it);
+    return j;
+}
+
+// Dedicated experts replace their allocation. Grouped weights use their original slot or an overflow buffer.
+static json do_retype(swap_state & st, const std::string & name, ggml_type type, std::vector<uint8_t> & data, const std::string & source) {
+    auto inst = st.find(name);
+    check_retypable(st, name, inst, type);
+    const ggml_tensor * t0 = inst[0];
+    const size_t nbytes = ggml_row_size(type, t0->ne[0]) * t0->ne[1] * t0->ne[2] * t0->ne[3];
+    if (data.size() != nbytes) {
+        throw std::runtime_error(fmt("%s: %zu bytes given, the tensor [%lld, %lld, %lld, %lld] as %s holds %zu", name.c_str(), data.size(),
+                (long long) t0->ne[0], (long long) t0->ne[1], (long long) t0->ne[2], (long long) t0->ne[3], ggml_type_name(type), nbytes));
+    }
+
+    // the instances as the loader placed them (taken from the entry once retyped)
+    std::vector<retype_inst> fresh;
+    auto pit = st.patched.find(name);
+    if (pit == st.patched.end() || pit->second.rt.empty()) {
+        for (auto * t : inst) {
+            retype_inst r;
+            r.t           = t;
+            r.orig_type   = t->type;
+            r.dedicated   = inst.size() == 1 && st.experts.count(t);
+            r.orig_data   = r.dedicated ? nullptr : t->data;
+            r.orig_buffer = r.dedicated ? nullptr : t->buffer;
+            r.orig_cap    = r.dedicated ? ggml_backend_buffer_get_size(t->buffer) : ggml_backend_buft_get_alloc_size(ggml_backend_buffer_get_type(t->buffer), t);
+            memcpy(r.orig_nb, t->nb, sizeof(r.orig_nb));
+            fresh.push_back(r);
+        }
+    }
+    for (const auto & r : fresh.empty() ? pit->second.rt : fresh) {
+        check_op_supported(r, name, type);
+    }
+
+    llama_synchronize(st.ctx);
+    const auto t_start = std::chrono::steady_clock::now();
+
+    json j;
+    const bool first = st.patched.count(name) == 0;
+    if (first) {
+        add_entry(st, name, inst, j);
+    }
+    patch_entry & e = st.patched.at(name);
+    const bool new_rt = e.rt.empty();
+    if (new_rt) {
+        e.rt = fresh;
+        for (auto & r : e.rt) {
+            r.dirty = !first; // a patch wrote the original slots
+        }
+    }
+
+    struct target {
+        ggml_backend_buffer_t buf   = nullptr;
+        bool                  alloc = false;
+        size_t                need  = 0;
+    };
+    std::vector<target> plan(e.rt.size());
+    try {
+        for (size_t i = 0; i < e.rt.size(); ++i) {
+            retype_inst & r = e.rt[i];
+            target & p = plan[i];
+            p.need = alloc_size_as(r, type);
+            if (r.dedicated) {
+                replace_expert(st, r.t, type, data);
+            } else if (p.need <= r.orig_cap) {
+                p.buf = r.orig_buffer;
+            } else if (r.own && p.need <= ggml_backend_buffer_get_size(r.own)) {
+                p.buf = r.own;
+            } else {
+                ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(r.t->buffer);
+                p.buf = ggml_backend_buft_alloc_buffer(buft, p.need);
+                if (!p.buf) {
+                    throw std::runtime_error(fmt("%s: cannot allocate %.1f MiB in %s on %s for %s", name.c_str(), p.need/1048576.0,
+                            ggml_backend_buft_name(buft), inst_dev_name(r).c_str(), ggml_type_name(type)));
+                }
+                p.alloc = true;
+                ggml_backend_buffer_set_usage(p.buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+            }
+        }
+    } catch (...) {
+        for (auto & p : plan) {
+            if (p.alloc) {
+                ggml_backend_buffer_free(p.buf);
+            }
+        }
+        // nothing was written yet
+        if (first) {
+            if (e.mode == orig_mode::SPILL) {
+                unlink(e.spill_path.c_str());
+            }
+            st.patched.erase(name);
+        } else if (new_rt) {
+            e.rt.clear();
+        }
+        throw;
+    }
+
+    json pl = json::array();
+    for (size_t i = 0; i < e.rt.size(); ++i) {
+        retype_inst & r = e.rt[i];
+        const target & p = plan[i];
+        ggml_backend_buffer_t prev_own = r.own;
+        set_type_nb(r.t, type);
+        if (p.alloc) {
+            r.t->data   = nullptr;
+            r.t->buffer = nullptr;
+            GGML_ASSERT(ggml_backend_tensor_alloc(p.buf, r.t, ggml_backend_buffer_get_base(p.buf)) == GGML_STATUS_SUCCESS);
+            r.own = p.buf;
+        } else if (!r.dedicated) {
+            r.t->data   = p.buf == r.orig_buffer ? r.orig_data : ggml_backend_buffer_get_base(p.buf);
+            r.t->buffer = p.buf;
+            // zeroes the CUDA row padding of quantized tensors, as at load
+            GGML_ASSERT(ggml_backend_buffer_init_tensor(p.buf, r.t) == GGML_STATUS_SUCCESS);
+            r.own = p.buf == r.orig_buffer ? nullptr : p.buf;
+        }
+        if (!r.own) {
+            r.dirty = true;
+        }
+        if (prev_own && prev_own != r.own) {
+            ggml_backend_buffer_free(prev_own);
+        }
+        pl.push_back({ {"device", inst_dev_name(r)}, {"buffer_type", ggml_backend_buft_name(ggml_backend_buffer_get_type(r.t->buffer))},
+                       {"where", r.dedicated ? "dedicated-buffer" : p.alloc ? "new-buffer" : r.own ? "retype-buffer" : "orig-slot"},
+                       {"alloc_bytes", p.need}, {"orig_cap_bytes", r.orig_cap} });
+    }
+    invalidate_graphs(st);
+
+    try {
+        if (!e.rt[0].dedicated) {
+            write_tensor(st, inst, data, name);
+        }
+    } catch (...) {
+        if (first) {
+            try { do_revert(st, name); } catch (const std::exception & ex) {
+                OUT("kld-swap: error: restoring %s after the failed retype also failed: %s (it stays listed as patched)\n", name.c_str(), ex.what());
+            }
+        }
+        throw;
+    }
+    e.cur_hash = hash_bytes(data.data(), data.size());
+    e.source   = source;
+
+    const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t_start).count();
+    j["name"]         = name;
+    j["type"]         = ggml_type_name(type);
+    j["orig_type"]    = ggml_type_name(e.rt[0].orig_type);
+    j["nbytes"]       = nbytes;
+    j["orig_nbytes"]  = e.nbytes;
+    j["instances"]    = inst.size();
+    j["orig_hash"]    = hex64(e.orig_hash);
+    j["new_hash"]     = hex64(e.cur_hash);
+    j["ms"]           = ms;
+    j["placement"]    = pl;
+    j["memory"]       = retype_memory(st);
+    OUT("kld-swap: retyped %s %s -> %s (%.1f -> %.1f MiB, %s) from %s in %.0f ms\n", name.c_str(), ggml_type_name(e.rt[0].orig_type), ggml_type_name(type),
+            e.nbytes/1048576.0, nbytes/1048576.0, pl.dump().c_str(), source.c_str(), ms);
+    return j;
+}
+
+//
+// eval
+//
+
+static json do_eval(swap_state & st, const args_t & a) {
+    if (!st.base) {
+        throw std::runtime_error("no base logits loaded, use: base <file>");
+    }
+    const base_logits & B = *st.base;
+    llama_context * ctx = st.ctx;
+    const llama_vocab * vocab = llama_model_get_vocab(st.model);
+
+    const int start    = std::stoi(arg_opt(a, "start", "0"));
+    const int n_req    = std::stoi(arg_opt(a, "chunks", "-1"));
+    const std::string out = arg_opt(a, "out");
+    const bool want_tok = arg_opt(a, "tokens", "0") == "1";
+    const bool quiet    = arg_opt(a, "quiet", "0") == "1";
+    if (start < 0 || start >= B.n_chunk) {
+        throw std::runtime_error(fmt("start=%d out of range [0, %d)", start, B.n_chunk));
+    }
+    const int end = n_req < 0 ? B.n_chunk : std::min(B.n_chunk, start + n_req);
+    const int n_eval = end - start;
+
+    const int n_ctx   = (int) B.n_ctx;
+    const int n_vocab = B.n_vocab;
+    const int n_batch = st.params->n_batch;
+    const int num_batches = (n_ctx + n_batch - 1) / n_batch;
+    int n_seq = std::max(1, n_batch / n_ctx);
+    n_seq = std::min<int>(n_seq, llama_n_seq_max(ctx));
+    const int first = n_ctx/2;
+    const int n_tok = (int) B.n_tok_chunk;
+    const bool add_bos = llama_vocab_get_add_bos(vocab);
+
+    std::vector<llama_token> tokens = B.tokens; // BOS is written into a copy
+    common_batch batch(ctx);
+    std::vector<float> logits;
+    if (num_batches > 1) {
+        logits.reserve(size_t(n_ctx) * n_vocab);
+    }
+    std::vector<uint16_t> base_lp(size_t(n_seq) * B.rec_bytes / sizeof(uint16_t));
+    std::vector<token_stat> tstat(size_t(n_eval) * n_tok);
+    std::vector<std::thread> workers(std::max(1u, std::thread::hardware_concurrency()) - 1);
+
+    FILE * f_chunks = nullptr;
+    FILE * f_tok    = nullptr;
+    if (!out.empty()) {
+        f_chunks = fopen((out + ".chunks.tsv").c_str(), "w");
+        if (!f_chunks) {
+            throw std::runtime_error("cannot write " + out + ".chunks.tsv");
+        }
+        fprintf(f_chunks, "chunk\tn_tok\tkld_mean\tkld_sum\tkld_sum2\tnll_sum\tnll_base_sum\tn_same_top\tp_diff_sum\tp_diff2_sum\tkld_max\n");
+        fflush(f_chunks);
+        if (want_tok) {
+            f_tok = fopen((out + ".tokens.bin").c_str(), "wb");
+            if (!f_tok) {
+                fclose(f_chunks);
+                throw std::runtime_error("cannot write " + out + ".tokens.bin");
+            }
+            // header: magic, scored tokens per chunk; then per chunk: int32 chunk, float32 kld[T], p_diff[T], nll[T], nll_base[T], uint8 same_top[T]
+            fwrite("KLDTOK01", 1, 8, f_tok);
+            const int32_t T = n_tok;
+            fwrite(&T, sizeof(T), 1, f_tok);
+            fflush(f_tok);
+        }
+    }
+
+    OUT("kld-swap: eval chunks [%d, %d) of %d, n_ctx=%d, n_batch=%d, n_seq=%d, %zu patched tensor(s)\n",
+            start, end, B.n_chunk, n_ctx, n_batch, n_seq, st.patched.size());
+
+    kld_sums total;
+    json jchunks = json::array();
+    const auto t_eval0 = std::chrono::steady_clock::now();
+    double t_read_wait = 0.0;
+
+    for (int i = start; i < end; i += n_seq) {
+        const int n_seq_batch = std::min(n_seq, end - i);
+
+        // read the base log-probs of this group while the model runs
+        auto reader = std::async(std::launch::async, [&B, &base_lp, i, n_seq_batch]() {
+            for (int s = 0; s < n_seq_batch; ++s) {
+                B.read_chunk(i + s, base_lp.data() + size_t(s) * B.rec_bytes / sizeof(uint16_t));
+            }
+        });
+
+        const int tok_start = i * n_ctx;
+        const int tok_end   = tok_start + n_ctx;
+
+        llama_memory_clear(llama_get_memory(ctx), true);
+
+        bool ok = true;
+        for (int j = 0; j < num_batches && ok; ++j) {
+            const int batch_start = tok_start + j * n_batch;
+            const int batch_size  = std::min(tok_end - batch_start, n_batch);
+            int n_outputs = 0;
+            batch.clear();
+            for (int seq = 0; seq < n_seq_batch; seq++) {
+                int seq_start = batch_start + seq*n_ctx;
+                const auto token_org = tokens[seq_start];
+                if (add_bos && j == 0) {
+                    tokens[seq_start] = llama_vocab_bos(vocab);
+                }
+                for (int k = 0; k < batch_size; ++k) {
+                    const int pos = j*n_batch + k;
+                    const bool need_logits = pos >= first;
+                    batch.add(tokens[seq_start + k], pos, seq, need_logits);
+                    n_outputs += need_logits;
+                }
+                tokens[seq_start] = token_org;
+            }
+            if (llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, batch.get())) {
+                ok = false;
+                break;
+            }
+            if (num_batches > 1 && n_outputs > 0) {
+                const auto * batch_logits = llama_get_logits(ctx);
+                logits.insert(logits.end(), batch_logits, batch_logits + size_t(n_outputs) * n_vocab);
+            }
+        }
+        const auto t_w0 = std::chrono::steady_clock::now();
+        reader.get(); // rethrows read errors
+        t_read_wait += std::chrono::duration<double>(std::chrono::steady_clock::now() - t_w0).count();
+        if (!ok) {
+            if (f_chunks) fclose(f_chunks);
+            if (f_tok) fclose(f_tok);
+            throw std::runtime_error(fmt("failed to decode chunk %d", i));
+        }
+
+        for (int seq = 0; seq < n_seq_batch; seq++) {
+            const int c = i + seq;
+            const float * all_logits = num_batches > 1 ? logits.data() : llama_get_logits_ith(ctx, seq*n_ctx + first);
+            token_stat * ts = tstat.data() + size_t(c - start) * n_tok;
+            kld_sums cs;
+            kld_chunk(n_vocab, B.nv, all_logits, tokens.data() + tok_start + seq*n_ctx + first, n_tok, workers,
+                    base_lp.data() + size_t(seq) * B.rec_bytes / sizeof(uint16_t), cs, ts);
+            total.add(cs);
+
+            float kmax = 0.0f;
+            for (int t = 0; t < n_tok; ++t) {
+                kmax = std::max(kmax, ts[t].kld);
+            }
+            const double cm = cs.sum_kld / cs.count;
+            jchunks.push_back({ {"chunk", c}, {"kld_mean", cm}, {"n_same_top", cs.n_same_top}, {"n_tok", cs.count},
+                                {"nll_sum", cs.sum_nll}, {"nll_base_sum", cs.sum_nll_base} });
+            if (f_chunks) {
+                fprintf(f_chunks, "%d\t%zu\t%.9g\t%.17g\t%.17g\t%.17g\t%.17g\t%zu\t%.17g\t%.17g\t%.9g\n", c, cs.count, cm, cs.sum_kld, cs.sum_kld2,
+                        cs.sum_nll, cs.sum_nll_base, cs.n_same_top, cs.sum_p_diff, cs.sum_p_diff2, kmax);
+                fflush(f_chunks);
+            }
+            if (f_tok) {
+                const int32_t ci = c;
+                std::vector<float>   buf(n_tok);
+                std::vector<uint8_t> top(n_tok);
+                auto put = [&](float token_stat::* m) {
+                    for (int t = 0; t < n_tok; ++t) {
+                        buf[t] = ts[t].*m;
+                    }
+                    fwrite(buf.data(), sizeof(float), n_tok, f_tok);
+                };
+                fwrite(&ci, sizeof(ci), 1, f_tok);
+                put(&token_stat::kld);
+                put(&token_stat::p_diff);
+                put(&token_stat::nll);
+                put(&token_stat::nll_base);
+                for (int t = 0; t < n_tok; ++t) {
+                    top[t] = ts[t].same_top;
+                }
+                fwrite(top.data(), 1, n_tok, f_tok);
+                fflush(f_tok);
+            }
+            if (!quiet) {
+                auto kl = mean_and_uncertainty(total.sum_kld, total.sum_kld2, total.count);
+                const double el  = std::chrono::duration<double>(std::chrono::steady_clock::now() - t_eval0).count();
+                const int    done = c - start + 1;
+                OUT("kld-swap: chunk %4d  [%d/%d]  KLD %.6f  cum %.6f ± %.6f  same-top %.3f%%  %.1f s/chunk  ETA %.1f min\n",
+                        c, done, n_eval, cm, kl.first, kl.second, 100.0*total.n_same_top/total.count,
+                        el/done, el/done*(n_eval - done)/60.0);
+            }
+        }
+        logits.clear();
+    }
+
+    if (f_chunks) fclose(f_chunks);
+    if (f_tok) fclose(f_tok);
+
+    const double t_eval = std::chrono::duration<double>(std::chrono::steady_clock::now() - t_eval0).count();
+
+    std::vector<float> kv(tstat.size()), pv(tstat.size());
+    for (size_t k = 0; k < tstat.size(); ++k) {
+        kv[k] = tstat[k].kld;
+        pv[k] = tstat[k].p_diff;
+    }
+    OUT("\n");
+    if (total.count < 100) {
+        OUT("kld-swap: warning: only %zu scored tokens, the statistics below are unreliable\n", total.count);
+    }
+    json j = summarize(total, std::move(kv), std::move(pv));
+    j["start"]        = start;
+    j["chunks"]       = n_eval;
+    j["n_ctx"]        = n_ctx;
+    j["n_seq"]        = n_seq;
+    j["seconds"]      = t_eval;
+    j["read_wait_s"]  = t_read_wait;
+    j["base"]         = B.path;
+    json jp = json::array();
+    for (auto & [n, e] : st.patched) {
+        jp.push_back({ {"name", n}, {"source", e.source}, {"hash", hex64(e.cur_hash)} });
+        if (!e.rt.empty()) {
+            jp.back()["type"] = ggml_type_name(e.inst[0]->type);
+        }
+    }
+    j["patched"]   = jp;
+    j["per_chunk"] = jchunks;
+    if (!out.empty()) {
+        std::ofstream fj(out + ".json");
+        fj << j.dump(1) << "\n";
+        j["out"] = out;
+    }
+    OUT("kld-swap: eval done in %.1f s (%.2f s waiting on base reads)\n", t_eval, t_read_wait);
+    return j;
+}
+
+//
+// command loop
+//
+
+static const char * HELP =
+    "commands (one per line, words or a JSON object {\"cmd\": ..., <args>}):\n"
+    "  base <file>                           load / replace the base logits (llama-perplexity --kl-divergence-base output)\n"
+    "  patch <name> <raw.bin> [type=T] [offset=N]\n"
+    "                                        overwrite tensor <name> with the bytes of raw.bin (exact GGUF layout, size must match)\n"
+    "  patch-gguf <name> <file.gguf> [src=<name>]\n"
+    "                                        overwrite tensor <name> with tensor <src> (default <name>) from another GGUF (same type/shape)\n"
+    "  retype <name> <raw.bin> type=T [offset=N]\n"
+    "                                        replace tensor <name> with the bytes of raw.bin as type T (exact GGUF layout, same shape);\n"
+    "                                        in place when T fits the tensor's slot, else in a new buffer on the same device\n"
+    "  retype-gguf <name> <file.gguf> [src=<name>]\n"
+    "                                        retype tensor <name> to tensor <src> (default <name>) of another GGUF (same shape, any type)\n"
+    "  revert <name|all>                     restore the original bytes (and type, placement of retyped tensors)\n"
+    "  eval [chunks=N] [start=S] [out=PREFIX] [tokens=1] [quiet=1]\n"
+    "                                        KLD over base chunks [S, S+N); writes PREFIX.chunks.tsv, PREFIX.json and, with tokens=1, PREFIX.tokens.bin\n"
+    "  info <name>                           placement, type, size and patchability of a tensor\n"
+    "  placements                            all model tensors grouped by buffer type and placement\n"
+    "  verify <name|all>                     compare the live bytes of readable tensors with the GGUF on disk\n"
+    "  status                                patched and retyped tensors, retype memory per device\n"
+    "  set orig=ram|gguf|dir:<path>          where originals are kept for revert (default ram)\n"
+    "  set check_gguf=0|1                    on first patch, also check the live bytes equal the GGUF on disk\n"
+    "  help | quit\n";
+
+static args_t parse_line(const std::string & line, std::string & cmd) {
+    args_t a;
+    if (!line.empty() && line[0] == '{') {
+        json j = json::parse(line);
+        cmd = j.at("cmd").get<std::string>();
+        for (auto & [k, v] : j.items()) {
+            if (k == "cmd") continue;
+            a[k] = v.is_string() ? v.get<std::string>() : v.dump();
+        }
+        return a;
+    }
+    std::istringstream is(line);
+    std::vector<std::string> pos;
+    std::string w;
+    is >> cmd;
+    while (is >> w) {
+        const auto eq = w.find('=');
+        if (eq != std::string::npos && eq > 0 && w.find('/') > eq) {
+            a[w.substr(0, eq)] = w.substr(eq + 1);
+        } else {
+            pos.push_back(w);
+        }
+    }
+    static const std::map<std::string, std::vector<std::string>> names = {
+        { "base",       { "file" } },
+        { "patch",      { "name", "file" } },
+        { "patch-gguf", { "name", "file" } },
+        { "retype",     { "name", "file" } },
+        { "retype-gguf", { "name", "file" } },
+        { "revert",     { "name" } },
+        { "info",       { "name" } },
+        { "verify",     { "name" } },
+    };
+    auto it = names.find(cmd);
+    for (size_t i = 0; i < pos.size(); ++i) {
+        if (it == names.end() || i >= it->second.size()) {
+            throw std::runtime_error("unexpected argument '" + pos[i] + "'");
+        }
+        a[it->second[i]] = pos[i];
+    }
+    return a;
+}
+
+static json run_command(swap_state & st, const std::string & cmd, const args_t & a, bool & quit) {
+    json j;
+    if (cmd == "help") {
+        j["help"] = HELP;
+        OUT("%s", HELP);
+    } else if (cmd == "quit" || cmd == "exit") {
+        quit = true;
+    } else if (cmd == "base") {
+        auto b = std::make_unique<base_logits>();
+        b->open_file(arg_req(a, "file"));
+        const llama_vocab * vocab = llama_model_get_vocab(st.model);
+        if (b->n_vocab != llama_vocab_n_tokens(vocab)) {
+            throw std::runtime_error(fmt("inconsistent vocabulary (%d in base vs %d in model)", b->n_vocab, llama_vocab_n_tokens(vocab)));
+        }
+        const int n_seq = std::min<int>(std::max(1, st.params->n_batch / (int) b->n_ctx), llama_n_seq_max(st.ctx));
+        if (b->n_ctx * n_seq > llama_n_ctx(st.ctx)) {
+            throw std::runtime_error(fmt("base computed with n_ctx=%u, the context holds %u: restart with -c %u", b->n_ctx, llama_n_ctx(st.ctx), b->n_ctx));
+        }
+        if ((int) b->n_ctx != st.params->n_ctx / std::max(1, st.params->n_parallel)) {
+            OUT("kld-swap: warning: base n_ctx=%u differs from -c %d; llama-perplexity would accept this too, but results are only comparable for the same -c\n",
+                    b->n_ctx, st.params->n_ctx / std::max(1, st.params->n_parallel));
+        }
+        st.base = std::move(b);
+        j["file"] = st.base->path;
+        j["n_ctx"] = st.base->n_ctx;
+        j["n_vocab"] = st.base->n_vocab;
+        j["n_chunk"] = st.base->n_chunk;
+        j["n_tok_chunk"] = st.base->n_tok_chunk;
+        OUT("kld-swap: base %s: n_ctx=%u n_vocab=%d n_chunk=%d (%.1f MiB per chunk)\n", st.base->path.c_str(), st.base->n_ctx,
+                st.base->n_vocab, st.base->n_chunk, st.base->rec_bytes/1048576.0);
+    } else if (cmd == "patch") {
+        const std::string name = arg_req(a, "name");
+        const std::string file = arg_req(a, "file");
+        auto inst = st.find(name);
+        check_patchable(st, name, inst);
+        const std::string type = arg_opt(a, "type");
+        if (!type.empty()) {
+            std::string tl = type, have = ggml_type_name(inst[0]->type);
+            std::transform(tl.begin(), tl.end(), tl.begin(), ::tolower);
+            std::transform(have.begin(), have.end(), have.begin(), ::tolower);
+            if (tl != have) {
+                throw std::runtime_error(name + ": type " + type + " given, the tensor is " + ggml_type_name(inst[0]->type));
+            }
+        }
+        const size_t nbytes = ggml_nbytes(inst[0]);
+        const size_t off = std::stoull(arg_opt(a, "offset", "0"));
+        const size_t fsz = file_size(file);
+        if (!a.count("offset") && fsz != nbytes) {
+            throw std::runtime_error(fmt("%s: %s holds %zu bytes, the tensor holds %zu (%s)", name.c_str(), file.c_str(), fsz, nbytes, ggml_type_name(inst[0]->type)));
+        }
+        if (off + nbytes > fsz) {
+            throw std::runtime_error(fmt("%s: %s is too short for %zu bytes at offset %zu", name.c_str(), file.c_str(), nbytes, off));
+        }
+        std::vector<uint8_t> data;
+        read_file_range(file, off, nbytes, data);
+        j = do_patch(st, name, data, off ? file + "@" + std::to_string(off) : file);
+    } else if (cmd == "patch-gguf") {
+        const std::string name = arg_req(a, "name");
+        const std::string file = arg_req(a, "file");
+        const std::string src  = arg_opt(a, "src", name);
+        auto inst = st.find(name);
+        check_patchable(st, name, inst);
+        auto idx = gguf_index_file(file);
+        auto it = idx.find(src);
+        if (it == idx.end()) {
+            throw std::runtime_error(src + " not found in " + file + " (split GGUFs: give the split that holds it)");
+        }
+        const gguf_loc & l = it->second;
+        for (int d = 0; d < 4; ++d) {
+            if (l.ne[d] != inst[0]->ne[d]) {
+                throw std::runtime_error(name + ": shape differs from " + src + " in " + file);
+            }
+        }
+        if (l.type != inst[0]->type) {
+            throw std::runtime_error(fmt("%s: type %s in %s, the model tensor is %s", name.c_str(), ggml_type_name(l.type), file.c_str(), ggml_type_name(inst[0]->type)));
+        }
+        std::vector<uint8_t> data;
+        read_file_range(l.path, l.offset, l.nbytes, data);
+        j = do_patch(st, name, data, file + ":" + src);
+    } else if (cmd == "retype") {
+        const std::string name = arg_req(a, "name");
+        const std::string file = arg_req(a, "file");
+        const ggml_type   type = parse_type(arg_req(a, "type"));
+        auto inst = st.find(name);
+        if (inst.empty()) {
+            throw std::runtime_error("no tensor named '" + name + "' in the model");
+        }
+        const ggml_tensor * t = inst[0];
+        check_retypable(st, name, inst, type); // before the size, which needs ne0 to be a multiple of the block size
+        const size_t nbytes = ggml_row_size(type, t->ne[0]) * t->ne[1] * t->ne[2] * t->ne[3];
+        const size_t off = std::stoull(arg_opt(a, "offset", "0"));
+        const size_t fsz = file_size(file);
+        if (!a.count("offset") && fsz != nbytes) {
+            throw std::runtime_error(fmt("%s: %s holds %zu bytes, the tensor as %s holds %zu", name.c_str(), file.c_str(), fsz, ggml_type_name(type), nbytes));
+        }
+        if (off + nbytes > fsz) {
+            throw std::runtime_error(fmt("%s: %s is too short for %zu bytes at offset %zu", name.c_str(), file.c_str(), nbytes, off));
+        }
+        std::vector<uint8_t> data;
+        read_file_range(file, off, nbytes, data);
+        j = do_retype(st, name, type, data, off ? file + "@" + std::to_string(off) : file);
+    } else if (cmd == "retype-gguf") {
+        const std::string name = arg_req(a, "name");
+        const std::string file = arg_req(a, "file");
+        const std::string src  = arg_opt(a, "src", name);
+        auto inst = st.find(name);
+        if (inst.empty()) {
+            throw std::runtime_error("no tensor named '" + name + "' in the model");
+        }
+        auto idx = gguf_index_file(file);
+        auto it = idx.find(src);
+        if (it == idx.end()) {
+            throw std::runtime_error(src + " not found in " + file + " (split GGUFs: give the split that holds it)");
+        }
+        const gguf_loc & l = it->second;
+        for (int d = 0; d < 4; ++d) {
+            if (l.ne[d] != inst[0]->ne[d]) {
+                throw std::runtime_error(name + ": shape differs from " + src + " in " + file);
+            }
+        }
+        std::vector<uint8_t> data;
+        read_file_range(l.path, l.offset, l.nbytes, data);
+        j = do_retype(st, name, l.type, data, file + ":" + src);
+    } else if (cmd == "revert") {
+        const std::string name = arg_req(a, "name");
+        json r = json::array();
+        if (name == "all") {
+            std::vector<std::string> names;
+            for (auto & [n, e] : st.patched) names.push_back(n);
+            for (auto & n : names) r.push_back(do_revert(st, n));
+        } else {
+            r.push_back(do_revert(st, name));
+        }
+        j["reverted"] = r;
+        OUT("kld-swap: reverted %zu tensor(s)\n", r.size());
+    } else if (cmd == "eval") {
+        j = do_eval(st, a);
+    } else if (cmd == "info") {
+        j = tensor_info(st, arg_req(a, "name"));
+    } else if (cmd == "placements") {
+        std::map<std::string, std::pair<size_t, size_t>> agg;
+        for (auto & [n, t] : st.tensors) {
+            std::string why;
+            const placement p = classify(t, st.extra_bufts, why);
+            const std::string key = std::string(t->buffer ? ggml_backend_buft_name(ggml_backend_buffer_get_type(t->buffer)) : "none") + " / " + placement_name(p);
+            agg[key].first  += 1;
+            agg[key].second += ggml_nbytes(t);
+        }
+        for (auto & [k, v] : agg) {
+            j[k] = { {"tensors", v.first}, {"MiB", v.second/1048576.0} };
+            OUT("kld-swap: %-40s %6zu tensors %12.1f MiB\n", k.c_str(), v.first, v.second/1048576.0);
+        }
+    } else if (cmd == "verify") {
+        const std::string name = arg_req(a, "name");
+        std::vector<std::string> names;
+        if (name == "all") {
+            for (auto & [n, l] : st.index) {
+                if (!st.find(n).empty()) names.push_back(n);
+            }
+        } else {
+            names.push_back(name);
+        }
+        llama_synchronize(st.ctx);
+        size_t n_ok = 0, n_skip = 0;
+        json bad = json::array();
+        std::vector<uint8_t> live, disk;
+        for (auto & n : names) {
+            auto inst = st.find(n);
+            if (inst.empty() || !st.index.count(n)) {
+                throw std::runtime_error("no tensor named '" + n + "'");
+            }
+            get_gguf_bytes(st, n, disk);
+            for (auto * t : inst) {
+                if (!readable(st, t) || !t->buffer) { n_skip++; continue; }
+                live.resize(ggml_nbytes(t));
+                if (live.size() != disk.size()) { bad.push_back(n + (is_retyped(st, n) ? " (retyped)" : " (size)")); continue; }
+                ggml_backend_tensor_get(t, live.data(), 0, live.size());
+                if (live == disk) {
+                    n_ok++;
+                } else {
+                    bad.push_back(n + (st.patched.count(n) ? " (patched)" : ""));
+                }
+            }
+        }
+        j["n_match"] = n_ok;
+        j["n_skipped_unreadable"] = n_skip;
+        j["mismatch"] = bad;
+        OUT("kld-swap: verify: %zu instance(s) match the GGUF, %zu differ, %zu not readable (repacked)\n", n_ok, bad.size(), n_skip);
+    } else if (cmd == "status") {
+        json p = json::array();
+        for (auto & [n, e] : st.patched) {
+            p.push_back({ {"name", n}, {"source", e.source}, {"hash", hex64(e.cur_hash)}, {"orig_hash", hex64(e.orig_hash)},
+                          {"orig", e.mode == orig_mode::RAM ? "ram" : e.mode == orig_mode::GGUF ? "gguf" : e.spill_path} });
+            if (!e.rt.empty()) {
+                json w = json::array();
+                for (auto & r : e.rt) {
+                    w.push_back(inst_dev_name(r) + ":" + (r.dedicated ? "dedicated-buffer" : r.own ? "retype-buffer" : "orig-slot"));
+                }
+                p.back()["type"]      = ggml_type_name(e.inst[0]->type);
+                p.back()["orig_type"] = ggml_type_name(e.rt[0].orig_type);
+                p.back()["where"]     = w;
+            }
+        }
+        j["patched"] = p;
+        j["retype_memory"] = retype_memory(st);
+        j["base"] = st.base ? st.base->path : "";
+    } else if (cmd == "set") {
+        for (auto & [k, v] : a) {
+            if (k == "orig") {
+                if (v == "ram") {
+                    st.omode = orig_mode::RAM;
+                } else if (v == "gguf") {
+                    st.omode = orig_mode::GGUF;
+                } else if (v.rfind("dir:", 0) == 0) {
+                    st.spill_dir = v.substr(4);
+                    mkdir(st.spill_dir.c_str(), 0755);
+                    struct stat sb;
+                    if (stat(st.spill_dir.c_str(), &sb) != 0 || !S_ISDIR(sb.st_mode)) {
+                        throw std::runtime_error("cannot use spill dir " + st.spill_dir);
+                    }
+                    st.omode = orig_mode::SPILL;
+                } else {
+                    throw std::runtime_error("orig must be ram, gguf or dir:<path>");
+                }
+                j["orig"] = v;
+            } else if (k == "check_gguf") {
+                st.check_gguf = v == "1";
+                j["check_gguf"] = st.check_gguf;
+            } else {
+                throw std::runtime_error("unknown setting " + k);
+            }
+        }
+    } else {
+        throw std::runtime_error("unknown command '" + cmd + "', try help");
+    }
+    return j;
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    common_params params;
+    params.n_ctx  = 512;
+    params.escape = false;
+
+    common_init();
+
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_PERPLEXITY)) {
+        return 1;
+    }
+
+    const int32_t n_ctx = params.n_ctx;
+    if (n_ctx <= 0) {
+        LOG_ERR("%s: requires '--ctx-size' > 0\n", __func__);
+        return 1;
+    }
+    if (params.moe_cache_size > 0) {
+        LOG_ERR("%s: --moe-cache-mib keeps device copies of host experts that a patch would not update; not supported\n", __func__);
+        return 1;
+    }
+
+    // same context setup as llama-perplexity for perplexity / KL divergence
+    params.n_parallel = std::max(1, params.n_batch / n_ctx);
+    params.n_ctx      = params.n_parallel * n_ctx;
+    params.n_batch    = std::min(params.n_batch, params.n_ctx);
+
+    llama_backend_init();
+    llama_numa_init(params.numa);
+
+    const auto t_load0 = std::chrono::steady_clock::now();
+    swap_state st;
+    llama_internal_set_weight_allocator([&st](auto * ctx, auto * buft, auto & buffers) {
+        return alloc_expert_buffers(ctx, buft, buffers, st.experts);
+    });
+    auto llama_init = common_init_from_params(params);
+    llama_internal_set_weight_allocator({});
+    auto * model = llama_init->model();
+    auto * ctx   = llama_init->context();
+    if (model == nullptr || ctx == nullptr) {
+        LOG_ERR("%s: unable to load model / create context\n", __func__);
+        reply({ {"ok", false}, {"cmd", "ready"}, {"error", "unable to load model"} });
+        return 1;
+    }
+    const double t_load = std::chrono::duration<double>(std::chrono::steady_clock::now() - t_load0).count();
+
+    LOG_INF("\n%s\n", common_params_get_system_info(params).c_str());
+
+    st.ctx    = ctx;
+    st.model  = model;
+    st.params = &params;
+    st.extra_bufts = collect_extra_bufts();
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        for (ggml_backend_buffer_type_t b : { ggml_backend_dev_buffer_type(dev), ggml_backend_dev_host_buffer_type(dev) }) {
+            if (b && !st.extra_bufts.count(b)) {
+                st.plain_bufts.insert(b);
+            }
+        }
+    }
+    for (auto & [n, t] : llama_internal_get_tensor_map(model)) {
+        st.tensors.emplace(n, t);
+    }
+    try {
+        st.index = gguf_index_model(params.model.path);
+    } catch (const std::exception & e) {
+        LOG_ERR("%s: %s\n", __func__, e.what());
+        reply({ {"ok", false}, {"cmd", "ready"}, {"error", e.what()} });
+        return 1;
+    }
+
+    {
+        json j = { {"ok", true}, {"cmd", "ready"}, {"model", params.model.path}, {"load_s", t_load},
+                   {"n_tensors", st.tensors.size()}, {"n_ctx", n_ctx}, {"n_batch", params.n_batch}, {"n_seq", params.n_parallel} };
+        if (!params.logits_file.empty()) {
+            try {
+                bool q = false;
+                run_command(st, "base", { {"file", params.logits_file} }, q);
+                j["base"] = params.logits_file;
+            } catch (const std::exception & e) {
+                j["ok"] = false;
+                j["error"] = std::string("base: ") + e.what();
+            }
+        }
+        OUT("kld-swap: ready (model loaded in %.1f s, %zu tensors)\n", t_load, st.tensors.size());
+        reply(j);
+    }
+
+    std::string line;
+    bool quit = false;
+    while (!quit && std::getline(std::cin, line)) {
+        const auto b = line.find_first_not_of(" \t\r");
+        if (b == std::string::npos || line[b] == '#') {
+            continue;
+        }
+        line = line.substr(b);
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
+        std::string cmd;
+        try {
+            args_t a = parse_line(line, cmd);
+            OUT("kld-swap> %s\n", line.c_str());
+            json j = run_command(st, cmd, a, quit);
+            j["ok"]  = true;
+            j["cmd"] = cmd;
+            reply(j);
+        } catch (const std::exception & e) {
+            OUT("kld-swap: error: %s\n", e.what());
+            reply({ {"ok", false}, {"cmd", cmd}, {"error", e.what()} });
+        }
+    }
+
+    if (!st.patched.empty()) {
+        OUT("kld-swap: %zu tensor(s) still patched at exit (in memory only, the GGUF is unchanged)\n", st.patched.size());
+    }
+    // Only grouped placements can have a tool-owned overflow buffer.
+    llama_synchronize(st.ctx);
+    for (auto & [n, e] : st.patched) {
+        for (auto & r : e.rt) {
+            if (r.dedicated) {
+                continue;
+            }
+            restore_inst(r);
+            if (r.own) {
+                ggml_backend_buffer_free(r.own);
+                r.own = nullptr;
+            }
+        }
+    }
+    llama_backend_free();
+    return 0;
+}
