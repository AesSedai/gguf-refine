+const std::vector<std::pair<std::string, struct ggml_tensor *>> & llama_internal_get_tensor_map(const struct llama_model * model);
+
+static void reply(const json & j) {
+    fprintf(stdout, "@@kldswap %s\n", j.dump().c_str());
+    fflush(stdout);
+}
